{{- /*
Machine role decides which identity, secrets, and tool configuration deploy.
  personal: home projects only (the personal folder). No employer tooling, no work tokens.
  work:     employer projects only (the work folder). Work MCP servers and hooks.
  both:     one machine for both; git identity switches per folder.
Each role's folder is asked once and saved relative to the home folder. The
work role also asks the Jira and GitLab addresses and the dispatch servers' checkout.
Answers persist in the local chezmoi.toml, never in the repo.
*/ -}}
{{- $role := promptChoiceOnce . "machine_role" "Machine role" (list "personal" "work" "both") "personal" -}}
{{- if not (has $role (list "personal" "work" "both")) }}{{ fail "Invalid machine_role" }}{{ end -}}
{{- $hasWork := or (eq $role "work") (eq $role "both") -}}
{{- $hasPersonal := or (eq $role "personal") (eq $role "both") -}}
{{- $editor := promptChoiceOnce . "editor" "Preferred editor" (list "code" "vim") "code" -}}
{{- if not (has $editor (list "code" "vim")) }}{{ fail "Invalid editor" }}{{ end -}}
{{- /* WSL detection. .chezmoi.kernel is an empty map on macOS, so guard the key. */ -}}
{{- $isWsl := false -}}
{{- if eq .chezmoi.os "linux" -}}
{{-   if hasKey .chezmoi.kernel "osrelease" -}}
{{-     if .chezmoi.kernel.osrelease | lower | contains "microsoft" -}}
{{-       $isWsl = true -}}
{{-     end -}}
{{-   end -}}
{{- end -}}
{{- $data := dict "machine_role" $role "has_work" $hasWork "has_personal" $hasPersonal "is_wsl" $isWsl "editor" $editor -}}
{{- $_ := set $data "name" (promptStringOnce . "name" "Git user name") -}}
{{- $_ := set $data "email" (promptStringOnce . "email" "Git default email (every repo without an override)") -}}
{{- if eq $role "both" -}}
{{- $_ := set $data "personal_email" (promptStringOnce . "personal_email" "Git personal email (repos in your personal folder)") -}}
{{- $_ := set $data "work_email" (promptStringOnce . "work_email" "Git work email (repos in your work folder)") -}}
{{- end -}}
{{- range $key := list "name" "email" "personal_email" "work_email" -}}
{{- if hasKey $data $key -}}
{{- if or (empty (get $data $key)) (regexMatch "[[:cntrl:]]" (get $data $key)) }}{{ fail "Identity answers must be nonempty and contain no control characters" }}{{ end -}}
{{- end -}}
{{- end -}}
{{- /* A role's folder is saved as home-relative text such as ~/name; one trailing / is dropped first. */ -}}
{{- if $hasWork -}}
{{- $_ := set $data "work_folder" (promptStringOnce . "work_folder" "Work folder (under your home)" "~/repos" | trimSuffix "/") -}}
{{- end -}}
{{- if $hasPersonal -}}
{{- $_ := set $data "personal_folder" (promptStringOnce . "personal_folder" "Personal folder (under your home)" "~/dev" | trimSuffix "/") -}}
{{- end -}}
{{- range $key := list "work_folder" "personal_folder" -}}
{{- if hasKey $data $key -}}
{{- if or (not (regexMatch "^~(/[A-Za-z0-9._-]+)+$" (get $data $key))) (regexMatch "(^|/)\\.{1,2}(/|$)" (get $data $key)) }}{{ fail (printf "Invalid %s: use ~/name, a folder under your home, with only letters, digits, . _ - in each part, and no . or .. part" $key) }}{{ end -}}
{{- end -}}
{{- end -}}
{{- if eq $role "both" -}}
{{- $work := get $data "work_folder" -}}
{{- $personal := get $data "personal_folder" -}}
{{- if or (eq $work $personal) (hasPrefix (printf "%s/" $work) $personal) (hasPrefix (printf "%s/" $personal) $work) }}{{ fail "The work and personal folders must differ, and neither may be inside the other" }}{{ end -}}
{{- end -}}
{{- /* The work tools' addresses and the work-folder checkout that builds the dispatch servers. One trailing / is dropped from an address first. */ -}}
{{- if $hasWork -}}
{{- $_ := set $data "jira_url" (promptStringOnce . "jira_url" "Jira site URL (e.g. https://yourcompany.atlassian.net)" | trimSuffix "/") -}}
{{- $_ := set $data "gitlab_url" (promptStringOnce . "gitlab_url" "GitLab URL (e.g. https://gitlab.com/yourgroup)" | trimSuffix "/") -}}
{{- $_ := set $data "dispatch_folder" (promptStringOnce . "dispatch_folder" "Folder in your work folder that holds the dispatch servers" "ai-devtools") -}}
{{- range $key := list "jira_url" "gitlab_url" -}}
{{- if not (regexMatch "^https://[^/[:space:][:cntrl:]]+(/[^/[:space:][:cntrl:]]+)*$" (get $data $key)) }}{{ fail (printf "Invalid %s: use an https:// address with no spaces" $key) }}{{ end -}}
{{- end -}}
{{- if or (not (regexMatch "^[A-Za-z0-9._-]+$" $data.dispatch_folder)) (regexMatch "^\\.{1,2}$" $data.dispatch_folder) }}{{ fail "Invalid dispatch_folder: use one folder name with only letters, digits, . _ -, not . or .." }}{{ end -}}
{{- end -}}
{{- $mode := promptChoiceOnce . "versions_mode" "Install pinned or latest tool versions" (list "pinned" "latest") "pinned" -}}
{{- if not (has $mode (list "pinned" "latest")) }}{{ fail "Invalid versions_mode" }}{{ end -}}
{{- $_ := set $data "versions_mode" $mode -}}
{{- if $isWsl }}
{{/*
    WSL VM sizing defaults are derived from the *Windows host* (inside WSL,
    nproc and /proc/meminfo only report the VM's current cap, not the laptop).
    Rules: memory = 75% of host RAM, vCPUs = 2/3 of host logical CPUs,
    swap = memory/6. Each is a prompt-once with that default, so a machine can
    still override (answers persist in the local chezmoi.toml, never the repo).
*/}}
{{-   $hostGB := 0 }}
{{-   $hostCPU := 0 }}
{{-   if and (or (not (hasKey . "wsl_memory")) (not (hasKey . "wsl_processors"))) (lookPath "powershell.exe") }}
{{-     $hostGB = output "powershell.exe" "-NoProfile" "-Command" "[int][math]::Ceiling((Get-CimInstance Win32_ComputerSystem).TotalPhysicalMemory/1GB)" | trim | int }}
{{-     $hostCPU = output "powershell.exe" "-NoProfile" "-Command" "(Get-CimInstance Win32_ComputerSystem).NumberOfLogicalProcessors" | trim | int }}
{{-   end }}
{{-   $memGB := 8 }}
{{-   $cpus := 4 }}
{{-   if gt $hostGB 0 }}{{ $memGB = div (mul $hostGB 3) 4 }}{{ end }}
{{-   if gt $hostCPU 0 }}{{ $cpus = max 2 (div (mul $hostCPU 2) 3) }}{{ end }}
{{-   $swapGB := max 2 (div $memGB 6) }}
{{- $_ := set $data "wsl_memory" (promptStringOnce . "wsl_memory" (printf "WSL memory limit (host has %dGB; default 75%%)" $hostGB) (printf "%dGB" $memGB)) -}}
{{- $_ := set $data "wsl_processors" (promptIntOnce . "wsl_processors" (printf "WSL vCPUs (host has %d; default 2/3)" $hostCPU) (int64 $cpus)) -}}
{{- $_ := set $data "wsl_swap" (promptStringOnce . "wsl_swap" "WSL swap size (default memory/6)" (printf "%dGB" $swapGB)) -}}
{{- if not (regexMatch "^[1-9][0-9]{0,6}(MB|GB)$" $data.wsl_memory) }}{{ fail "Invalid WSL memory" }}{{ end -}}
{{- if not (regexMatch "^(0|[1-9][0-9]{0,6}(MB|GB))$" $data.wsl_swap) }}{{ fail "Invalid WSL swap" }}{{ end -}}
{{- if or (lt (int $data.wsl_processors) 1) (gt (int $data.wsl_processors) 1024) }}{{ fail "Invalid WSL processor count" }}{{ end -}}
{{- end }}
{{ dict "sourceDir" .chezmoi.sourceDir "data" $data | toToml }}
