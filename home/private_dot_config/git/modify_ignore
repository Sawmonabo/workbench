{{- /* chezmoi:modify-template */ -}}
{{- /* Git's global ignore file, which Git reads in every repository without
       any core.excludesFile setting; each pattern is relative to the
       repository's root. The entries are macOS's folder metadata, Python's
       byte-code caches, a root tmp/ and .agents/tmp/ for an agent's scratch
       files, the .worktrees folder that holds a repository's worktrees and
       Claude Code's own .claude/worktrees, .claude/tmp where Claude Code
       keeps its plans (plansDirectory), a .tickets folder of local ticket
       notes, and the agents' personal local
       files (.claude/settings.local.json, CLAUDE.local.md). The file stays the
       owner's: every line already in it is kept as it is, and only the
       entries below that it lacks are added at its end, so the file is
       untouched once it has them. A line that differs only by a trailing
       slash, or by a leading ** and slash (the form Claude Code writes),
       already covers an entry. */ -}}
{{- $live := .chezmoi.stdin -}}
{{- $lines := list -}}
{{- range splitList "\n" $live -}}
{{-   $lines = append $lines (trim .) -}}
{{- end -}}
{{- $out := $live -}}
{{- range list ".DS_Store" "__pycache__/" "/tmp/" ".agents/tmp/" ".worktrees/" ".claude/worktrees/" ".claude/tmp/" ".tickets/" ".claude/settings.local.json" "CLAUDE.local.md" -}}
{{-   $entry := . -}}
{{-   $covered := false -}}
{{-   range list $entry (trimSuffix "/" $entry) (print "**/" (trimPrefix "/" $entry)) (print "**/" (trimPrefix "/" (trimSuffix "/" $entry))) -}}
{{-     if has . $lines -}}
{{-       $covered = true -}}
{{-     end -}}
{{-   end -}}
{{-   if not $covered -}}
{{-     if and $out (not (hasSuffix "\n" $out)) -}}
{{-       $out = print $out "\n" -}}
{{-     end -}}
{{-     $out = print $out $entry "\n" -}}
{{-   end -}}
{{- end -}}
{{- $out -}}
