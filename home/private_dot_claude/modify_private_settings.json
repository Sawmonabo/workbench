{{- /* chezmoi:modify-template */ -}}
{{- /* Claude Code rewrites its own settings. Defaults fill only missing keys,
       live values win over them, and enforced policy wins over both.
       Permission lists and the hook lists of the events enforced below keep
       entries the user added (a user SessionStart hook survives next to the
       managed one). The merge only adds
       and overwrites, so an entry dropped from enforced stays in the live
       file. When the merge changes no value the file is left exactly as
       Claude Code wrote it, key order included. Invalid JSON fails the apply
       instead of being replaced. */ -}}
{{- $live := .chezmoi.stdin | default "{}" | fromJson -}}
{{- $unchanged := toJson $live -}}
{{- $enforced := deepCopy .claude.enforced -}}
{{- range $list := list "allow" "deny" "ask" -}}
  {{- $managed := index $enforced.permissions $list -}}
  {{- $granted := dig "permissions" $list (list) $live -}}
  {{- $_ := set $enforced.permissions $list (concat $managed $granted | uniq) -}}
{{- end -}}
{{- /* A live group that runs `workbench costs` is a copy of an enforced hook,
       possibly from an older release; drop it so a changed managed hook
       replaces its old copy instead of running beside it. A group that runs
       ~/.local/bin/claude-costs, the script this replaced, goes too: the same
       apply removes that script (.chezmoiremove), so its hook could only fail. */ -}}
{{- range $event, $groups := $enforced.hooks -}}
  {{- $kept := list -}}
  {{- range $group := dig "hooks" $event (list) $live -}}
    {{- $ours := false -}}
    {{- if kindIs "map" $group -}}
      {{- range $hook := get $group "hooks" | default list -}}
        {{- if kindIs "map" $hook -}}
          {{- $command := get $hook "command" | toString -}}
          {{- if or (contains "workbench costs" $command) (contains ".local/bin/claude-costs" $command) -}}
            {{- $ours = true -}}
          {{- end -}}
        {{- end -}}
      {{- end -}}
    {{- end -}}
    {{- if not $ours -}}
      {{- $kept = append $kept $group -}}
    {{- end -}}
  {{- end -}}
  {{- $_ := set $enforced.hooks $event (concat $groups $kept | uniq) -}}
{{- end -}}
{{- $merged := mustMergeOverwrite (deepCopy .claude.defaults) $live $enforced -}}
{{- if eq (toJson $merged) $unchanged -}}
{{ .chezmoi.stdin }}
{{- else -}}
{{ toPrettyJson $merged }}
{{- end -}}
