{{- /* chezmoi:modify-template */ -}}
{{- /* Claude Code rewrites its own settings. Defaults fill only missing keys,
       live values win over them, and enforced policy wins over both.
       Permission lists and the hook lists of the events enforced below keep
       entries the user added (a user SessionStart hook survives next to the
       managed one). The merge only adds
       and overwrites, so an entry dropped from enforced stays in the live
       file. When the merge changes no value the file is left exactly as
       Claude Code wrote it, key order included. Invalid JSON fails the apply
       instead of being replaced. */ -}}
{{- $live := .chezmoi.stdin | default "{}" | fromJson -}}
{{- $unchanged := toJson $live -}}
{{- $enforced := deepCopy .claude.enforced -}}
{{- range $list := list "allow" "deny" "ask" -}}
  {{- $managed := index $enforced.permissions $list -}}
  {{- $granted := dig "permissions" $list (list) $live -}}
  {{- $_ := set $enforced.permissions $list (concat $managed $granted | uniq) -}}
{{- end -}}
{{- /* An enforced hook that runs `workbench ` names it without a folder;
       each runs the installed workbench (the workbench-command template).
       A live group that runs `workbench costs`, by any path, is a copy of an
       enforced hook, possibly from an older release or another bin folder;
       drop it so a changed managed hook replaces its old copy instead of
       running beside it. A group that runs `workbench guard` is likewise a
       copy of the managed guard hook. A group that runs
       ~/.local/bin/claude-costs, the script this replaced, goes too: the same
       apply removes that script (.chezmoiremove), so its hook could only
       fail. */ -}}
{{- $workbench := includeTemplate "workbench-command" (dict "root" . "tilde" true) -}}
{{- range $event, $groups := $enforced.hooks -}}
  {{- range $group := $groups -}}
    {{- range $hook := $group.hooks -}}
      {{- if hasPrefix "workbench " $hook.command -}}
        {{- $_ := set $hook "command" (printf "%s %s" $workbench (trimPrefix "workbench " $hook.command)) -}}
      {{- end -}}
    {{- end -}}
  {{- end -}}
  {{- $kept := list -}}
  {{- range $group := dig "hooks" $event (list) $live -}}
    {{- $ours := false -}}
    {{- if kindIs "map" $group -}}
      {{- range $hook := get $group "hooks" | default list -}}
        {{- if kindIs "map" $hook -}}
          {{- $command := get $hook "command" | toString -}}
          {{- if or (regexMatch "workbench'? (costs|guard)( |$)" $command) (contains ".local/bin/claude-costs" $command) -}}
            {{- $ours = true -}}
          {{- end -}}
        {{- end -}}
      {{- end -}}
    {{- end -}}
    {{- if not $ours -}}
      {{- $kept = append $kept $group -}}
    {{- end -}}
  {{- end -}}
  {{- $_ := set $enforced.hooks $event (concat $groups $kept | uniq) -}}
{{- end -}}
{{- /* In pinned mode Claude Code's own background updates keep at least the
       version Workbench updated it to: minimumVersion, the floor Claude Code
       documents, is raised to the workbench_claude_floor answer, the pin or
       the installed version while that is older (claudeFloor in
       internal/machine/agents.go), so a stable channel older than the pin
       cannot take back the update, and a floor never stops an update that has
       not run. A floor at or above it, or one that is not three dotted
       numbers, stays as it is; without the answer nothing is set. */ -}}
{{- with get . "workbench_claude_floor" -}}
  {{- $floor := get $live "minimumVersion" | default "" | toString -}}
  {{- if or (not $floor) (and (regexMatch "^[0-9]+\\.[0-9]+\\.[0-9]+$" $floor) (semverCompare (printf "< %s" .) $floor)) -}}
    {{- $_ := set $enforced "minimumVersion" . -}}
  {{- end -}}
{{- end -}}
{{- $merged := mustMergeOverwrite (deepCopy .claude.defaults) $live $enforced -}}
{{- if eq (toJson $merged) $unchanged -}}
{{ .chezmoi.stdin }}
{{- else -}}
{{ toPrettyJson $merged }}
{{- end -}}
