[user]
    name = {{ includeTemplate "git-quote" .name }}
    email = {{ includeTemplate "git-quote" .email }}
[core]
    editor = {{ includeTemplate "editor-command" .editor }}
[init]
    defaultBranch = main
[pull]
    rebase = false
[push]
    autoSetupRemote = true
[fetch]
    prune = true
[rerere]
    enabled = true
{{- /* zdiff3 needs Git 2.35. Ubuntu 22.04 ships 2.34, which stops checkout,
       merge, rebase and stash pop with "unknown style" on it, so there the
       style is diff3, the same markers without zdiff3's trimming. Every other
       supported system ships a newer Git. Ubuntu 22.04's 2.34 also ignores
       push.autoSetupRemote (Git 2.37). */}}
{{- $conflictStyle := "zdiff3" }}
{{- if and (eq .chezmoi.os "linux") (eq (get .chezmoi.osRelease "id") "ubuntu") (eq (get .chezmoi.osRelease "versionID") "22.04") }}
{{-   $conflictStyle = "diff3" }}
{{- end }}
[merge]
    conflictStyle = {{ $conflictStyle }}

{{- if eq .machine_role "both" }}

# Directory-based identity overrides (machine_role = both).
# {{ .personal_folder }}/ is personal, {{ .work_folder }}/ is work. Single-role machines
# use [user] email everywhere and deploy neither override file.
[includeIf "gitdir:{{ .personal_folder }}/"]
    path = ~/.gitconfig-personal
[includeIf "gitdir:{{ .work_folder }}/"]
    path = ~/.gitconfig-work
{{- end }}
[alias]
    refresh = !git fetch --all --prune && git pull --all --prune

# GitHub auth via the gh CLI (gh auth login). Always written, so the first
# apply on a fresh machine already has it; it does nothing until gh is on
# PATH: the command -v guard makes a missing gh answer nothing, so git asks as
# usual instead of printing "command not found" on every GitHub fetch.
# Path-independent so the same block works on Linux/WSL and macOS (brew). The
# empty helper line clears any system-level helper first, as
# `gh auth setup-git` writes it.
[credential "https://github.com"]
    helper =
    helper = !command -v gh >/dev/null 2>&1 && gh auth git-credential
[credential "https://gist.github.com"]
    helper =
    helper = !command -v gh >/dev/null 2>&1 && gh auth git-credential
