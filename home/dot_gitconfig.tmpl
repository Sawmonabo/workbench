[user]
    name = {{ includeTemplate "git-quote" .name }}
    email = {{ includeTemplate "git-quote" .email }}
[core]
    editor = {{ includeTemplate "editor-command" .editor }}
[init]
    defaultBranch = main
[pull]
    rebase = false

{{- if eq .machine_role "both" }}

# Directory-based identity overrides (machine_role = both).
# ~/dev/ is personal, ~/repos/ is work. Single-role machines
# use [user] email everywhere and deploy neither override file.
[includeIf "gitdir:~/dev/"]
    path = ~/.gitconfig-personal
[includeIf "gitdir:~/repos/"]
    path = ~/.gitconfig-work
{{- end }}
[alias]
    refresh = !git fetch --all --prune && git pull --all --prune

# GitHub auth via the gh CLI (gh auth login). Always written, so the first
# apply on a fresh machine already has it; it does nothing until gh is on
# PATH: the command -v guard makes a missing gh answer nothing, so git asks as
# usual instead of printing "command not found" on every GitHub fetch.
# Path-independent so the same block works on Linux/WSL and macOS (brew). The
# empty helper line clears any system-level helper first, as
# `gh auth setup-git` writes it.
[credential "https://github.com"]
    helper =
    helper = !command -v gh >/dev/null 2>&1 && gh auth git-credential
[credential "https://gist.github.com"]
    helper =
    helper = !command -v gh >/dev/null 2>&1 && gh auth git-credential
