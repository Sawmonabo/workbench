# ~/.bashrc: executed by bash(1) for non-login shells.

# If not running interactively, don't do anything
case $- in
    *i*) ;;
      *) return;;
esac

# AlmaLinux's bash reads /etc/bashrc only through ~/.bashrc, and it is what
# runs /etc/profile.d in a non-login shell. Ubuntu has no /etc/bashrc.
[ -f /etc/bashrc ] && . /etc/bashrc

# --- History ---
HISTCONTROL=ignoreboth
shopt -s histappend
HISTSIZE=1000
HISTFILESIZE=2000

# --- Shell options ---
shopt -s checkwinsize
#shopt -s globstar

# make less more friendly for non-text input files, see lesspipe(1)
[ -x /usr/bin/lesspipe ] && eval "$(SHELL=/bin/sh lesspipe)"

# set variable identifying the chroot you work in (used in the prompt below)
if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
    debian_chroot=$(cat /etc/debian_chroot)
fi

# --- Color support ---
if [ -x /usr/bin/dircolors ]; then
    test -r ~/.dircolors && eval "$(dircolors -b ~/.dircolors)" || eval "$(dircolors -b)"
    alias ls='ls -lha --color=auto'
    alias grep='grep --color=auto'
    alias fgrep='fgrep --color=auto'
    alias egrep='egrep --color=auto'
fi

# --- Aliases ---
alias ll='ls -alF'
alias la='ls -A'
alias l='ls -CF'
alias cat='bat --paging=never'
# The agents keep the shell's credentials for their whole session, so each
# starts with those of the folder it starts in (see Credentials below). The
# editor gets none: one opened from the work folder would pass the work names
# to every window it opens later.
claude() { __workbench_folder_env; command claude --verbose --allow-dangerously-skip-permissions "$@"; }
codex() { __workbench_folder_env; command codex "$@"; }
code() {
    local name file removed=() __workbench_env_names __workbench_env_values
    for name in "${__workbench_env_loaded[@]}"; do
        removed+=(-u "$name")
    done
    for file in "${__workbench_env_files[@]}"; do
        __workbench_env_read "$file"
        for name in "${__workbench_env_names[@]}"; do
            removed+=(-u "$name")
        done
    done
    env "${removed[@]}" code "$@"
}

alias alert='notify-send --urgency=low -i "$([ $? = 0 ] && echo terminal || echo error)" "$(history|tail -n1|sed -e '\''s/^\s*[0-9]\+\s*//;s/[;&|]\s*alert$//'\'')"'

# Source local aliases if they exist (not managed by chezmoi)
if [ -f ~/.bash_aliases ]; then
    . ~/.bash_aliases
fi

# --- Completion ---
if ! shopt -oq posix; then
    if [ -f /usr/share/bash-completion/bash_completion ]; then
        . /usr/share/bash-completion/bash_completion
    elif [ -f /etc/bash_completion ]; then
        . /etc/bash_completion
    fi
fi

# --- PATH ---
export PATH="$HOME/.local/bin:$PATH"
{{ with get . "workbench_uv_dir" -}}
# Reuse Workbench's selected private uv owner in new interactive shells.
export PATH={{ . | replace "'" "'\"'\"'" | printf "'%s'" }}:"$PATH"
{{ end -}}

# Go
export PATH="/usr/local/go/bin:$HOME/go/bin:$PATH"

# Cargo (Rust)
[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"

# nvm (Node.js)
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

# Workbench: Tab completion for its commands and flags. The script is saved
# once per installed workbench in Workbench's cache folder, picked the way
# Workbench picks it, so a new shell runs workbench only after an update or the
# first time. It comes after the PATH lines that find workbench and needs the
# bash-completion package loaded above (Ubuntu ships it). A relative
# WORKBENCH_CACHE_DIR, which Workbench refuses, saves nothing: completion then
# loads straight from workbench.
if command -v workbench &> /dev/null && declare -F _get_comp_words_by_ref &> /dev/null; then
    _workbench_bin=$(readlink -f "$(command -v workbench)")
    if [[ $WORKBENCH_CACHE_DIR == /* ]]; then
        _workbench_cache=$WORKBENCH_CACHE_DIR
    elif [[ -n $WORKBENCH_CACHE_DIR ]]; then
        _workbench_cache=
    elif [[ $XDG_CACHE_HOME == /* ]]; then
        _workbench_cache=$XDG_CACHE_HOME/workbench
    else
        _workbench_cache=$HOME/.cache/workbench
    fi
    if [ -n "$_workbench_cache" ]; then
        _workbench_completion=$_workbench_cache/completion.bash
        _workbench_saved=
        [ -O "$_workbench_completion" ] && [ -r "$_workbench_completion" ] &&
            read -r _workbench_saved < "$_workbench_completion"
        if [ "$_workbench_saved" != "# $_workbench_bin" ]; then
            # The folders are made as Workbench makes them, in a subshell so
            # this shell's umask stays as it is: missing parents writable by
            # you alone, the folder itself private (an existing one keeps its
            # mode), and the file 0600. It replaces the old file only when
            # workbench completion succeeds.
            (
                umask go-w && mkdir -p "$(dirname "$_workbench_cache")" && mkdir -m 700 -p "$_workbench_cache" || exit
                umask 077
                if { printf '# %s\n' "$_workbench_bin" && workbench completion bash; } > "$_workbench_completion.$$"; then
                    mv -f "$_workbench_completion.$$" "$_workbench_completion"
                else
                    rm -f "$_workbench_completion.$$"
                fi
            )
        fi
        [ -O "$_workbench_completion" ] && [ -r "$_workbench_completion" ] && . "$_workbench_completion"
    else
        . <(workbench completion bash)
    fi
    unset _workbench_bin _workbench_cache _workbench_completion _workbench_saved
fi

# --- Oh My Posh prompt ---
eval "$(oh-my-posh init bash --config ~/.config/oh-my-posh/catppuccin_mocha.omp.json)"

# --- Credentials ---
# Workbench's env files hold each role's credentials as NAME=value lines.
# __workbench_folder_env exports a role's file only while the shell is in that
# role's folder or below it, symlinks resolved. On every change it first
# unsets every name it exported before, kept in __workbench_env_loaded (names
# only, never values), even one the file no longer lists or that can no
# longer be read; then the names the other files list, so names a parent
# shell passed down go too; then it loads the folder's file. So a command run
# in one folder never sees another role's credentials. It reads the files line
# by line and never sources them: a line that is not NAME=value with a valid
# name and an unquoted value, or that ends in a carriage return, is skipped,
# as workbench apply reports, and so is a name with an empty value, which
# would hide a tool's own setting. A file open to group or others is not
# loaded (chmod 600 or 400 loads it). It runs on every cd, pushd and popd and
# before every prompt, and does nothing while the folder and the files' times
# and modes are unchanged.
{{- $config := includeTemplate "workbench-config" . }}
__workbench_env_folders=()
__workbench_env_files=()
{{- if .has_work }}
__workbench_env_folders+=({{ joinPath .chezmoi.homeDir (trimPrefix "~/" .work_folder) | replace "'" "'\"'\"'" | printf "'%s'" }})
__workbench_env_files+=({{ joinPath $config "work.env" | replace "'" "'\"'\"'" | printf "'%s'" }})
{{- end }}
{{- if .has_personal }}
__workbench_env_folders+=({{ joinPath .chezmoi.homeDir (trimPrefix "~/" .personal_folder) | replace "'" "'\"'\"'" | printf "'%s'" }})
__workbench_env_files+=({{ joinPath $config "personal.env" | replace "'" "'\"'\"'" | printf "'%s'" }})
{{- end }}
# __workbench_env_read FILE sets the caller's __workbench_env_names and
# __workbench_env_values to the names FILE sets and their values, read as
# ParseEnvFile (internal/machine/envfiles.go) reads them.
__workbench_env_read() {
    local line name value
    __workbench_env_names=() __workbench_env_values=()
    [ -r "$1" ] || return 0
    while IFS= read -r line || [ -n "$line" ]; do
        name=${line%%=*} value=${line#*=}
        [[ $line == *=* && $name =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || continue
        [[ -n $value && $value != [\"\']* && $value != *$'\r' ]] || continue
        __workbench_env_names+=("$name")
        __workbench_env_values+=("$value")
    done < "$1"
}
__workbench_folder_env() {
    case $- in
        *i*) ;;
        *) return 0 ;;
    esac
    # The locals are prefixed so that no name in a file lands on one of them.
    local _wb_here _wb_key _wb_i _wb_name _wb_folder _wb_load=-1 __workbench_env_names __workbench_env_values
    _wb_here=$(pwd -P 2>/dev/null)
    _wb_key="$_wb_here
$(stat -c '%n %.9Y %a' -- "${__workbench_env_files[@]}" 2>/dev/null)"
    [ "$_wb_key" = "${__workbench_env_key-}" ] && return 0
    __workbench_env_key=$_wb_key
    # -v, so a name that is no variable never removes a function of that name.
    for _wb_name in "${__workbench_env_loaded[@]}"; do
        unset -v "$_wb_name" 2>/dev/null
    done
    __workbench_env_loaded=()
    for _wb_i in "${!__workbench_env_files[@]}"; do
        _wb_folder=$(readlink -f -- "${__workbench_env_folders[_wb_i]}") ||
            _wb_folder=${__workbench_env_folders[_wb_i]}
        if [[ $_wb_here == "$_wb_folder" || $_wb_here == "$_wb_folder"/* ]] &&
            [[ $(stat -c %a -- "${__workbench_env_files[_wb_i]}" 2>/dev/null) == *00 ]]; then
            _wb_load=$_wb_i
            continue
        fi
        __workbench_env_read "${__workbench_env_files[_wb_i]}"
        for _wb_name in "${__workbench_env_names[@]}"; do
            unset -v "$_wb_name" 2>/dev/null
        done
    done
    # Loaded last, so a name both files use keeps this folder's value.
    if [ "$_wb_load" -ge 0 ]; then
        __workbench_env_read "${__workbench_env_files[_wb_load]}"
        for _wb_i in "${!__workbench_env_names[@]}"; do
            export "${__workbench_env_names[_wb_i]}=${__workbench_env_values[_wb_i]}" 2>/dev/null &&
                __workbench_env_loaded+=("${__workbench_env_names[_wb_i]}")
        done
    fi
    return 0
}
cd() { builtin cd "$@" || return; __workbench_folder_env; }
pushd() { builtin pushd "$@" || return; __workbench_folder_env; }
popd() { builtin popd "$@" || return; __workbench_folder_env; }
# oh-my-posh makes PROMPT_COMMAND a list ending in its own hook, which reads
# the last command's exit status, so the hook joins the list after it, once.
[[ " ${PROMPT_COMMAND[*]} " == *" __workbench_folder_env "* ]] ||
    PROMPT_COMMAND+=(__workbench_folder_env)

# --- Editor ---
export EDITOR="{{ includeTemplate "editor-command" .editor }}"

{{- if .has_work }}

# --- Work tooling ---
# promptctl
[ -f "$HOME/.promptctl/shell/aliases.sh" ] && source "$HOME/.promptctl/shell/aliases.sh"
{{- end }}
{{- if .is_wsl }}

# WSL: hand the VM's file cache back to Windows on demand. Linux keeps
# everything it reads cached (shows up as vmmemWSL in Task Manager); this is
# reclaimable and autoMemoryReclaim trims it when idle, but after big image
# pulls / clones you may want it back immediately.
alias clear-cache="sudo sh -c 'sync; echo 3 > /proc/sys/vm/drop_caches' && free -h"

# WSL: route browser opens (gh auth, xdg-open) to Windows
# via ~/.local/bin/win-browser (Chrome -> wslview -> Windows default). A
# wrapper rather than chrome.exe directly because some tools (gh) split
# $BROWSER on spaces, and wslview alone is unavailable on Ubuntu 26.04 —
# an unresolvable BROWSER makes CLIs hang silently waiting for a callback.
if [ -x "$HOME/.local/bin/win-browser" ]; then
    export BROWSER="$HOME/.local/bin/win-browser"
fi
{{- end }}

# Added by remote-dev-workstation install
export PATH="$HOME/bin:$PATH"
