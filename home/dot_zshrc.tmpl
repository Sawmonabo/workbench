# ~/.zshrc: executed by zsh for interactive shells.

# --- History ---
HISTSIZE=1000
SAVEHIST=2000
HISTFILE=~/.zsh_history
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_SPACE
setopt APPEND_HISTORY
setopt SHARE_HISTORY

# --- PATH ---
# Homebrew (Apple Silicon)
if [ -d "/opt/homebrew/bin" ]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
fi
# Homebrew (Intel)
if [ -x "/usr/local/bin/brew" ]; then
    eval "$(/usr/local/bin/brew shellenv)"
fi

export PATH="$HOME/.local/bin:$PATH"
{{ with get . "workbench_uv_dir" -}}
# Reuse Workbench's selected private uv owner in new interactive shells.
export PATH={{ . | replace "'" "'\"'\"'" | printf "'%s'" }}:"$PATH"
{{ end -}}

# Go
export PATH="/usr/local/go/bin:$HOME/go/bin:$PATH"

# Cargo (Rust)
[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"

# nvm (Node.js)
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

# PostgreSQL: keg-only, so it needs a PATH entry. The version-free opt link is
# the alias Homebrew maintains for the "postgresql" formula in packages.toml, so
# this follows whichever major version that alias currently installs.
export PATH="/opt/homebrew/opt/postgresql/bin:$PATH"

# --- Completion ---
# Every fpath entry must be in place before compinit runs, or its completions
# are never registered: brew shellenv (above) prepends Homebrew's
# site-functions, and Docker Desktop writes the docker CLI completion to
# ~/.docker/completions. compinit run at the top of this file would leave
# docker, gh, brew and chezmoi without completion in a fresh terminal.
# The five lines below are byte-for-byte what Docker Desktop's "Configure shell
# completions -> Automatically" appends to .zshrc. Keeping them identical here
# means Docker Desktop recognises the setup and never appends a second copy,
# while chezmoi stays the owner of the file. The guarded compinit runs once in
# a fresh shell and registers everything in fpath, Homebrew's included.
# The following lines have been added by Docker Desktop to enable Docker CLI completions.
fpath=({{ .chezmoi.homeDir }}/.docker/completions $fpath)
autoload -Uz compinit
(( ${+_comps[docker]} )) || compinit
# End of Docker CLI completions

# uv (Python package and project manager): defines its completion at runtime,
# so it has to come after compinit.
if command -v uv &> /dev/null; then
    eval "$(uv generate-shell-completion zsh)"
fi

# Workbench: Tab completion for its commands and flags. The script is saved
# once per installed workbench in Workbench's cache folder, picked the way
# Workbench picks it, and sourced after compinit, so a new shell runs
# workbench only after an update or the first time. A relative
# WORKBENCH_CACHE_DIR, which Workbench refuses, saves nothing: completion then
# loads straight from workbench.
if (( ${+commands[workbench]} )); then
    _workbench_bin=${commands[workbench]:A}
    if [[ $WORKBENCH_CACHE_DIR == /* ]]; then
        _workbench_cache=$WORKBENCH_CACHE_DIR
    elif [[ -n $WORKBENCH_CACHE_DIR ]]; then
        _workbench_cache=
    elif [[ $XDG_CACHE_HOME == /* ]]; then
        _workbench_cache=$XDG_CACHE_HOME/workbench
    else
        _workbench_cache=$HOME/Library/Caches/workbench
    fi
    if [[ -n $_workbench_cache ]]; then
        _workbench_completion=$_workbench_cache/completion.zsh
        _workbench_saved=
        [[ -O $_workbench_completion && -r $_workbench_completion ]] &&
            read -r _workbench_saved < "$_workbench_completion"
        if [[ $_workbench_saved != "# $_workbench_bin" ]]; then
            # The folders are made as Workbench makes them, in a subshell so
            # this shell's umask stays as it is: missing parents writable by
            # you alone, the folder itself private (an existing one keeps its
            # mode), and the file 0600. It replaces the old file only when
            # workbench completion succeeds.
            (
                umask go-w && mkdir -p "${_workbench_cache:h}" && mkdir -m 700 -p "$_workbench_cache" || exit
                umask 077
                if { print -r -- "# $_workbench_bin" && workbench completion zsh; } >| "$_workbench_completion.$$"; then
                    mv -f "$_workbench_completion.$$" "$_workbench_completion"
                else
                    rm -f "$_workbench_completion.$$"
                fi
            )
        fi
        [[ -O $_workbench_completion && -r $_workbench_completion ]] && source "$_workbench_completion"
    else
        source <(workbench completion zsh)
    fi
    unset _workbench_bin _workbench_cache _workbench_completion _workbench_saved
fi

# --- Aliases ---
alias ls='ls -lhaG'
alias ll='ls -alF'
alias la='ls -A'
alias l='ls -CF'
alias cat='bat --paging=never'
alias grep='grep --color=auto'
# The agents keep the shell's credentials for their whole session, so each
# starts with those of the folder it starts in (see Credentials below). The
# editor gets none: one opened from the work folder would pass the work names
# to every window it opens later.
claude() { __workbench_folder_env; command claude --verbose --allow-dangerously-skip-permissions "$@"; }
codex() { __workbench_folder_env; command codex "$@"; }
code() {
    local name file
    local -a removed __workbench_env_names __workbench_env_values
    for name in $__workbench_env_loaded; do
        removed+=(-u $name)
    done
    for file in $__workbench_env_files; do
        __workbench_env_read $file
        for name in $__workbench_env_names; do
            removed+=(-u $name)
        done
    done
    env $removed code "$@"
}

# --- Oh My Posh prompt ---
eval "$(oh-my-posh init zsh --config ~/.config/oh-my-posh/catppuccin_mocha.omp.json)"

# --- Credentials ---
# Workbench's env files hold each role's credentials as NAME=value lines.
# __workbench_folder_env exports a role's file only while the shell is in that
# role's folder or below it, symlinks resolved. On every change it first
# unsets every name it exported before, kept in __workbench_env_loaded (names
# only, never values), even one the file no longer lists or that can no
# longer be read; then the names the other files list, so names a parent
# shell passed down go too; then it loads the folder's file. So a command run
# in one folder never sees another role's credentials. It reads the files line
# by line and never sources them: a line that is not NAME=value with a valid
# name and an unquoted value, that ends in a carriage return, whose value
# starts or ends with a space or tab (in any locale, only those two), or that
# names a variable the bash or zsh hook runs through (PATH, path, HOME, PWD,
# PROMPT_COMMAND, precmd_functions, chpwd_functions, __workbench_*, _wb_*) is
# skipped, as workbench apply reports, and so is a name with an empty value,
# which would hide a tool's own setting. A file open to group or others is not
# loaded (chmod 600 or 400 loads it). It runs on every change of folder and
# before every prompt, and does nothing while the folder and the files'
# times, sizes and modes are unchanged. Only zstat is loaded from zsh/stat, so
# the stat command stays the system's.
{{- $config := includeTemplate "workbench-config" . }}
__workbench_env_folders=()
__workbench_env_files=()
{{- if .has_work }}
__workbench_env_folders+=({{ joinPath .chezmoi.homeDir (trimPrefix "~/" .work_folder) | replace "'" "'\"'\"'" | printf "'%s'" }})
__workbench_env_files+=({{ joinPath $config "work.env" | replace "'" "'\"'\"'" | printf "'%s'" }})
{{- end }}
{{- if .has_personal }}
__workbench_env_folders+=({{ joinPath .chezmoi.homeDir (trimPrefix "~/" .personal_folder) | replace "'" "'\"'\"'" | printf "'%s'" }})
__workbench_env_files+=({{ joinPath $config "personal.env" | replace "'" "'\"'\"'" | printf "'%s'" }})
{{- end }}
zmodload -F zsh/stat b:zstat
# __workbench_env_read FILE sets the caller's __workbench_env_names and
# __workbench_env_values to the names FILE sets and their values, read as
# ParseEnvFile (internal/machine/envfiles.go) reads them.
__workbench_env_read() {
    local line name value
    __workbench_env_names=() __workbench_env_values=()
    [[ -r $1 ]] || return 0
    while IFS= read -r line || [[ -n $line ]]; do
        name=${line%%=*} value=${line#*=}
        [[ $line == *=* && $name =~ '^[A-Za-z_][A-Za-z0-9_]*$' ]] || continue
        [[ ! $name =~ '^(PATH|path|HOME|PWD|PROMPT_COMMAND|precmd_functions|chpwd_functions|__workbench_.*|_wb_.*)$' ]] ||
            continue
        [[ -n $value && $value != [\"\']* && $value != *$'\r' &&
            $value != [$' \t']* && $value != *[$' \t'] ]] || continue
        __workbench_env_names+=("$name")
        __workbench_env_values+=("$value")
    done < "$1"
}
__workbench_folder_env() {
    [[ -o interactive ]] || return 0
    # The locals are prefixed so that no name in a file lands on one of them.
    local _wb_here=${PWD:A} _wb_key _wb_i _wb_name _wb_folder _wb_load=0
    local -a _wb_time _wb_size _wb_mode _wb_modes __workbench_env_names __workbench_env_values
    _wb_key=$_wb_here
    for (( _wb_i = 1; _wb_i <= ${#__workbench_env_files}; _wb_i++ )); do
        _wb_time=() _wb_size=() _wb_mode=()
        zstat -L -F '%s.%N' -A _wb_time +mtime $__workbench_env_files[_wb_i] 2>/dev/null
        zstat -L -A _wb_size +size $__workbench_env_files[_wb_i] 2>/dev/null
        zstat -L -o -A _wb_mode +mode $__workbench_env_files[_wb_i] 2>/dev/null
        _wb_modes[_wb_i]=${_wb_mode[1]-}
        _wb_key+=$'\n'"${_wb_time[1]-} ${_wb_size[1]-} ${_wb_mode[1]-}"
    done
    [[ $_wb_key == "${__workbench_env_key-}" ]] && return 0
    __workbench_env_key=$_wb_key
    # -v, as in bash, where a name that is no variable would remove a function.
    for _wb_name in $__workbench_env_loaded; do
        unset -v $_wb_name 2>/dev/null
    done
    __workbench_env_loaded=()
    for (( _wb_i = 1; _wb_i <= ${#__workbench_env_files}; _wb_i++ )); do
        _wb_folder=${__workbench_env_folders[_wb_i]:A}
        if [[ ($_wb_here == $_wb_folder || $_wb_here == $_wb_folder/*) && $_wb_modes[_wb_i] == *00 ]]; then
            _wb_load=$_wb_i
            continue
        fi
        __workbench_env_read $__workbench_env_files[_wb_i]
        for _wb_name in $__workbench_env_names; do
            unset -v $_wb_name 2>/dev/null
        done
    done
    # Loaded last, so a name both files use keeps this folder's value.
    if (( _wb_load )); then
        __workbench_env_read $__workbench_env_files[_wb_load]
        for (( _wb_i = 1; _wb_i <= ${#__workbench_env_names}; _wb_i++ )); do
            export "$__workbench_env_names[_wb_i]=$__workbench_env_values[_wb_i]" 2>/dev/null &&
                __workbench_env_loaded+=($__workbench_env_names[_wb_i])
        done
    fi
    return 0
}
autoload -Uz add-zsh-hook
add-zsh-hook chpwd __workbench_folder_env
add-zsh-hook precmd __workbench_folder_env

# --- Editor ---
export EDITOR="{{ includeTemplate "editor-command" .editor }}"

# --- Local overrides (not managed by chezmoi) ---
# Machine-specific aliases and installer blocks belong here so chezmoi apply
# never removes them.
[ -f "$HOME/.zshrc.local" ] && source "$HOME/.zshrc.local"
