{{ if .is_wsl -}}
#!/bin/bash
# Kernel tuning for a large-memory WSL VM. Re-runs whenever this file changes.
#
# vm.swappiness=10: with tens of GB assigned to the VM there is no reason to
# page idle program memory out to make room for file cache; keep apps resident
# and swap only under real pressure (the kernel default of 60 is eager).
# Needs sudo; when no tty/sudo credential is available it prints the manual
# step, names the step blocked in the file Workbench reads, and exits 0: it runs
# again on the next apply. A write that fails is named the same way and ends
# the script nonzero.
set -euo pipefail
if [ "${WORKBENCH_PROBE:-}" = 1 ]; then
    if [[ -f /etc/sysctl.d/99-dev.conf ]] && grep -qx 'vm.swappiness=10' /etc/sysctl.d/99-dev.conf; then
        echo "sysctl: = vm.swappiness is set to 10 and kept across restarts"
    else
        echo "sysctl: vm.swappiness is $(cat /proc/sys/vm/swappiness 2>/dev/null || echo unknown), will be 10 (uses sudo)"
    fi
    exit 0
fi
if [[ "${WORKBENCH_EFFECT_SYSCTL:-}" != 1 ]]; then
    echo 'WORKBENCH_EFFECT sysctl disabled (not selected)' >&2
    exit 0
fi
{{ template "effect-report.sh" }}

CONF=/etc/sysctl.d/99-dev.conf
WANT='vm.swappiness=10'

if [[ -f $CONF ]] && grep -qx "$WANT" "$CONF"; then
    echo "==> sysctl: $CONF already up to date."
    exit 0
fi

if ! sudo -n true 2>/dev/null && [[ ! -t 0 ]]; then
    echo "==> sysctl: sudo needs a password and there is no terminal — skipped."
    echo "    Apply manually:  echo '$WANT' | sudo tee $CONF && sudo sysctl -p $CONF"
    part_blocked sysctl "sudo needs a password and there is no terminal; run the manual step above"
    exit 0
fi

echo "==> sysctl: writing $CONF ($WANT)"
printf '# managed by Workbench (WSL kernel tuning step)\n%s\n' "$WANT" | sudo tee "$CONF" >/dev/null ||
    part_failed sysctl "$CONF could not be written (the output above says why), so vm.swappiness was not changed" ||
    exit 1
sudo sysctl -q -p "$CONF" ||
    part_failed sysctl "$CONF was written but could not be loaded (the output above says why); run: sudo sysctl -p $CONF" ||
    exit 1
echo "    vm.swappiness is now $(sysctl -n vm.swappiness)"
{{ end -}}
