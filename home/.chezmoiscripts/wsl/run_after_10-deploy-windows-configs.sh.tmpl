{{ if .is_wsl -}}
#!/bin/bash
# Deploy .wslconfig to the Windows filesystem, and the other Windows-side pieces
# of the setup. Earlier releases also wrote RestartWSL helper scripts; copies
# left on the Windows drive are the owner's, and nothing here touches them.
# Re-runs whenever this template's content changes
#
# .wslconfig: a new file is written fresh; an existing one gets the managed keys
# merged into it, everything else kept, after a dated recovery copy is saved.
# Only one WSL distribution writes .wslconfig and the default distribution: the
# one windows-writers.sh's record names (take-over-<effect> moves it). The
# default distribution is the one plain `wsl` opens and, where Windows Terminal
# has more than one WSL profile to choose from, the one new Terminal tabs open
# (its settings.json defaultProfile, the one key this script writes there).
# The plan the owner approved is the consent: nothing here asks a question.
set -euo pipefail

{{ includeTemplate ".chezmoitemplates/windows-calls.sh" . }}
{{ template "windows-writers.sh" }}
{{ template "windows-terminal.sh" }}

# Whether the apply asks for WSL networking or the default distribution: ticked,
# or its take-over is. Which of them then runs is the writer record's
# (writer_runs).
asked_preferences=0 asked_default=0
if [ "${WORKBENCH_EFFECT_WSL_PREFERENCES:-1}" = 1 ] || [ "${WORKBENCH_EFFECT_TAKE_OVER_WSL_PREFERENCES:-0}" = 1 ]; then
    asked_preferences=1
fi
if [ "${WORKBENCH_EFFECT_DEFAULT_DISTRO:-0}" = 1 ] || [ "${WORKBENCH_EFFECT_TAKE_OVER_DEFAULT_DISTRO:-0}" = 1 ]; then
    asked_default=1
fi

# What the probe or the apply says about a Windows host that cannot be used: one
# line per effect this script carries, since each of them is affected. An apply
# names each effect it was asked to do as blocked, in the file Workbench reads,
# and ends the script successfully, so the scripts after it still run; Workbench
# ends the apply blocked once the rest has run.
blocked() {
    if [ "${WORKBENCH_PROBE:-}" = 1 ]; then
        for effect in windows-files wsl-preferences default-distro windows-path; do
            echo "$effect: can't run here, $1"
        done
        exit 0
    fi
    [ "${WORKBENCH_EFFECT_WINDOWS_FILES:-1}" != 1 ] || part_blocked windows-files "$1"
    [ "$asked_preferences" != 1 ] || part_blocked wsl-preferences "$1"
    [ "$asked_default" != 1 ] || part_blocked default-distro "$1"
    [ "${WORKBENCH_EFFECT_WINDOWS_PATH:-0}" != 1 ] || part_blocked windows-path "$1"
    exit 0
}

# What the probe says when Windows could not be asked: one "could not check"
# line per effect this script carries, never a change and never "nothing to
# change".
unchecked() {
    for effect in windows-files wsl-preferences default-distro windows-path; do
        echo "$effect: ? $1"
    done
    exit 0
}

command -v cmd.exe >/dev/null 2>&1 || blocked "there is no Windows interop on this host"

WSL_MEMORY={{ .wsl_memory | replace "'" "'\"'\"'" | printf "'%s'" }}
WSL_PROCESSORS={{ .wsl_processors | toString | replace "'" "'\"'\"'" | printf "'%s'" }}
WSL_SWAP={{ .wsl_swap | replace "'" "'\"'\"'" | printf "'%s'" }}

# Every Windows variable in one call. "|" cannot be part of a Windows path, and
# a call that fails leaves them empty, which is reported below. /d skips the
# Command Processor AutoRun command a machine may set, whose output would land
# in the answer. The installed
# distributions, for the writer record, are asked in the same breath, and so are,
# by the probe, the user PATH; a probe has 15 s and the calls do not depend on
# each other. The default distribution is listed first by `wsl --list`, so it
# is the first line of the quiet listing.
win_start variables cmd.exe /d /c 'echo %USERNAME%^|%USERPROFILE%^|%APPDATA%^|%PROGRAMFILES%^|%PROCESSOR_ARCHITECTURE%^|%LOCALAPPDATA%^|%PROGRAMDATA%'
win_start distros wsl.exe --list --quiet
if [ "${WORKBENCH_PROBE:-}" = 1 ]; then
    win_start user-path powershell.exe -NoProfile -Command '
        $want = @("$env:USERPROFILE\bin", "$env:USERPROFILE\.local\bin")
        $have = @([Environment]::GetEnvironmentVariable("Path", "User") -split ";")
        $want | Where-Object { $have -notcontains $_ } | ForEach-Object { "%USERPROFILE%" + $_.Substring($env:USERPROFILE.Length) }
    '
fi
win_wait

mapfile -d '|' -t fields < <(printf '%s' "${WIN_OUT[variables]:-}")
WIN_USER=${fields[0]:-} WIN_HOME_W=${fields[1]:-} WIN_ROAMING_W=${fields[2]:-} WIN_PROGRAMFILES_W=${fields[3]:-} WIN_ARCH=${fields[4]:-} WIN_LOCAL_W=${fields[5]:-} WIN_PROGRAMDATA_W=${fields[6]:-}
if [ -z "$WIN_HOME_W" ] || [ -z "$WIN_ROAMING_W" ]; then
    if [ "${WORKBENCH_PROBE:-}" = 1 ]; then
        unchecked "$(win_unanswered variables || echo "Couldn't check the Windows side")"
    fi
    blocked "Windows didn't report its home or AppData folder"
fi
[ "$WIN_ARCH" = AMD64 ] || blocked "Windows on x64 is required"
WIN_HOME=$(wslpath -u "$WIN_HOME_W")
WIN_ROAMING=$(wslpath -u "$WIN_ROAMING_W")
WIN_PROGRAMFILES=
[ -z "$WIN_PROGRAMFILES_W" ] || WIN_PROGRAMFILES=$(wslpath -u "$WIN_PROGRAMFILES_W")
[[ -d "$WIN_HOME" && -d "$WIN_ROAMING" ]] || blocked "the Windows home or AppData folder is unavailable"
# Without the local app data folder there is no record path, which writer_line
# reports as a record it couldn't read.
WIN_LOCAL="" WIN_PROGRAMDATA="" WRITERS=""
[ -z "$WIN_LOCAL_W" ] || WIN_LOCAL=$(wslpath -u "$WIN_LOCAL_W") || WIN_LOCAL=
[ -z "$WIN_PROGRAMDATA_W" ] || WIN_PROGRAMDATA=$(wslpath -u "$WIN_PROGRAMDATA_W") || WIN_PROGRAMDATA=
[ -z "$WIN_LOCAL" ] || WRITERS="$WIN_LOCAL/Workbench/writers.json"
# Without the local app data folder there is no Windows Terminal to find, which
# the default distribution's Terminal part says.
terminal_paths "$WIN_LOCAL" "$WIN_PROGRAMDATA"
INSTALLED=
[ "${WIN_RC[distros]:-}" != 0 ] || INSTALLED=${WIN_OUT[distros]:-}

# Merge a key=value into a specific INI section, preserving all other content.
# WSL reads section and key names case-insensitively, so an existing line is
# matched that way too; otherwise a hand-written `networkingmode=` would be
# kept beside a new `networkingMode=`, and WSL would take whichever came last.
# Usage: merge_ini_key <file> <section> <key> <value>
merge_ini_key() {
    local file="$1" section="$2" key="$3" value="$4"

    if ! grep -qi "^\[${section}\]" "$file" 2>/dev/null; then
        printf '\n[%s]\n%s=%s\n' "$section" "$key" "$value" >> "$file"
        return
    fi

    awk -v section="[$section]" -v key="$key" -v value="$value" '
        BEGIN { found = 0; in_section = 0; inserted = 0; lkey = tolower(key) }
        /^\[/ {
            if (in_section && !found && !inserted) {
                print key "=" value
                inserted = 1
            }
            in_section = (tolower($0) == tolower(section))
        }
        in_section && tolower($0) ~ "^" lkey "[[:space:]]*=" {
            # A line that already says the value stays as written: rewriting only
            # its spacing would be a change with nothing to show for it.
            current = $0
            sub(/^[^=]*=[[:space:]]*/, "", current)
            sub(/[[:space:]]+$/, "", current)
            if (current == value) { print } else { print key "=" value }
            found = 1
            next
        }
        { print }
        END {
            if (in_section && !found && !inserted) {
                print key "=" value
            }
        }
    ' "$file" > "${file}.tmp" && cat "${file}.tmp" > "$file" && rm -f "${file}.tmp"
}

MANAGED_KEYS=(
    "wsl2|memory|$WSL_MEMORY"
    "wsl2|swap|$WSL_SWAP"
    "wsl2|processors|$WSL_PROCESSORS"
    "wsl2|networkingMode|mirrored"
    "wsl2|vmIdleTimeout|300000"
    "experimental|autoMemoryReclaim|gradual"
    "experimental|sparseVhd|true"
)

# The managed keys merged into the CRLF-normalized copy of an existing
# .wslconfig, written to the file $2. Everything else is kept. The probe and the
# apply both use it, so the probe says "nothing to change" exactly when the
# merge changes nothing.
# Usage: wslconfig_merged <normalized copy> <output file>
wslconfig_merged() {
    local entry section key value
    cat "$1" > "$2"
    for entry in "${MANAGED_KEYS[@]}"; do
        section=${entry%%|*} key=${entry#*|}
        value=${key#*|} key=${key%%|*}
        merge_ini_key "$2" "$section" "$key" "$value"
    done
    # Keys an earlier version wrote under [wsl2] that WSL 2.6 rejects
    # ("Unknown key 'wsl2.pageReporting'"): delete them from that section only.
    awk '
        /^\[/ { insec = ($0 == "[wsl2]") }
        insec && ($0 ~ /^pageReporting=/ || $0 ~ /^autoMemoryReclaim=/) { next }
        { print }
    ' "$2" > "$2.tmp" && cat "$2.tmp" > "$2" && rm -f "$2.tmp"
}

# What the default distribution's Windows Terminal part finds, in TD_STATE, the
# same for the probe and the apply:
#   change   new tabs open another profile, and Terminal has more than one WSL
#            profile to choose from; $win_work/terminal-default.json is
#            settings.json with this distribution's profile as defaultProfile,
#            the only change, and $win_work/terminal-settings.json the file it
#            was made from
#   set      new tabs already open this distribution's profile
#   one      one real distribution, or Terminal has one WSL profile or none:
#            nothing to choose, so its default (PowerShell, say) stays;
#            TD_WHY says which
#   none     there is nothing to set; TD_WHY says why
#   unknown  it could not be checked; TD_WHY says why
# The settings file and Terminal's profiles are read under the cap, side by
# side, and the copy is what the filter reads (workbench terminal-default,
# which leaves comments and layout as they are). The copies live in the
# Windows calls' own folder, which goes when the script ends. A list of the
# installed distributions that did not come is no count of them: the step is
# then unchecked, never "one distribution".
terminal_default_check() {
    local real settings="$WT_SETTINGS_DIR/settings.json"
    TD_STATE=none TD_WHY=""
    real=$(grep -cv '^docker-desktop' <<<"$INSTALLED") || real=0
    if [ -z "${WSL_DISTRO_NAME:-}" ]; then
        TD_STATE=unknown TD_WHY="WSL_DISTRO_NAME is not set, so this distribution's Windows Terminal profile is unknown"
    elif [ "${WIN_RC[distros]:-}" != 0 ]; then
        TD_STATE=unknown TD_WHY="wsl.exe didn't list the installed distributions ($(win_failed distros))"
    elif [ -z "$INSTALLED" ]; then
        TD_STATE=unknown TD_WHY="wsl.exe listed no installed distributions"
    elif [ "$real" -le 1 ]; then
        TD_STATE=one TD_WHY="$WSL_DISTRO_NAME is your only distribution"
    elif [ -z "$WT_PACKAGE_DIR" ] || [ ! -d "$WT_PACKAGE_DIR" ]; then
        TD_WHY="Windows Terminal isn't installed"
    elif [ ! -f "$settings" ]; then
        TD_WHY="Windows Terminal has no settings.json yet"
    elif [ -L "$settings" ]; then
        # Replacing it would turn the link into a plain file.
        TD_STATE=unknown TD_WHY="Windows Terminal's settings.json is a symbolic link, which this step does not replace"
    else
        terminal_profile_start "$WSL_DISTRO_NAME"
        terminal_settings_start "$win_work/terminal-settings.json"
        win_wait
        if ! terminal_profile_read; then
            TD_STATE=unknown TD_WHY="Windows Terminal's profiles couldn't be read ($(win_failed terminal-profile))"
        elif [ "${WIN_RC[terminal-read]}" != 0 ]; then
            TD_STATE=unknown TD_WHY="Windows Terminal's settings.json couldn't be read ($(win_failed terminal-read))"
        elif [ "$WT_PROFILE_MISSING" = none ]; then
            TD_WHY="Windows Terminal has no profile for $WSL_DISTRO_NAME"
        elif [ -n "$WT_PROFILE_MISSING" ]; then
            TD_WHY="couldn't find this distribution's Windows Terminal profile: $WT_PROFILE_MISSING"
        elif [ "$WT_WSL_PROFILES" -le 1 ]; then
            TD_STATE=one TD_WHY="Windows Terminal has no other WSL profile to choose"
        elif ! command -v workbench >/dev/null 2>&1; then
            TD_STATE=unknown TD_WHY="workbench is not on PATH, so Windows Terminal's settings.json couldn't be checked"
        elif ! TD_WHY=$(workbench terminal-default -- "$WT_PROFILE_GUID" "$WT_PROFILE_NAME" \
            <"$win_work/terminal-settings.json" 2>&1 >"$win_work/terminal-default.json"); then
            TD_STATE=unknown TD_WHY="Windows Terminal's settings.json can't be edited: ${TD_WHY#*: }"
        elif cmp -s "$win_work/terminal-settings.json" "$win_work/terminal-default.json"; then
            TD_STATE="set"
        else
            TD_STATE=change
        fi
    fi
}

if [ "${WORKBENCH_PROBE:-}" = 1 ]; then
    WSLCONFIG="$WIN_HOME/.wslconfig"
    # A file another distribution writes is that distribution's: the writer
    # line alone stands for it.
    writer=$(writer_line wsl-preferences "$WRITERS" "$INSTALLED" "${WSL_DISTRO_NAME:-}")
    [ -z "$writer" ] || echo "$writer"
    if [[ $writer == "wsl-preferences: = "* ]]; then
        :
    elif [[ ! -f "$WSLCONFIG" ]]; then
        echo "wsl-preferences: create .wslconfig with your sizing and mirrored networking"
    else
        probe_tmp=$(mktemp)
        sed 's/\r$//' "$WSLCONFIG" > "$probe_tmp"
        changes=()
        for entry in "wsl2|memory|$WSL_MEMORY" "wsl2|swap|$WSL_SWAP" "wsl2|processors|$WSL_PROCESSORS" \
            "wsl2|networkingMode|mirrored" "wsl2|vmIdleTimeout|300000" \
            "experimental|autoMemoryReclaim|gradual" "experimental|sparseVhd|true"; do
            IFS='|' read -r section key value <<< "$entry"
            current=$(awk -v section="[$section]" -v key="$(tr '[:upper:]' '[:lower:]' <<< "$key")" '
                /^\[/ { insec = (tolower($0) == tolower(section)) }
                insec && tolower($0) ~ "^" key "[[:space:]]*=" { sub(/^[^=]*=[[:space:]]*/, ""); sub(/[[:space:]]+$/, ""); print; exit }
            ' "$probe_tmp")
            [ "$current" = "$value" ] || changes+=("$key is ${current:-not set}, will be $value")
        done
        # Keys an earlier version wrote that WSL rejects are removed by the merge.
        if awk '/^\[/ { insec = ($0 == "[wsl2]") } insec && ($0 ~ /^pageReporting=/ || $0 ~ /^autoMemoryReclaim=/) { found = 1 } END { exit !found }' "$probe_tmp"; then
            changes+=("remove keys WSL no longer accepts")
        fi
        # The merge is the arbiter: whatever it would change counts, even when
        # every value reads as set.
        probe_merged=$(mktemp)
        if wslconfig_merged "$probe_tmp" "$probe_merged" 2>/dev/null; then
            if [ ${#changes[@]} -eq 0 ] && ! cmp -s "$probe_tmp" "$probe_merged"; then
                changes+=("rewrite the managed lines the way WSL reads them")
            fi
        else
            changes+=("update the managed settings")
        fi
        rm -f "$probe_tmp" "$probe_merged"
        if [ ${#changes[@]} -eq 0 ]; then
            echo "wsl-preferences: = .wslconfig already has your sizing and mirrored networking"
        else
            printf -v joined '%s; ' "${changes[@]}"; echo "wsl-preferences: ${joined%; }"
        fi
    fi

    # What the Windows-side pieces would do.
    RG_EXE="$WIN_HOME/bin/rg.exe"
    changes=()
    [ -f "$RG_EXE" ] || changes+=("install ripgrep for Windows")
    if [ -d "$WIN_ROAMING/Notepad++" ] || [ -d "$WIN_PROGRAMFILES/Notepad++" ]; then
        for theme in Dracula Alucard; do
            [ -f "$WIN_ROAMING/Notepad++/themes/$theme.xml" ] || { changes+=("add the Notepad++ Dracula themes"); break; }
        done
    fi
    if [ ${#changes[@]} -eq 0 ]; then
        echo "windows-files: = ripgrep and the Notepad++ themes are in place"
    else
        printf -v joined '%s; ' "${changes[@]}"; echo "windows-files: ${joined%; }"
    fi

    # The calls to Windows were made above, together, under the probe's cap; a
    # call that did not answer is said so, never read as a change.
    writer=$(writer_line default-distro "$WRITERS" "$INSTALLED" "${WSL_DISTRO_NAME:-}")
    [ -z "$writer" ] || echo "$writer"
    if [[ $writer == "default-distro: = "* ]]; then
        :
    elif why=$(win_unanswered distros); then
        echo "default-distro: ? $why"
    elif [ -z "${WIN_OUT[distros]}" ]; then
        echo "default-distro: ? Couldn't check the Windows side"
    else
        # Asked only when there is a choice to make: the step's line starts
        # "= " when wsl and new Terminal tabs already open this distribution,
        # or when nothing else could open there.
        current_default=${WIN_OUT[distros]%%$'\n'*}
        this=${WSL_DISTRO_NAME:-this distribution}
        terminal_default_check
        if [ "$current_default" != "${WSL_DISTRO_NAME:-}" ]; then
            case $TD_STATE in
            change) echo "default-distro: make $this the default for wsl and new Terminal tabs (wsl opens $current_default now)" ;;
            set) echo "default-distro: make $this the default for wsl in place of $current_default (new Terminal tabs already open it)" ;;
            *) echo "default-distro: make $this the default for wsl in place of $current_default" ;;
            esac
            [ "$TD_STATE" != unknown ] || echo "default-distro: ? $TD_WHY"
        else
            case $TD_STATE in
            change) echo "default-distro: make $this the default for new Terminal tabs (wsl already opens it)" ;;
            set) echo "default-distro: = $this already opens with wsl and in new Terminal tabs" ;;
            one)
                if [ "$TD_WHY" = "$this is your only distribution" ]; then
                    echo "default-distro: = $TD_WHY"
                else
                    echo "default-distro: = $this already opens with wsl, and $TD_WHY"
                fi
                ;;
            none) echo "default-distro: = $this already opens with wsl ($TD_WHY)" ;;
            *) echo "default-distro: ? $TD_WHY" ;;
            esac
        fi
    fi

    if why=$(win_unanswered user-path); then
        echo "windows-path: ? $why"
    else
        missing_path=$(paste -sd, - <<<"${WIN_OUT[user-path]}" | sed 's/,/ and /g')
        if [ -z "$missing_path" ]; then
            echo "windows-path: = %USERPROFILE%\\bin and %USERPROFILE%\\.local\\bin are already on your Windows PATH"
        else
            echo "windows-path: add $missing_path to your Windows PATH"
        fi
    fi
    exit 0
fi

{{ includeTemplate ".chezmoitemplates/place-file.sh" . }}

echo "==> Deploying WSL Windows configs..."
echo "    Windows user: $WIN_USER"

# ---------- .wslconfig ----------
if writer_runs wsl-preferences "${WORKBENCH_EFFECT_WSL_PREFERENCES:-1}" "$WRITERS" "$INSTALLED" "${WSL_DISTRO_NAME:-}"; then
WSLCONFIG="$WIN_HOME/.wslconfig"

if [[ ! -f "$WSLCONFIG" ]]; then
    echo "==> Creating new .wslconfig..."
    cat > "$WSLCONFIG" << EOF
[wsl2]
memory=$WSL_MEMORY
swap=$WSL_SWAP
processors=$WSL_PROCESSORS
# Keep the VM alive 5 min after the last window closes (default 60 s) so a
# brief close does not cost a cold start.
vmIdleTimeout=300000
# Mirrored networking: WSL shares the host's interfaces and localhost in both
# directions, so Windows tools (Compass, Studio 3T, browsers) reach services
# bound inside WSL/podman reliably. NAT's localhost-forwarding shim misses
# rootless-podman bindings. Requires Win11 22H2+ / WSL 2.0+.
networkingMode=mirrored

[experimental]
# Automatically reclaim cached memory (the WSL VM otherwise holds page cache
# until Windows is starved; this is what made /mnt/c writes fail under load)
autoMemoryReclaim=gradual
# Sparse VHD (the ext4.vhdx shrinks when files are deleted instead of only growing)
sparseVhd=true
EOF
    echo "    Created $WSLCONFIG"
else
    echo "==> Checking existing .wslconfig..."
    python3 - "$WSLCONFIG" <<'PY'
import configparser, sys
document = configparser.ConfigParser(interpolation=None, strict=True)
with open(sys.argv[1], encoding="utf-8-sig") as stream:
    document.read_file(stream)
PY

    TMPMERGED=$(mktemp)
    TMPORIGINAL=$(mktemp)
    trap 'rm -f "$TMPMERGED" "$TMPORIGINAL"; win_cleanup' EXIT

    # Normalize CRLF for consistent processing
    sed 's/\r$//' "$WSLCONFIG" > "$TMPORIGINAL"

    wslconfig_merged "$TMPORIGINAL" "$TMPMERGED"

    if diff -q "$TMPORIGINAL" "$TMPMERGED" > /dev/null 2>&1; then
        echo "    Already up to date."
    else
        echo "    Changes:"
        diff -u --label "current" --label "merged" \
            "$TMPORIGINAL" "$TMPMERGED" | sed 's/^/    /' || true

        backup=$(mktemp "$WSLCONFIG.before-workbench.XXXXXX")
        cp -p "$WSLCONFIG" "$backup"
        echo "    Recovery copy: $backup"
        cp "$TMPMERGED" "$WSLCONFIG"
        echo "    Merged."
    fi
fi
writer_record wsl-preferences "$WRITERS" "${WSL_DISTRO_NAME:-}" ||
    part_blocked wsl-preferences ".wslconfig is in place, but ${WRITERS:-the Windows writer record} could not record this distribution as its writer"
fi

# ---------- Default WSL distro ----------
# Docker Desktop registers its own distro and often leaves it as the default.
# A bare `wsl` then drops you into docker-desktop, and VS Code's "Reopen in WSL"
# targets it too - opening the wrong distro with none of your toolchain. When
# the default-distro effect is selected, the distro running this apply (named
# in the approved plan) becomes the default, and so does its Windows Terminal
# profile for new tabs when Terminal has another WSL profile to choose
# (terminal_default_check).
if writer_runs default-distro "${WORKBENCH_EFFECT_DEFAULT_DISTRO:-0}" "$WRITERS" "$INSTALLED" "${WSL_DISTRO_NAME:-}"; then
    if [[ -z "${WSL_DISTRO_NAME:-}" ]]; then
        part_blocked default-distro "WSL_DISTRO_NAME is not set in this session, so the distribution is unknown"
    else
        win_call default-distro wsl.exe --set-default "$WSL_DISTRO_NAME"
        # A part that cannot be done blocks the step, which runs again next
        # time, and the Terminal part waits for it: without the record,
        # another distribution's Terminal settings step would write its own
        # default over this one. So one step never reports both blocked and
        # done. Once wsl's default is set, a blocked line says so.
        if [ "${WIN_RC[default-distro]}" != 0 ]; then
            part_blocked default-distro "wsl.exe could not make $WSL_DISTRO_NAME the default: $(win_failed default-distro), so new Windows Terminal tabs were not changed either"
        else
            [ -z "${WIN_OUT[default-distro]}" ] || printf '%s\n' "${WIN_OUT[default-distro]}"
            if ! writer_record default-distro "$WRITERS" "$WSL_DISTRO_NAME"; then
                part_blocked default-distro "wsl opens $WSL_DISTRO_NAME now, but ${WRITERS:-the Windows writer record} could not record it as the distribution that sets it, so new Windows Terminal tabs were not changed"
            else
                terminal_default_check
                case $TD_STATE in
                change)
                    # The checked copy is put back only if the file is still that
                    # copy: Terminal saving it in between keeps its save, and this
                    # step runs again next time. A copy of the file is kept beside
                    # it and the new one is renamed into place whole; when that
                    # fails, neither is left behind. A link is never replaced by a
                    # plain file. A refusal says why on standard output, exit 3.
                    win_call terminal-write python3 -I -c '
import os, sys, tempfile
path, edited, checked = sys.argv[1:]
if os.path.islink(path):
    print("it is a symbolic link, which this step does not replace")
    sys.exit(3)
with open(path, "rb") as stream:
    current = stream.read()
with open(checked, "rb") as stream:
    if stream.read() != current:
        print("it changed while it was being checked; the next apply checks it again")
        sys.exit(3)
with open(edited, "rb") as stream:
    text = stream.read()
folder = os.path.dirname(path)
backup = staged = None
try:
    descriptor, backup = tempfile.mkstemp(dir=folder, prefix="settings.json.before-workbench.")
    with os.fdopen(descriptor, "wb") as stream:
        stream.write(current)
    descriptor, staged = tempfile.mkstemp(dir=folder, prefix=".settings.json.", suffix=".part")
    with os.fdopen(descriptor, "wb") as stream:
        stream.write(text)
    os.replace(staged, path)
except BaseException:
    for leftover in (staged, backup):
        if leftover and os.path.exists(leftover):
            os.unlink(leftover)
    raise
print(backup)
' "$WT_SETTINGS_DIR/settings.json" "$win_work/terminal-default.json" "$win_work/terminal-settings.json"
                    case ${WIN_RC[terminal-write]} in
                    0)
                        echo "    Recovery copy: ${WIN_OUT[terminal-write]}"
                        echo "==> New Windows Terminal tabs open $WSL_DISTRO_NAME."
                        ;;
                    3) part_blocked default-distro "wsl opens $WSL_DISTRO_NAME now, but Windows Terminal's settings.json was not changed: ${WIN_OUT[terminal-write]}" ;;
                    *) part_blocked default-distro "wsl opens $WSL_DISTRO_NAME now, but Windows Terminal's settings.json could not be changed ($(win_failed terminal-write)), so new tabs open what they did" ;;
                    esac
                    ;;
                set) echo "==> New Windows Terminal tabs already open $WSL_DISTRO_NAME." ;;
                one) echo "==> $TD_WHY, so Windows Terminal's default was left as it is." ;;
                none) echo "==> ${TD_WHY^}, so only wsl's default was set." ;;
                *) part_blocked default-distro "wsl opens $WSL_DISTRO_NAME now, but $TD_WHY, so new Windows Terminal tabs open what they did" ;;
                esac
            fi
        fi
    fi
fi

# ---------- Windows-side ripgrep ----------
# A stable rg.exe of our own in %USERPROFILE%\bin, which the windows-path step
# puts on the Windows PATH. (winget would also work, but its source cache needs
# an elevated `winget source reset` to repair when it corrupts.)
if [[ "${WORKBENCH_EFFECT_WINDOWS_FILES:-1}" == 1 ]]; then
RG_DIR="$WIN_HOME/bin"
RG_EXE="$RG_DIR/rg.exe"
RG_VERSION="15.2.0"

if [[ ! -f "$RG_EXE" ]]; then
    echo "==> Installing ripgrep $RG_VERSION for Windows..."
    mkdir -p "$RG_DIR"
    RG_TMP=$(mktemp -d)
    RG_URL="https://github.com/BurntSushi/ripgrep/releases/download/${RG_VERSION}/ripgrep-${RG_VERSION}-x86_64-pc-windows-msvc.zip"
    # A failed download blocks Windows setup and the rest goes on; rg.exe is
    # placed whole, so a stopped copy is repeated instead of skipped.
    if curl -fsSL -o "$RG_TMP/rg.zip" "$RG_URL" && unzip -o -q "$RG_TMP/rg.zip" -d "$RG_TMP" &&
        RG_FOUND=$(find "$RG_TMP" -name rg.exe -print -quit) && [ -n "$RG_FOUND" ] &&
        place_file "$RG_FOUND" "$RG_EXE"; then
        echo "    Installed $RG_EXE"
    else
        part_blocked windows-files "ripgrep $RG_VERSION for Windows could not be installed"
    fi
    rm -rf "$RG_TMP"
else
    echo "==> Windows ripgrep already present."
fi
fi

# ---------- Windows user PATH ----------
# Directories we want on the Windows *user* PATH. %USERPROFILE%\.local\bin is
# where uv installs itself and its tools on Windows; it normally lands there only
# as a side effect of running uv's installer, so a rebuilt machine would not have
# it. %USERPROFILE%\bin holds rg.exe from the block above.
#
# Uses [Environment]::SetEnvironmentVariable rather than `reg add` because the
# .NET API broadcasts WM_SETTINGCHANGE, so Explorer re-reads the environment and
# anything launched from the Start menu afterwards inherits the new PATH. Nothing
# can update an ALREADY-RUNNING process: Windows processes inherit their
# environment block from their parent and never re-read the registry. A long-lived
# shell (or a WSL session) therefore keeps the old PATH until it is restarted.
if [[ "${WORKBENCH_EFFECT_WINDOWS_PATH:-}" == 1 ]]; then
echo "==> Checking Windows user PATH..."
win_call windows-path powershell.exe -NoProfile -Command '
    $want = @("$env:USERPROFILE\bin", "$env:USERPROFILE\.local\bin")
    $cur  = [Environment]::GetEnvironmentVariable("Path","User")
    # Preserve all existing entries and ordering, including empty segments.
    $entries = @($cur -split ";")
    $added = @()
    foreach ($d in $want) {
        if ($entries -notcontains $d) { $entries += $d; $added += $d }
    }
    $new = ($entries -join ";")
    if ($new -ne $cur) {
        [Environment]::SetEnvironmentVariable("Path", $new, "User")
        if ($added.Count) { $added | ForEach-Object { Write-Output "    Added $_" } }
        else { Write-Output "    Cleaned empty PATH segments" }
        Write-Output "    NOTE: already-running processes keep the old PATH until restarted."
    } else {
        Write-Output "    Already correct."
    }
'
if [ "${WIN_RC[windows-path]}" != 0 ]; then
    part_blocked windows-path "PowerShell could not update your Windows PATH: $(win_failed windows-path)"
else
    [ -z "${WIN_OUT[windows-path]}" ] || printf '%s\n' "${WIN_OUT[windows-path]}"
fi
fi

# ---------- Notepad++ Dracula themes ----------
# Never captured by migrate.sh's Windows profile sync, so re-fetch from upstream.
# Installing the theme files only - selecting one is a GUI action.
if [[ "${WORKBENCH_EFFECT_WINDOWS_FILES:-1}" == 1 ]]; then
NPP_THEMES="$WIN_ROAMING/Notepad++/themes"
if [[ -d "$WIN_ROAMING/Notepad++" ]] || [[ -d "$WIN_PROGRAMFILES/Notepad++" ]]; then
    mkdir -p "$NPP_THEMES"
    for theme in Dracula Alucard; do
        if [[ ! -f "$NPP_THEMES/$theme.xml" ]]; then
            npp_tmp=$(mktemp)
            if curl -fsSL -o "$npp_tmp" \
                "https://raw.githubusercontent.com/dracula/notepad-plus-plus/master/generated/$theme.xml" &&
                place_file "$npp_tmp" "$NPP_THEMES/$theme.xml"; then
                echo "==> Installed Notepad++ theme: $theme"
            else
                part_blocked windows-files "the Notepad++ $theme theme could not be downloaded"
            fi
            rm -f "$npp_tmp"
        fi
    done
fi
fi

echo "==> Done."
{{ end -}}
