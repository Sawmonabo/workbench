{{ if .is_wsl -}}
#!/bin/bash
# Bootstrap script for Windows configs (runs from WSL). It carries four effects,
# and each one does everything it needs itself, so none depends on another
# having run (Workbench checks the three parts whenever windows-files is on):
#   windows-files        oh-my-posh.exe and its themes, and the JetBrains Mono fonts
#   terminal-adoption    Windows Terminal settings.json, replacing an existing
#                        one when it differs (a copy is kept); needs the fonts,
#                        installed and registered. Its defaultProfile stays as
#                        it is once a distribution writes default-distro
#                        (10-deploy-windows-configs), which owns that key
#   powershell-adoption  the PowerShell profile, replacing an existing one (a
#                        copy is kept); needs oh-my-posh
#   font-registry        the fonts in the Windows registry and loaded; needs the
#                        font files
# Only one WSL distribution writes the Terminal settings and the PowerShell
# profile: the one windows-writers.sh's record names (take-over-<effect> moves
# it).
# The plan the owner approved is the consent: nothing here asks a question.
set -euo pipefail

{{ includeTemplate ".chezmoitemplates/windows-calls.sh" . }}
{{ template "windows-writers.sh" }}
{{ template "windows-terminal.sh" }}

# Whether the apply asks for the Terminal or PowerShell part: ticked, or its
# take-over is. Which of them then runs is the writer record's (writer_runs).
asked_terminal=0 asked_profile=0
if [ "${WORKBENCH_EFFECT_TERMINAL_ADOPTION:-0}" = 1 ] || [ "${WORKBENCH_EFFECT_TAKE_OVER_TERMINAL_ADOPTION:-0}" = 1 ]; then
    asked_terminal=1
fi
if [ "${WORKBENCH_EFFECT_POWERSHELL_ADOPTION:-0}" = 1 ] || [ "${WORKBENCH_EFFECT_TAKE_OVER_POWERSHELL_ADOPTION:-0}" = 1 ]; then
    asked_profile=1
fi

# Everything the probe or the apply says about a Windows host that cannot be
# used: one line per effect, since each of them is affected. An apply names each
# effect it was asked to do as blocked, in the file Workbench reads, and ends the
# script successfully: it runs on every apply, so it tries again next time.
# Workbench ends the apply blocked after the rest has run.
blocked() {
    if [ "${WORKBENCH_PROBE:-}" = 1 ]; then
        for effect in windows-files terminal-adoption powershell-adoption font-registry; do
            echo "$effect: can't run here, $1"
        done
        exit 0
    fi
    [ "${WORKBENCH_EFFECT_WINDOWS_FILES:-1}" != 1 ] || part_blocked windows-files "$1"
    [ "$asked_terminal" != 1 ] || part_blocked terminal-adoption "$1"
    [ "$asked_profile" != 1 ] || part_blocked powershell-adoption "$1"
    [ "${WORKBENCH_EFFECT_FONT_REGISTRY:-0}" != 1 ] || part_blocked font-registry "$1"
    exit 0
}

# What the probe says when Windows could not be asked: a "could not check" line
# per effect named in the arguments after the reason, never a change and never
# "nothing to change".
unchecked() {
    local reason=$1 effect
    shift
    for effect in "$@"; do
        echo "$effect: ? $reason"
    done
}

command -v cmd.exe >/dev/null 2>&1 || blocked "there is no Windows interop on this host"

# Every Windows variable in one call. "|" cannot be part of a Windows path, and
# a call that fails leaves them empty, which is reported below. /d skips the
# Command Processor AutoRun command a machine may set, whose output would land
# in the answer. The other calls
# to Windows do not depend on it, so they are made together with it: a probe has
# 15 s in all, and Windows can be slow to answer the first call after a quiet
# spell.
#   profile   PowerShell, not %USERPROFILE%: the profile folder may be
#             redirected (OneDrive). Only the PowerShell profile part needs it,
#             so a PowerShell that does not answer is that part's problem alone:
#             the probe says it could not check on that line, and an apply that
#             selects the part stops before changing anything.
#   registry  the fonts already registered, for the font and Terminal parts
#   distros   the installed distributions, for the writer record
win_start variables cmd.exe /d /c 'echo %USERNAME%^|%USERPROFILE%^|%LOCALAPPDATA%^|%PROGRAMDATA%^|%PROCESSOR_ARCHITECTURE%'
win_start distros wsl.exe --list --quiet
if [ "${WORKBENCH_PROBE:-}" = 1 ] || [ "$asked_profile" = 1 ]; then
    win_start profile powershell.exe -NoProfile -Command '$PROFILE.CurrentUserCurrentHost'
fi
if [ "${WORKBENCH_PROBE:-}" = 1 ] || [ "${WORKBENCH_EFFECT_FONT_REGISTRY:-0}" = 1 ] || [ "$asked_terminal" = 1 ]; then
    win_start registry reg.exe query 'HKCU\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Fonts'
fi
win_wait

mapfile -d '|' -t fields < <(printf '%s' "${WIN_OUT[variables]:-}")
WIN_USER=${fields[0]:-} WIN_HOME_W=${fields[1]:-} WIN_APPDATA_W=${fields[2]:-} WIN_PROGRAMDATA_W=${fields[3]:-} WIN_ARCH=${fields[4]:-}
if [ -z "$WIN_HOME_W" ] || [ -z "$WIN_APPDATA_W" ]; then
    if [ "${WORKBENCH_PROBE:-}" = 1 ]; then
        unchecked "$(win_unanswered variables || echo "Couldn't check the Windows side")" \
            windows-files terminal-adoption powershell-adoption font-registry
        exit 0
    fi
    blocked "Windows didn't report its home or AppData folder"
fi
[ "$WIN_ARCH" = AMD64 ] || blocked "Windows on x64 is required"
WIN_HOME=$(wslpath -u "$WIN_HOME_W")
WIN_APPDATA=$(wslpath -u "$WIN_APPDATA_W")
WIN_PROGRAMDATA=
[ -z "$WIN_PROGRAMDATA_W" ] || WIN_PROGRAMDATA=$(wslpath -u "$WIN_PROGRAMDATA_W")
PS_PROFILE=""
ps_profile_problem=""
ps_why=""
if [ "${WORKBENCH_PROBE:-}" = 1 ] || [ "$asked_profile" = 1 ]; then
    PS_PROFILE_W=
    [ "${WIN_RC[profile]:-}" != 0 ] || PS_PROFILE_W=${WIN_OUT[profile]:-}
    [ -z "$PS_PROFILE_W" ] || PS_PROFILE=$(wslpath -u "$PS_PROFILE_W") || PS_PROFILE=
    if [ -z "$PS_PROFILE" ]; then
        ps_profile_problem="PowerShell didn't report where your profile is"
        ps_why=$(win_unanswered profile) || ps_why="Couldn't check the Windows side"
    fi
fi
if [[ ! -d "$WIN_HOME" || ! -d "$WIN_APPDATA" || -z "${WSL_DISTRO_NAME:-}" ]]; then
    blocked "the Windows home, AppData or WSL_DISTRO_NAME is unavailable"
fi
WRITERS="$WIN_APPDATA/Workbench/writers.json"
INSTALLED=
[ "${WIN_RC[distros]:-}" != 0 ] || INSTALLED=${WIN_OUT[distros]:-}

OMP_WIN_DIR="$WIN_APPDATA/Programs/oh-my-posh"
OMP_WIN_BIN="$OMP_WIN_DIR/bin"
OMP_WIN_THEMES="$OMP_WIN_DIR/themes"
# The theme the PowerShell profile below names. It is copied last, so finding it
# means every theme was copied; with the program it makes oh-my-posh complete.
OMP_WIN_THEME="$OMP_WIN_THEMES/catppuccin_mocha.omp.json"
WIN_FONT_DIR="$WIN_APPDATA/Microsoft/Windows/Fonts"
terminal_paths "$WIN_APPDATA" "$WIN_PROGRAMDATA"
{{- /* The folder Windows Terminal and PowerShell open in: the work folder, else the personal one. */ -}}
{{- $start := get . "personal_folder" }}
{{- if .has_work }}{{ $start = .work_folder }}{{ end }}

# The PowerShell profile Workbench manages, as text.
ps_profile_text() {
cat << 'PSPROFILE'
# Start in the WSL start folder when it is reachable (WSL may not be running yet)
$wslStart = '{{ printf "\\\\wsl.localhost\\%s\\home\\%s\\%s" (env "WSL_DISTRO_NAME") .chezmoi.username (trimPrefix "~/" $start | replace "/" "\\") | replace "'" "''" }}'
if (Test-Path -LiteralPath $wslStart) { Set-Location -LiteralPath $wslStart }

# Oh My Posh prompt
& "$env:LOCALAPPDATA\Programs\oh-my-posh\bin\oh-my-posh.exe" init pwsh --config "$env:LOCALAPPDATA\Programs\oh-my-posh\themes\catppuccin_mocha.omp.json" | Invoke-Expression
PSPROFILE
}

# Whether Terminal's defaultProfile is the default-distro step's: an installed
# distribution, this one included, is recorded as that step's writer, or the
# record or the installed list cannot be read, which is no proof nobody is or
# that the one recorded is gone. The rendered settings
# then keep the defaultProfile the file has, so writing them never undoes the
# default a distribution chose there.
default_profile_owned() {
    writer_read default-distro "$WRITERS" || return 0
    [ -n "$WRITER" ] || return 1
    [ "$WRITER" = "$WSL_DISTRO_NAME" ] || [ -z "$INSTALLED" ] || grep -qxF -- "$WRITER" <<<"$INSTALLED"
}

# The Windows Terminal settings.json Workbench manages, rendered to the file $1.
# Rendering reads the Windows Terminal files and writes nothing to them, so the
# probe and the apply use it alike and compare the result with what is there.
# The profiles and color schemes of an existing file that Workbench does not
# manage (other distributions' profiles, ones you added) are kept, after its
# own, in the file's order: Terminal makes a profile it generates only once, so
# one dropped here would not come back. A file whose lists cannot be read is
# not replaced. When it cannot render, it fails and render_why says why.
terminal_settings_render() {
    local out="$1" keep="" lists="" settings="$WT_SETTINGS_DIR/settings.json"
    render_why=""
    # Bind to the WSL profile Windows Terminal actually has for this distro
    # (windows-terminal.sh). A fragment's commandline already carries
    # "--cd ~", which overrides startingDirectory (microsoft/WSL#13346), so
    # the start folder is set by overriding commandline instead. With no
    # profile to bind to, the managed one is a standalone wsl.exe profile.
    terminal_profile_start "$WSL_DISTRO_NAME"
    win_wait
    if ! terminal_profile_read; then
        render_why="Windows Terminal's profiles couldn't be read ($(win_failed terminal-profile))"
        return 1
    fi
    if [ -f "$settings" ]; then
        # The file's lists and, while default-distro owns it, its
        # defaultProfile as JSON text, read from a copy taken under the cap.
        terminal_settings_start "$win_work/terminal-current.json"
        win_wait
        if [ "${WIN_RC[terminal-read]}" != 0 ]; then
            render_why="Windows Terminal's settings.json couldn't be read ($(win_failed terminal-read))"
            return 1
        fi
        if ! command -v workbench >/dev/null 2>&1; then
            render_why="workbench is not on PATH, so the profiles in Windows Terminal's settings.json couldn't be read"
            return 1
        fi
        lists="$win_work/terminal-lists.json"
        if ! workbench terminal-default --lists <"$win_work/terminal-current.json" >"$lists" 2>"$win_work/terminal-lists.err"; then
            render_why=$(head -n 1 "$win_work/terminal-lists.err")
            render_why=${render_why#Windows Terminal settings.json was left unchanged: }
            render_why="the profiles in Windows Terminal's settings.json couldn't be read (${render_why:-no reason given}), so they couldn't be kept"
            return 1
        fi
        if default_profile_owned; then
            keep=$(workbench terminal-default --current <"$win_work/terminal-current.json" 2>/dev/null) || keep=
        fi
    fi
    echo "    Windows Terminal WSL profile: $WT_PROFILE"
    cat > "$out" << 'WTSETTINGS' || return 1
