    if ! python3 - "$out" "$WT_PROFILE" "$WSL_DISTRO_NAME" "$keep" "$lists" <<'PY'; then
import json, subprocess, sys
path, found, distro, keep, lists = sys.argv[1:]
found = json.loads(found)
start = {{ $start | toJson }}
cmdline = subprocess.list2cmdline(["wsl.exe", "-d", distro, "--cd", start])
if found["guid"]:
    profile = {"guid": found["guid"], "source": found["source"]}
    if found["commandline"]:
        profile["commandline"] = cmdline
    else:
        profile["startingDirectory"] = start
else:
    profile = {"guid": "{ddad2f1c-79f7-5b21-a2c2-0000c6c23ae0}", "commandline": cmdline,
               "icon": "ms-appx:///ProfileIcons/{9acb9455-ca41-5af7-950f-6bca1bc9722f}.png"}
# The keys after guid, as pre-indented JSON lines.
extra = "\n".join("                %s: %s," % (json.dumps(k), json.dumps(v)) for k, v in profile.items() if k != "guid")
s = open(path, encoding="utf-8").read()
s = s.replace('"__WSL_DEFAULT_PROFILE__"', keep or json.dumps(profile["guid"]))
s = s.replace("__WSL_PROFILE_GUID__", profile["guid"]).replace("__WSL_PROFILE_EXTRA__", extra)
s = s.replace('"__WSL_DISTRO_NAME__"', json.dumps(distro))
managed = json.loads(s)  # fail loudly rather than hand WT a broken file
# Keep the existing file's profiles and color schemes that these settings do
# not have, after their own. A profile is matched by its guid (or, without
# one, its name). This distribution's other WSL entries go too: the
# standalone profile this script writes when it finds none to bind to (every
# distribution's has the same guid, so only one that starts this distribution
# is its own), and an older generated one beside the profile it binds to.
have = json.load(open(lists, encoding="utf-8")) if lists else {"profiles": [], "schemes": []}
own = managed["profiles"]["list"]
guids = {p["guid"].lower() for p in own}
names = {p["name"] for p in own}
standalone = "{ddad2f1c-79f7-5b21-a2c2-0000c6c23ae0}"
def ours(p):
    if not isinstance(p, dict):
        return False
    guid = p.get("guid")
    if not isinstance(guid, str):
        return p.get("name") in names
    if guid.lower() in guids:
        return True
    if guid.lower() == standalone:
        command = p.get("commandline")
        words = command.split() if isinstance(command, str) else []
        return p.get("name") == distro or any(a == "-d" and b == distro for a, b in zip(words, words[1:]))
    return p.get("name") == distro and p.get("source") in ("Microsoft.WSL", "Windows.Terminal.Wsl")
schemes = {c["name"] for c in managed["schemes"]}
kept = {
    "profiles": [p for p in have["profiles"] if not ours(p)],
    "schemes": [c for c in have["schemes"] if not (isinstance(c, dict) and c.get("name") in schemes)],
}
def entries(items, indent):
    pad = " " * indent
    return "".join(",\n" + pad + json.dumps(i, indent=4, ensure_ascii=False).replace("\n", "\n" + pad) for i in items)
for anchor, key, indent in (('\n        ]\n    },\n    "schemes":', "profiles", 12), ('\n    ],\n    "theme":', "schemes", 8)):
    assert s.count(anchor) == 1, anchor
    s = s.replace(anchor, entries(kept[key], indent) + anchor)
json.loads(s)
open(path, "w", encoding="utf-8").write(s)
PY
        render_why="the managed settings could not be rendered"
        return 1
    fi
}

# Whether any JetBrainsMono font file is in the Windows user font folder.
have_fonts() { compgen -G "$WIN_FONT_DIR/JetBrainsMono*.ttf" >/dev/null; }

# Whether the whole Nerd Font family is in place. The regular face is copied
# last, so finding it means every file before it was copied; a download or copy
# that stopped halfway leaves some files and not this one, and runs again.
FONT_LAST="JetBrainsMonoNerdFont-Regular.ttf"
fonts_complete() { [ -f "$WIN_FONT_DIR/$FONT_LAST" ]; }

# Whether oh-my-posh is in place for Windows: the program and the profile's theme.
omp_complete() { [ -f "$OMP_WIN_BIN/oh-my-posh.exe" ] && [ -f "$OMP_WIN_THEME" ]; }

# Whether every JetBrainsMono font file is registered for the Windows user with
# its real Windows path, from the registry read above. Succeeds when they all
# are, returns 1 when one is not and 2 when the registry could not be read, which
# the probe says apart from "not registered". An apply treats both as "register
# them again", which is harmless.
fonts_registered() {
    local dir_w font base line
    have_fonts || return 1
    [ "${WIN_RC[registry]:-}" = 0 ] || return 2
    dir_w=$(wslpath -w "$WIN_FONT_DIR") || return 2
    for font in "$WIN_FONT_DIR"/JetBrainsMono*.ttf; do
        base=$(basename "$font" .ttf)
        line=$(grep -F -- "$base (TrueType)" <<<"${WIN_OUT[registry]}") || return 1
        grep -qiF -- "$dir_w\\$(basename "$font")" <<<"$line" || return 1
    done
}

if [ "${WORKBENCH_PROBE:-}" = 1 ]; then
    fonts_have=0 fonts_reg=0 omp_have=0 reg_why=
    fonts_complete && fonts_have=1
    fonts_state=0
    fonts_registered || fonts_state=$?
    [ "$fonts_state" != 0 ] || fonts_reg=1
    # With the fonts in place, a registry that could not be read leaves their
    # registration unchecked, which is not the same as "not registered".
    if [ "$fonts_have" = 1 ] && [ "$fonts_state" = 2 ]; then
        reg_why=$(win_unanswered registry) || reg_why="Couldn't check the Windows side"
    fi
    omp_complete && omp_have=1
    changes=()
    [ "$omp_have" = 1 ] || changes+=("install oh-my-posh and its themes")
    [ "$fonts_have" = 1 ] || changes+=("install the JetBrainsMono fonts")
    if [ ${#changes[@]} -eq 0 ]; then
        echo "windows-files: = oh-my-posh and the JetBrainsMono fonts are installed"
    else
        printf -v joined '%s; ' "${changes[@]}"; echo "windows-files: ${joined%; }"
    fi
    # The Terminal settings are rendered and compared with the file, so the
    # probe says "nothing to change" exactly when the apply would write nothing.
    needs=
    if [ "$fonts_have" != 1 ]; then
        needs="install and register the JetBrainsMono fonts it uses"
    elif [ "$fonts_reg" != 1 ]; then
        needs="register the JetBrainsMono fonts it uses"
    fi
    # A file another distribution writes is that distribution's: the writer
    # line alone stands for it.
    writer=$(writer_line terminal-adoption "$WRITERS" "$INSTALLED" "$WSL_DISTRO_NAME")
    [ -z "$writer" ] || echo "$writer"
    if [[ $writer == "terminal-adoption: = "* ]]; then
        :
    elif [ ! -d "$WT_PACKAGE_DIR" ]; then
        echo "terminal-adoption: = Windows Terminal isn't installed, so there is nothing to replace"
    elif [ -n "$reg_why" ]; then
        echo "terminal-adoption: ? $reg_why"
    else
        terminal_tmp=$(mktemp)
        same=0 render_why=""
        if [ -f "$WT_SETTINGS_DIR/settings.json" ] && terminal_settings_render "$terminal_tmp" >/dev/null 2>&1 &&
            cmp -s "$terminal_tmp" "$WT_SETTINGS_DIR/settings.json"; then
            same=1
        fi
        rm -f "$terminal_tmp"
        if [ -n "$render_why" ]; then
            echo "terminal-adoption: ? $render_why"
        elif [ "$same" = 1 ] && [ -z "$needs" ]; then
            echo "terminal-adoption: = your Windows Terminal settings already match and its fonts are registered"
        elif [ "$same" = 1 ]; then
            echo "terminal-adoption: $needs"
        elif [ -e "$WT_SETTINGS_DIR/settings.json" ]; then
            echo "terminal-adoption: replace your Windows Terminal settings.json (a copy of yours is kept)${needs:+; $needs}"
        else
            echo "terminal-adoption: write Windows Terminal settings.json, which doesn't exist yet${needs:+; $needs}"
        fi
    fi
    needs=
    [ "$omp_have" = 1 ] || needs="install oh-my-posh, which the profile starts"
    writer=$(writer_line powershell-adoption "$WRITERS" "$INSTALLED" "$WSL_DISTRO_NAME")
    [ -z "$writer" ] || echo "$writer"
    if [[ $writer == "powershell-adoption: = "* ]]; then
        :
    elif [ -n "$ps_profile_problem" ]; then
        echo "powershell-adoption: ? $ps_why"
    elif [ -e "$PS_PROFILE" ] && ps_profile_text | cmp -s - "$PS_PROFILE"; then
        if [ -z "$needs" ]; then
            echo "powershell-adoption: = your PowerShell profile already matches"
        else
            echo "powershell-adoption: $needs"
        fi
    elif [ -e "$PS_PROFILE" ]; then
        echo "powershell-adoption: replace your PowerShell profile (a copy is kept)${needs:+; $needs}"
    else
        echo "powershell-adoption: write your PowerShell profile, which doesn't exist yet${needs:+; $needs}"
    fi
    if [ "$fonts_have" != 1 ]; then
        echo "font-registry: install the JetBrainsMono fonts, then register them for your Windows user"
    elif [ -n "$reg_why" ]; then
        echo "font-registry: ? $reg_why"
    elif [ "$fonts_reg" = 1 ]; then
        echo "font-registry: = the JetBrainsMono fonts are already registered for your Windows user"
    else
        echo "font-registry: register the JetBrainsMono fonts for your Windows user and load them now"
    fi
    exit 0
fi

{{ includeTemplate ".chezmoitemplates/place-file.sh" . }}

# What each effect asks for. Unset means "not selected" for the parts, and
# windows-files defaults to on when the script is run directly. A ticked
# take-over runs its part; a part another installed distribution writes is left
# to it.
files=${WORKBENCH_EFFECT_WINDOWS_FILES:-1}
adopt_terminal=0
if writer_runs terminal-adoption "${WORKBENCH_EFFECT_TERMINAL_ADOPTION:-0}" "$WRITERS" "$INSTALLED" "$WSL_DISTRO_NAME"; then
    adopt_terminal=1
fi
adopt_profile=0
if writer_runs powershell-adoption "${WORKBENCH_EFFECT_POWERSHELL_ADOPTION:-0}" "$WRITERS" "$INSTALLED" "$WSL_DISTRO_NAME"; then
    adopt_profile=1
fi
register_fonts=${WORKBENCH_EFFECT_FONT_REGISTRY:-0}
if [ "$files" != 1 ] && [ "$adopt_terminal" != 1 ] && [ "$adopt_profile" != 1 ] && [ "$register_fonts" != 1 ]; then
    echo "==> No Windows part selected; Windows bootstrap skipped." >&2
    exit 0
fi
# The Terminal settings and the PowerShell profile are written by their own
# parts only.
manage_terminal=0
if [ "$adopt_terminal" = 1 ]; then manage_terminal=1; fi
manage_profile=0
if [ "$adopt_profile" = 1 ]; then manage_profile=1; fi
# A selected PowerShell profile part with no profile path to write is blocked,
# and only that part: the others go on, and the part is named blocked on its
# result line.
if [ "$manage_profile" = 1 ] && [ -n "$ps_profile_problem" ]; then
    if [ "${WIN_RC[profile]:-}" = 0 ]; then ps_apply_why="Windows gave an empty answer"; else ps_apply_why=$(win_failed profile); fi
    part_blocked powershell-adoption "$ps_profile_problem ($ps_apply_why); your profile was not changed"
    manage_profile=0
fi
# What each piece needs of the shared downloads.
need_omp=0
if [ "$files" = 1 ] || [ "$manage_profile" = 1 ]; then need_omp=1; fi
# The Terminal settings use the font, so that part registers it too.
register_now=0
if [ "$register_fonts" = 1 ] || { [ "$manage_terminal" = 1 ] && [ -d "$WT_PACKAGE_DIR" ]; }; then register_now=1; fi
need_fonts=0
if [ "$files" = 1 ] || [ "$register_fonts" = 1 ] || [ "$manage_terminal" = 1 ]; then need_fonts=1; fi

echo "==> WSL → Windows bootstrap starting..."

download_dir=$(mktemp -d)
trap 'rm -rf "$download_dir"; win_cleanup' EXIT

echo "    Windows user: $WIN_USER"

# The downloads below fail only the steps that need them: this is a run_before_
# script, so exiting would stop the whole apply, files included. Each install
# prints why it failed and returns 1, leaving what was there.

# --- oh-my-posh for Windows ---
# Downloaded and unpacked in a private folder first, then copied into place with
# the program renamed in last, so a download or copy that stops halfway never
# leaves a partial program the next run would skip. An install that is missing
# its theme, or whose program does not start (a download cut off by an earlier
# version of this script), is done again.
install_omp() {
    local url theme item
    theme=$(basename "$OMP_WIN_THEME")
    mkdir -p "$download_dir/omp" || { echo "a private download folder could not be made"; return 1; }
    url=$(curl -fsSL https://api.github.com/repos/JanDeDobbeleer/oh-my-posh/releases/latest \
        | grep -o '"browser_download_url": *"[^"]*posh-windows-amd64.exe"' \
        | head -1 \
        | cut -d'"' -f4) || true
    [ -n "$url" ] || { echo "GitHub did not name its download"; return 1; }
    curl -fsSL "$url" -o "$download_dir/omp/oh-my-posh.exe" || { echo "the program download failed"; return 1; }
    curl -fsSL https://github.com/JanDeDobbeleer/oh-my-posh/releases/latest/download/themes.zip \
        -o "$download_dir/omp/themes.zip" || { echo "the theme download failed"; return 1; }
    unzip -oq "$download_dir/omp/themes.zip" -d "$download_dir/omp/themes" ||
        { echo "the theme archive could not be unpacked"; return 1; }
    [ -f "$download_dir/omp/themes/$theme" ] || { echo "the theme archive has no $theme"; return 1; }
    # Both downloads are whole: now copy them into place.
    mkdir -p "$OMP_WIN_BIN" "$OMP_WIN_THEMES" || { echo "its Windows folders could not be made"; return 1; }
    for item in "$download_dir/omp/themes/"*; do
        [ "$(basename "$item")" = "$theme" ] || cp -R "$item" "$OMP_WIN_THEMES/" ||
            { echo "the themes could not be copied"; return 1; }
    done
    place_file "$download_dir/omp/themes/$theme" "$OMP_WIN_THEME" &&
        place_file "$download_dir/omp/oh-my-posh.exe" "$OMP_WIN_BIN/oh-my-posh.exe" ||
        { echo "the program could not be copied"; return 1; }
}
if [ "$need_omp" = 1 ]; then
omp_ready=0
if omp_complete; then
    win_call omp-check "$OMP_WIN_BIN/oh-my-posh.exe" --version
    # A Windows that does not answer in time is no proof the program is broken.
    case "${WIN_RC[omp-check]:-1}" in 0 | 124 | 137) omp_ready=1 ;; esac
fi
if [ "$omp_ready" = 1 ]; then
    echo "==> oh-my-posh for Windows already installed, skipping."
else
    echo "==> Installing oh-my-posh for Windows..."
    if omp_why=$(install_omp); then
        echo "    oh-my-posh and its themes installed for Windows."
    else
        omp_why="oh-my-posh could not be installed for Windows: $omp_why"
        [ "$files" != 1 ] || part_blocked windows-files "$omp_why"
        if [ "$manage_profile" = 1 ]; then
            part_blocked powershell-adoption "$omp_why, so your PowerShell profile was not changed"
            manage_profile=0
        fi
    fi
fi
fi

# --- JetBrains Mono Nerd Font for Windows ---
# Unpacked in a private folder first and copied into place file by file with the
# regular face last (see fonts_complete), so a failed download or copy is done
# again by the next run instead of being skipped for the files that did arrive.
install_fonts() {
    local url font
    url=$(curl -fsSL https://api.github.com/repos/ryanoasis/nerd-fonts/releases/latest \
        | grep -o '"browser_download_url": *"[^"]*JetBrainsMono[^"]*\.zip"' \
        | head -1 \
        | cut -d'"' -f4) || true
    [ -n "$url" ] || { echo "GitHub did not name their download"; return 1; }
    curl -fsSL "$url" -o "$download_dir/font.zip" || { echo "the download failed"; return 1; }
    unzip -oq "$download_dir/font.zip" -d "$download_dir/fonts" ||
        { echo "the archive could not be unpacked"; return 1; }
    [ -f "$download_dir/fonts/$FONT_LAST" ] || { echo "the archive has no $FONT_LAST"; return 1; }
    mkdir -p "$WIN_FONT_DIR" || { echo "the Windows font folder could not be made"; return 1; }
    for font in "$download_dir/fonts/"*.ttf; do
        [ "$(basename "$font")" = "$FONT_LAST" ] || place_file "$font" "$WIN_FONT_DIR/$(basename "$font")" ||
            { echo "the font files could not be copied"; return 1; }
    done
    place_file "$download_dir/fonts/$FONT_LAST" "$WIN_FONT_DIR/$FONT_LAST" ||
        { echo "the font files could not be copied"; return 1; }
}
if [ "$need_fonts" = 1 ]; then
if fonts_complete; then
    echo "==> JetBrains Mono Nerd Font for Windows already present, skipping download."
else
    echo "==> Installing JetBrains Mono Nerd Font for Windows..."
    if fonts_why=$(install_fonts); then
        echo "    JetBrains Mono Nerd Font installed for Windows."
    else
        # Nothing is registered and the Terminal settings, which name the font,
        # are not written.
        fonts_why="the JetBrainsMono fonts could not be installed for Windows: $fonts_why"
        [ "$files" != 1 ] || part_blocked windows-files "$fonts_why"
        if [ "$register_fonts" = 1 ]; then part_blocked font-registry "$fonts_why"; fi
        if [ "$manage_terminal" = 1 ]; then
            part_blocked terminal-adoption "$fonts_why, so your Windows Terminal settings were not changed"
            manage_terminal=0
        fi
        register_now=0
    fi
fi
fi

# Register every font file in one PowerShell call, unless every file is already
# registered with its real Windows path. A wrong entry is repaired by running it
# again: an earlier version wrote /mnt/c/... paths into the registry, which
# Windows cannot resolve, so Windows Terminal reported "Unable to find the
# following fonts".
if [[ "$register_now" == 1 ]] && have_fonts && fonts_registered; then
    echo "==> JetBrains Mono Nerd Font already registered for your Windows user."
elif [[ "$register_now" == 1 ]] && have_fonts; then
    echo "    Registering fonts in Windows registry..."
    WIN_FONT_DIR_W=$(wslpath -w "$WIN_FONT_DIR")
    WIN_FONT_DIR_W=${WIN_FONT_DIR_W//\'/\'\'}
    win_call register powershell.exe -NoProfile -Command "
        \$key = 'HKCU:\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Fonts'
        Get-ChildItem -LiteralPath '$WIN_FONT_DIR_W' -Filter 'JetBrainsMono*.ttf' | ForEach-Object {
            New-ItemProperty -Path \$key -Name (\$_.BaseName + ' (TrueType)') -Value \$_.FullName -PropertyType String -Force | Out-Null
        }
        # Registry alone is not enough for already-running apps: load the font
        # resources into the session and broadcast WM_FONTCHANGE, which is what
        # the Fonts control panel does. Without it Windows Terminal keeps saying
        # 'Unable to find the following fonts' until the user signs out.
        Add-Type -Namespace Win32 -Name Fonts -MemberDefinition @'
            [DllImport(\"gdi32.dll\", CharSet = CharSet.Unicode)] public static extern int AddFontResource(string lpFileName);
            [DllImport(\"user32.dll\")] public static extern IntPtr SendMessageTimeout(IntPtr hWnd, uint Msg, IntPtr wParam, IntPtr lParam, uint fuFlags, uint uTimeout, out IntPtr lpdwResult);
'@
        Get-ChildItem -LiteralPath '$WIN_FONT_DIR_W' -Filter 'JetBrainsMono*.ttf' | ForEach-Object { [void][Win32.Fonts]::AddFontResource(\$_.FullName) }
        \$r = [IntPtr]::Zero
        [void][Win32.Fonts]::SendMessageTimeout([IntPtr]0xffff, 0x001D, [IntPtr]::Zero, [IntPtr]::Zero, 2, 1000, [ref]\$r)
        (Get-ChildItem -LiteralPath '$WIN_FONT_DIR_W' -Filter 'JetBrainsMono*.ttf').Count
    "
    if [ "${WIN_RC[register]}" = 0 ]; then
        sed 's/^/    registered fonts: /' <<<"${WIN_OUT[register]}"
        echo "    (restart Windows Terminal; sign out/in only if a font still shows as missing)"
    else
        # Only the parts that need the fonts registered are blocked; the Terminal
        # settings are not written, since they would name fonts Windows cannot
        # find.
        fonts_why="PowerShell could not register the fonts: $(win_failed register)"
        if [ "$register_fonts" = 1 ]; then part_blocked font-registry "$fonts_why"; fi
        if [ "$manage_terminal" = 1 ]; then
            part_blocked terminal-adoption "$fonts_why, so your Windows Terminal settings were not changed"
            manage_terminal=0
        fi
    fi
fi

# --- Windows Terminal settings.json ---
if [ "$manage_terminal" = 1 ] && [ -d "$WT_PACKAGE_DIR" ]; then
    echo "==> Checking Windows Terminal settings..."
    mkdir -p "$WT_SETTINGS_DIR"
    if ! terminal_settings_render "$download_dir/terminal.json"; then
        part_blocked terminal-adoption "${render_why:-the managed settings could not be rendered}, so your Windows Terminal settings were not changed"
    else
        if [ -f "$WT_SETTINGS_DIR/settings.json" ] && cmp -s "$download_dir/terminal.json" "$WT_SETTINGS_DIR/settings.json"; then
            echo "==> Windows Terminal settings already up to date."
        else
            if [ -f "$WT_SETTINGS_DIR/settings.json" ]; then
                terminal_backup=$(mktemp "$WT_SETTINGS_DIR/settings.json.before-workbench.XXXXXX")
                cp -p "$WT_SETTINGS_DIR/settings.json" "$terminal_backup"
                echo "    Recovery copy: $terminal_backup"
            fi
            cp "$download_dir/terminal.json" "$WT_SETTINGS_DIR/settings.json"
            echo "    Windows Terminal settings written."
        fi
        writer_record terminal-adoption "$WRITERS" "$WSL_DISTRO_NAME" ||
            part_blocked terminal-adoption "the settings are in place, but $WRITERS could not record this distribution as their writer"
    fi
elif [ "$manage_terminal" = 1 ]; then
    echo "==> Windows Terminal not found, skipping settings."
fi

# --- PowerShell profile ---
if [ "$manage_profile" = 1 ]; then
PS_PROFILE_DIR=$(dirname "$PS_PROFILE")
if [ -f "$PS_PROFILE" ] && ps_profile_text | cmp -s - "$PS_PROFILE"; then
    echo "==> PowerShell profile already up to date."
else
    echo "==> Writing PowerShell profile..."
    mkdir -p "$PS_PROFILE_DIR"
    if [ -f "$PS_PROFILE" ]; then
        profile_backup=$(mktemp "$PS_PROFILE.before-workbench.XXXXXX")
        cp -p "$PS_PROFILE" "$profile_backup"
        echo "    Recovery copy: $profile_backup"
    fi
    ps_profile_text > "$PS_PROFILE"
    echo "    PowerShell profile written."
fi
writer_record powershell-adoption "$WRITERS" "$WSL_DISTRO_NAME" ||
    part_blocked powershell-adoption "the profile is in place, but $WRITERS could not record this distribution as its writer"
fi

echo "==> WSL → Windows bootstrap complete."
echo "    NOTE: Restart Windows Terminal to see changes."
{{ end -}}
