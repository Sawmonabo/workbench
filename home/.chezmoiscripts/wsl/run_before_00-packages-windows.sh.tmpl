            },
            {
                "guid": "__WSL_PROFILE_GUID__",
__WSL_PROFILE_EXTRA__
                "hidden": false,
                "name": "__WSL_DISTRO_NAME__",
                "tabColor": "#FAB387"
            }
        ]
    },
    "schemes":
    [
        {
            "background": "#1E1E2E",
            "black": "#45475A",
            "blue": "#89B4FA",
            "brightBlack": "#585B70",
            "brightBlue": "#89B4FA",
            "brightCyan": "#94E2D5",
            "brightGreen": "#A6E3A1",
            "brightPurple": "#F5C2E7",
