{{ if eq .chezmoi.os "linux" -}}
#!/bin/bash
# Install GLOBAL command-line tools from .chezmoidata/versions.toml.
# Re-runs when these pins change, in latest mode too; CI and management pins
# in versions.toml do not count. pins hash: {{ list .versions.codex .versions.claude .corepack_globals .uv_tools .cargo_tools .go_tools | toJson | sha256sum }}
set -uo pipefail
export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$HOME/.bun/bin:$PATH"
export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
{{ template "operation-context.sh" }}
failed=()
if [ "${WORKBENCH_PROBE:-}" = 1 ]; then
    # The planner's PATH holds Workbench's tools and the system directories
    # only; look where the installers put things.
    export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$HOME/.bun/bin:$HOME/go/bin:/usr/local/go/bin:/opt/homebrew/bin:$PATH"
    if [ -r "${NVM_DIR:-$HOME/.nvm}/nvm.sh" ]; then
        # shellcheck source=/dev/null
        source "${NVM_DIR:-$HOME/.nvm}/nvm.sh" >/dev/null 2>&1 || true
        node_default=$(nvm version default 2>/dev/null || true)
        [ -n "$node_default" ] && [ "$node_default" != N/A ] && export PATH="${NVM_DIR:-$HOME/.nvm}/versions/node/$node_default/bin:$PATH"
    fi
    missing=()
    for tool in codex claude corepack; do command -v "$tool" >/dev/null 2>&1 || missing+=("$tool"); done
{{- range $tool, $ver := .corepack_globals }}
    command -v "{{ $tool }}" >/dev/null 2>&1 || missing+=("{{ $tool }}")
{{- end }}
{{- range $pkg, $ver := .uv_tools }}
    command -v "{{ $pkg }}" >/dev/null 2>&1 || missing+=("{{ $pkg }}")
{{- end }}
{{- range $pkg, $ver := .cargo_tools }}
    [ -x "$HOME/.cargo/bin/{{ $pkg }}" ] || command -v "{{ $pkg }}" >/dev/null 2>&1 || missing+=("{{ $pkg }}")
{{- end }}
{{- range $mod, $ver := .go_tools }}
    [ -x "$HOME/go/bin/$(basename "{{ $mod }}")" ] || command -v "$(basename "{{ $mod }}")" >/dev/null 2>&1 || missing+=("$(basename "{{ $mod }}")")
{{- end }}
{{- if eq .versions_mode "pinned" }}
    policy="set to the pinned versions"
{{- else }}
    policy="upgraded to the latest"
{{- end }}
    # Versions are not compared here, so even with every tool installed the run
    # still sets them: this never reports "no change".
    if [ ${#missing[@]} -eq 0 ]; then
        echo "global-tools: the npm, uv, cargo and Go tools are installed; versions are $policy"
    else
        printf -v joined '%s, ' "${missing[@]}"; echo "global-tools: install ${joined%, }; versions are $policy"
    fi
    exit 0
fi
# Each tool is tried on its own. What failed, or what was skipped because the
# runtime it needs is missing, is reported on global-tools, and the script then
# ends nonzero, so the next apply runs it again.
{{ template "effect-report.sh" }}
status=0

{{- $mode := .versions_mode }}

# --- npm globals + codex + claude (into the default Node) ---
{{ template "nvm-load.sh" }}
    nvm use default || failed+=("the default Node could not be selected")
{{- if eq $mode "pinned" }}
    npm install -g "@openai/codex@{{ .versions.codex }}" || failed+=("codex could not be installed")
    npm install -g "@anthropic-ai/claude-code@{{ .versions.claude }}" || failed+=("claude could not be installed")
{{- else }}
    npm install -g @openai/codex@latest || failed+=("codex could not be installed")
    npm install -g @anthropic-ai/claude-code@latest || failed+=("claude could not be installed")
{{- end }}
    # Node >= 25 no longer bundles corepack; install it into the default Node first.
    command -v corepack >/dev/null 2>&1 || npm install -g corepack@latest || failed+=("corepack could not be installed")
    corepack enable || failed+=("corepack could not be enabled")
{{- range $tool, $ver := .corepack_globals }}
{{- if eq $mode "pinned" }}
    corepack install --global "{{ $tool }}@{{ $ver }}" || failed+=("{{ $tool }} could not be installed")
{{- else }}
    corepack install --global "{{ $tool }}@latest" || failed+=("{{ $tool }} could not be installed")
{{- end }}
{{- end }}
else
    part_failed global-tools "codex, claude and the npm tools were not installed: nvm is not installed (the Runtime managers step installs it)" || status=1
fi

# --- uv tools ---
if command -v uv &>/dev/null; then
{{- range $pkg, $ver := .uv_tools }}
{{- if eq $mode "pinned" }}
    uv tool install "{{ $pkg }}=={{ $ver }}" || failed+=("{{ $pkg }} could not be installed")
{{- else }}
    uv tool install --upgrade "{{ $pkg }}" || failed+=("{{ $pkg }} could not be installed")
{{- end }}
{{- end }}
else
    part_failed global-tools "the uv tools were not installed: uv is not installed (the Runtime managers step installs it)" || status=1
fi

# --- cargo tools ---
# (an empty cargo_tools table must still render a valid if-body, hence the no-op)
if command -v cargo &>/dev/null; then
    :
{{- range $pkg, $ver := .cargo_tools }}
{{- if eq $mode "pinned" }}
    cargo install --locked "{{ $pkg }}" --version "{{ $ver }}" || failed+=("{{ $pkg }} could not be installed")
{{- else }}
    cargo install --locked "{{ $pkg }}" || failed+=("{{ $pkg }} could not be installed")
{{- end }}
{{- end }}
else
    part_failed global-tools "the cargo tools were not installed: cargo is not installed (the Runtime managers step installs it with rustup)" || status=1
fi

# --- go tools ---
if command -v go &>/dev/null; then
{{- range $mod, $ver := .go_tools }}
{{- if eq $mode "pinned" }}
    go install "{{ $mod }}@{{ $ver }}" || failed+=("{{ base $mod }} could not be installed")
{{- else }}
    go install "{{ $mod }}@latest" || failed+=("{{ base $mod }} could not be installed")
{{- end }}
{{- end }}
else
    part_failed global-tools "the Go tools were not installed: Go is not installed (the Runtime managers step installs it)" || status=1
fi

# --- podman (Ubuntu repository package) ---
# apt-get waits up to ten minutes for the package lock, which unattended-upgrades
# often holds on a new Ubuntu machine.
if ! command -v podman &>/dev/null; then
    echo "==> Installing podman via apt (sudo may prompt)..."
    sudo apt-get -o DPkg::Lock::Timeout=600 install -y podman || failed+=("podman could not be installed")
else
    echo "    podman already installed: $(podman --version)"
fi

if [ ${#failed[@]} -gt 0 ]; then
    printf -v joined '%s; ' "${failed[@]}"
    part_failed global-tools "${joined%; } (the output above says why)" || status=1
fi
echo "==> Global tools done."
exit "$status"
{{ end -}}
