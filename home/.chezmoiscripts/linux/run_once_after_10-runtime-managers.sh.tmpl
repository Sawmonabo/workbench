{{ if eq .chezmoi.os "linux" -}}
#!/bin/bash
# Install runtime MANAGERS: nvm, uv, rustup, bun, and the Go toolchain.
# Version policy comes from the versions_mode prompt ({{ .versions_mode }})
# and the pins in .chezmoidata/versions.toml. Each manager is a part of its
# own: one that fails is reported on runtime-managers and the others still
# install; the script then ends nonzero, so the next apply runs it again.
set -euo pipefail
{{ includeTemplate ".chezmoitemplates/user-bin-safety.sh" . }}

if [ "${WORKBENCH_PROBE:-}" = 1 ]; then
    parts=() missing=()
    [ -r "${NVM_DIR:-$HOME/.nvm}/nvm.sh" ] || missing+=(nvm)
    for tool in uv rustup bun; do
        if ! command -v "$tool" >/dev/null 2>&1 && [ ! -x "$HOME/.cargo/bin/$tool" ] && [ ! -x "$HOME/.bun/bin/$tool" ]; then
            missing+=("$tool")
        fi
    done
    [ ${#missing[@]} -eq 0 ] || { printf -v joined '%s, ' "${missing[@]}"; parts+=("install ${joined%, }"); }
{{- if eq .versions_mode "pinned" }}
    go_target="{{ .versions.go }}"
{{- else }}
    go_target=$( (curl -fsSL --max-time 3 'https://go.dev/VERSION?m=text' 2>/dev/null || true) | head -n1); go_target=${go_target#go}
{{- end }}
    go_have=
    if go_bin=$(command -v go 2>/dev/null); then
        go_root=$(dirname "$(dirname "$(readlink -f "$go_bin")")")
        [ -r "$go_root/VERSION" ] && go_have=$(head -n1 "$go_root/VERSION")
        go_have=${go_have#go}
    fi
    if [ -z "$go_target" ]; then
        parts+=("Go is ${go_have:-missing}; the latest version could not be looked up")
    elif [ "$go_have" = "$go_target" ]; then
        same="Go $go_have"
    else
        parts+=("Go is ${go_have:-missing}, will be $go_target")
    fi
    if [ ${#parts[@]} -eq 0 ]; then
        echo "runtime-managers: = nvm, uv, rustup, bun and ${same} are installed"
    else
        printf -v joined '%s; ' "${parts[@]}"; echo "runtime-managers: ${joined%; }"
    fi
    exit 0
fi
{{ template "effect-report.sh" }}
status=0
why=
# part EFFECT WHAT FUNCTION runs one part. set -e does not apply inside a
# function called as a condition, so each part returns at its first failed
# command itself, optionally saying why; the effect is then reported and the
# script goes on with the next part.
part() {
    why=
    "$3" && return 0
    part_failed "$1" "$2: ${why:-the output above says why}" || status=1
}
download_dir=$(mktemp -d)
trap 'rm -rf "$download_dir"' EXIT
echo "==> Runtime managers ({{ .versions_mode }} mode)..."

# --- nvm ---
export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
install_nvm() {
    # Download the installer, then run it. `bash -c "curl ... | bash"` pipes an
    # empty body into bash and exits 0 when curl fails, so the real error would
    # only surface later as nvm-missing in 20-runtimes.
    nvm_installer="$download_dir/nvm-install.sh"
{{- if eq .versions_mode "pinned" }}
    curl -fsSL "https://raw.githubusercontent.com/nvm-sh/nvm/{{ .versions.nvm }}/install.sh" -o "$nvm_installer" ||
        { why="its installer could not be downloaded"; return 1; }
{{- else }}
    latest_nvm=$(curl -fsSL https://api.github.com/repos/nvm-sh/nvm/releases/latest | grep -om1 '"tag_name": *"[^"]*"' | cut -d'"' -f4) || true
    [ -n "$latest_nvm" ] || { why="its latest release could not be looked up on GitHub"; return 1; }
    curl -fsSL "https://raw.githubusercontent.com/nvm-sh/nvm/${latest_nvm}/install.sh" -o "$nvm_installer" ||
        { why="its installer could not be downloaded"; return 1; }
{{- end }}
    [ -s "$nvm_installer" ] || { why="its installer could not be downloaded"; return 1; }
    PROFILE=/dev/null bash "$nvm_installer" || return 1
}
if [ ! -r "$NVM_DIR/nvm.sh" ]; then
    part runtime-managers "nvm was not installed" install_nvm
else
    echo "    nvm already present; keeping it."
fi

# --- uv ---
install_uv() {
    why="its installer could not be downloaded or did not finish"
{{- if eq .versions_mode "pinned" }}
    curl -LsSf "https://astral.sh/uv/{{ .versions.uv }}/install.sh" | env UV_NO_MODIFY_PATH=1 sh || return 1
{{- else }}
    curl -LsSf https://astral.sh/uv/install.sh | env UV_NO_MODIFY_PATH=1 sh || return 1
{{- end }}
}
if [ -n "${WORKBENCH_UV:-}" ]; then
    [ -x "$WORKBENCH_UV" ] ||
        part_failed runtime-managers "uv was not set up: the uv Workbench chose to use ($WORKBENCH_UV) is missing" ||
        status=1
elif ! command -v uv &>/dev/null; then
    part runtime-managers "uv was not installed" install_uv
else
    echo "    uv already present: $(uv --version)"
fi

# --- rustup ---
install_rustup() {
    why="its installer could not be downloaded or did not finish"
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --no-modify-path || return 1
}
if ! command -v rustup &>/dev/null && [ ! -x "$HOME/.cargo/bin/rustup" ]; then
    part runtime-managers "rustup was not installed" install_rustup
else
    echo "    rustup already present."
fi

# --- bun ---
install_bun() {
    bun_installer="$download_dir/bun-install.sh"
    if ! curl -fsSL https://bun.com/install -o "$bun_installer" || [ ! -s "$bun_installer" ]; then
        why="its installer could not be downloaded"
        return 1
    fi
# The upstream installer only edits profiles for bash/zsh/fish. Its generic sh
# branch prints PATH instructions; our canonical shell targets already own PATH.
{{- if eq .versions_mode "pinned" }}
    SHELL=/bin/sh bash "$bun_installer" "bun-v{{ .versions.bun }}" || return 1
{{- else }}
    SHELL=/bin/sh bash "$bun_installer" || return 1
{{- end }}
}
if ! command -v bun &>/dev/null && [ ! -x "$HOME/.bun/bin/bun" ]; then
    part runtime-managers "bun was not installed" install_bun
else
    echo "    bun already present."
fi

# --- Go toolchain (user-local, no sudo) ---
{{- if eq .versions_mode "pinned" }}
go_target="{{ .versions.go }}"
{{- else }}
go_target=$(curl -fsSL 'https://go.dev/VERSION?m=text' | head -n1) || true
go_target=${go_target#go}
{{- end }}
install_go() {
    case "$(uname -m)" in
        x86_64) go_arch=amd64 ;;
        aarch64|arm64) go_arch=arm64 ;;
        *) why="go.dev publishes no Go for $(uname -m)"; return 1 ;;
    esac
    install_root="$HOME/.local/share/go-versions"
    safe_user_directory "$install_root" || return 1
    # Updating aliases belonging to this runtime root is an approved runtime
    # effect. Ordinary files and unrelated links remain untouched.
    for command in go gofmt; do
        target="$HOME/.local/bin/$command"
        if [ -L "$target" ]; then
            old=$(readlink "$target")
            case "$old" in "$install_root"/*/bin/"$command")
                old_version=${old#"$install_root/"}; old_version=${old_version%"/bin/$command"}
                [[ "$old_version" =~ ^[0-9]+\.[0-9]+(\.[0-9]+)?$ ]] ||
                    { why="$target links somewhere Workbench does not recognise, so it was kept"; return 1; }
                safe_user_directory "${old%/*}" || return 1
                ;; *) why="$target links somewhere Workbench does not recognise, so it was kept"; return 1 ;; esac
        elif [ -e "$target" ]; then
            why="$target already exists and is not Workbench's, so it was kept"
            return 1
        fi
    done
    tmp="$download_dir/go"
    mkdir -p "$tmp" || return 1
    curl -fsSL "https://go.dev/dl/go${go_target}.linux-${go_arch}.tar.gz" -o "$tmp/go.tar.gz" ||
        { why="it could not be downloaded"; return 1; }
    tar -C "$tmp" -xzf "$tmp/go.tar.gz" || return 1
    mkdir -p "$install_root" "$HOME/.local/bin" || return 1
    if [ -e "$install_root/$go_target" ]; then
        mv "$install_root/$go_target" "$install_root/$go_target.backup.$(date +%Y%m%d%H%M%S)" || return 1
    fi
    mv "$tmp/go" "$install_root/$go_target" || return 1
    ln -sfn "$install_root/$go_target/bin/go" "$HOME/.local/bin/go" || return 1
    ln -sfn "$install_root/$go_target/bin/gofmt" "$HOME/.local/bin/gofmt" || return 1
}
if [ -z "$go_target" ] && command -v go &>/dev/null; then
    echo "    Go is installed; the latest version could not be looked up, so it was kept."
elif [ -z "$go_target" ]; then
    part_failed runtime-managers "Go was not installed: the latest version could not be looked up on go.dev" || status=1
elif command -v go &>/dev/null && go version | grep -q "go${go_target}"; then
    echo "    Go ${go_target} already installed."
else
    echo "==> Installing Go ${go_target}..."
    part runtime-managers "Go ${go_target} was not installed" install_go
fi

echo "==> Runtime managers done."
exit "$status"
{{ end -}}
