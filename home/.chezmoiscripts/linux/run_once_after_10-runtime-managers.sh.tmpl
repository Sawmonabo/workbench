{{ if eq .chezmoi.os "linux" -}}
#!/bin/bash
# Install runtime MANAGERS: nvm, uv, rustup, bun, and the Go toolchain.
# Version policy comes from the versions_mode prompt ({{ .versions_mode }})
# and the pins in .chezmoidata/versions.toml.
set -euo pipefail
{{ includeTemplate ".chezmoitemplates/user-bin-safety.sh" . }}

echo "==> Runtime managers ({{ .versions_mode }} mode)..."

# --- nvm ---
export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
if [ ! -r "$NVM_DIR/nvm.sh" ]; then
    # Download the installer, then run it. `bash -c "curl ... | bash"` pipes an
    # empty body into bash and exits 0 when curl fails, so the real error would
    # only surface later as nvm-missing in 20-runtimes.
    nvm_installer=$(mktemp)
    trap 'rm -f "$nvm_installer"' EXIT
{{- if eq .versions_mode "pinned" }}
    curl -fsSL "https://raw.githubusercontent.com/nvm-sh/nvm/{{ .versions.nvm }}/install.sh" -o "$nvm_installer"
{{- else }}
    latest_nvm=$(curl -fsSL https://api.github.com/repos/nvm-sh/nvm/releases/latest | grep -om1 '"tag_name": *"[^"]*"' | cut -d'"' -f4)
    curl -fsSL "https://raw.githubusercontent.com/nvm-sh/nvm/${latest_nvm}/install.sh" -o "$nvm_installer"
{{- end }}
    [ -s "$nvm_installer" ] || { echo "    nvm installer download failed" >&2; exit 1; }
    PROFILE=/dev/null bash "$nvm_installer"
    rm -f "$nvm_installer"
else
    echo "    nvm already present; keeping it."
fi

# --- uv ---
if [ -n "${WORKBENCH_UV:-}" ]; then
    [ -x "$WORKBENCH_UV" ] || { echo 'WORKBENCH_EFFECT uv blocked: selected owner is unavailable' >&2; exit 1; }
elif ! command -v uv &>/dev/null; then
{{- if eq .versions_mode "pinned" }}
    curl -LsSf "https://astral.sh/uv/{{ .versions.uv }}/install.sh" | env UV_NO_MODIFY_PATH=1 sh
{{- else }}
    curl -LsSf https://astral.sh/uv/install.sh | env UV_NO_MODIFY_PATH=1 sh
{{- end }}
else
    echo "    uv already present: $(uv --version)"
fi

# --- rustup ---
if ! command -v rustup &>/dev/null && [ ! -x "$HOME/.cargo/bin/rustup" ]; then
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --no-modify-path
else
    echo "    rustup already present."
fi

# --- bun ---
if ! command -v bun &>/dev/null && [ ! -x "$HOME/.bun/bin/bun" ]; then
    bun_installer=$(mktemp)
    trap 'rm -f "$bun_installer"' EXIT
    curl -fsSL https://bun.com/install -o "$bun_installer"
    [ -s "$bun_installer" ] || exit 1
# The upstream installer only edits profiles for bash/zsh/fish. Its generic sh
# branch prints PATH instructions; our canonical shell targets already own PATH.
{{- if eq .versions_mode "pinned" }}
    SHELL=/bin/sh bash "$bun_installer" "bun-v{{ .versions.bun }}"
{{- else }}
    SHELL=/bin/sh bash "$bun_installer"
{{- end }}
else
    echo "    bun already present."
fi

# --- Go toolchain (user-local, no sudo) ---
{{- if eq .versions_mode "pinned" }}
go_target="{{ .versions.go }}"
{{- else }}
go_target=$(curl -fsSL 'https://go.dev/VERSION?m=text' | head -n1); go_target=${go_target#go}
{{- end }}
if command -v go &>/dev/null && go version | grep -q "go${go_target}"; then
    echo "    Go ${go_target} already installed."
else
    echo "==> Installing Go ${go_target}..."
    case "$(uname -m)" in
        x86_64) go_arch=amd64 ;;
        aarch64|arm64) go_arch=arm64 ;;
        *) echo 'WORKBENCH_EFFECT go blocked: unsupported architecture' >&2; exit 1 ;;
    esac
    install_root="$HOME/.local/share/go-versions"
    safe_user_directory "$install_root"
    # Updating aliases belonging to this runtime root is an approved runtime
    # effect. Ordinary files and unrelated links remain untouched.
    for command in go gofmt; do
        target="$HOME/.local/bin/$command"
        if [ -L "$target" ]; then
            old=$(readlink "$target")
            case "$old" in "$install_root"/*/bin/"$command")
                old_version=${old#"$install_root/"}; old_version=${old_version%"/bin/$command"}
                [[ "$old_version" =~ ^[0-9]+\.[0-9]+(\.[0-9]+)?$ ]] || { echo "Existing command preserved: $target" >&2; exit 1; }
                safe_user_directory "${old%/*}"
                ;; *) echo "Existing command preserved: $target" >&2; exit 1 ;; esac
        elif [ -e "$target" ]; then
            echo "Existing command preserved: $target" >&2; exit 1
        fi
    done
    tmp=$(mktemp -d)
    curl -fsSL "https://go.dev/dl/go${go_target}.linux-${go_arch}.tar.gz" -o "$tmp/go.tar.gz"
    tar -C "$tmp" -xzf "$tmp/go.tar.gz"
    mkdir -p "$install_root" "$HOME/.local/bin"
    if [ -e "$install_root/$go_target" ]; then
        mv "$install_root/$go_target" "$install_root/$go_target.backup.$(date +%Y%m%d%H%M%S)"
    fi
    mv "$tmp/go" "$install_root/$go_target"
    ln -sfn "$install_root/$go_target/bin/go" "$HOME/.local/bin/go"
    ln -sfn "$install_root/$go_target/bin/gofmt" "$HOME/.local/bin/gofmt"
    rm -rf "$tmp"
fi

echo "==> Runtime managers done."
{{ end -}}
