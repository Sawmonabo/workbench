{{ if eq .chezmoi.os "linux" -}}
#!/bin/bash
# Install language RUNTIMES from .chezmoidata/versions.toml pins.
# Re-runs when these pins change, in latest mode too; CI and management pins
# in versions.toml do not count. pins hash: {{ list .versions.node .versions.node_default .versions.python_pinned .versions.rust | toJson | sha256sum }}
set -uo pipefail
export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$HOME/.bun/bin:$PATH"
export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
{{ template "operation-context.sh" }}
failed=()
if [ "${WORKBENCH_PROBE:-}" = 1 ]; then
    parts=()
    if [ -r "$NVM_DIR/nvm.sh" ]; then
        # shellcheck source=/dev/null
        source "$NVM_DIR/nvm.sh" >/dev/null 2>&1 || true
        node_have=$(nvm version default 2>/dev/null || true); node_have=${node_have#v}; [ "$node_have" = "N/A" ] && node_have=
{{- if eq .versions_mode "pinned" }}
        node_want="{{ .versions.node_default }}"
{{- else }}
        node_want=$(nvm version-remote node 2>/dev/null || true); node_want=${node_want#v}; [ "$node_want" = "N/A" ] && node_want=
{{- end }}
        if [ -z "$node_want" ]; then
            parts+=("Node ${node_have:-absent} (latest unknown, offline)")
        elif [ "$node_have" = "$node_want" ]; then
            parts+=("Node $node_have ok")
        else
            parts+=("Node ${node_have:-absent} → $node_want (default alias)")
        fi
    else
        parts+=("Node needs nvm")
    fi
    if command -v uv >/dev/null 2>&1; then
{{- if eq .versions_mode "pinned" }}
        parts+=("Python {{ join ", " .versions.python_pinned }} via uv")
{{- else }}
        parts+=("Python newest via uv")
{{- end }}
    else
        parts+=("Python needs uv")
    fi
    if command -v rustup >/dev/null 2>&1; then
{{- if eq .versions_mode "pinned" }}
        parts+=("Rust {{ .versions.rust }}")
{{- else }}
        parts+=("Rust stable")
{{- end }}
    else
        parts+=("Rust needs rustup")
    fi
    printf -v joined '%s; ' "${parts[@]}"; echo "runtimes: ${joined%; }"
    exit 0
fi

# --- Node via nvm ---
{{ template "nvm-load.sh" }}
{{- if eq .versions_mode "pinned" }}
{{- range .versions.node }}
    nvm install {{ . }} || failed+=("node-{{ . }}")
{{- end }}
    nvm alias default {{ .versions.node_default }} || failed+=(node-default)
{{- else }}
    # latest: one newest Node only; other versions are a `nvm install <ver>` away.
    nvm install node || failed+=(node-latest)
    nvm alias default node || failed+=(node-default)
{{- end }}
else
    failed+=(nvm-missing)
fi

# --- Python via uv ---
if command -v uv &>/dev/null; then
{{- if eq .versions_mode "pinned" }}
{{- range .versions.python_pinned }}
    uv python install {{ . }} || failed+=("python-{{ . }}")
{{- end }}
{{- else }}
    # latest: one newest stable Python only.
    uv python install || failed+=(python-latest)
{{- end }}
else
    failed+=(uv-missing)
fi

# --- Rust toolchain ---
if command -v rustup &>/dev/null; then
{{- if eq .versions_mode "pinned" }}
    rustup toolchain install {{ .versions.rust }} || failed+=(rust-toolchain)
{{- else }}
    rustup toolchain install stable || failed+=(rust-toolchain)
{{- end }}
else
    failed+=(rustup-missing)
fi

if [ ${#failed[@]} -gt 0 ]; then
    printf 'WARNING: runtime installs failed: %s\n' "${failed[*]}" >&2
    exit 1
fi
echo "==> Runtimes done."
{{ end -}}
