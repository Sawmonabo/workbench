{{ if eq .chezmoi.os "linux" -}}
#!/bin/bash
# Bootstrap script for Linux/WSL — installs bat, fd, oh-my-posh, JetBrains Mono Nerd Font, tmux, gh.
# System packages come from apt on Ubuntu and from dnf on AlmaLinux, where EPEL
# (the epel step) is turned on first for bat and fd.
# Each tool is a part of its own: one that fails is reported on its step
# (epel or linux-packages) and the others still install; the script then ends
# nonzero, so the next apply runs it again.
# dnf waits for its package lock by itself: while another dnf holds it, dnf
# says it is waiting and goes on when that one ends, so no limit is added here.
set -euo pipefail
{{ includeTemplate ".chezmoitemplates/user-bin-safety.sh" . }}
if [ "${WORKBENCH_PROBE:-}" = 1 ]; then
    # EPEL puts nothing in ~/.local/bin, so it is answered before that is checked.
    if ! command -v apt-get >/dev/null 2>&1 && command -v dnf >/dev/null 2>&1; then
        if rpm -q epel-release >/dev/null 2>&1; then
            echo "epel: = EPEL is on"
        else
            echo "epel: turn on EPEL (uses sudo)"
        fi
    fi
    user_bin_refused linux-packages
    missing=()
    for tool in cc c++ curl unzip git fc-cache; do
        command -v "$tool" >/dev/null 2>&1 || missing+=("$tool")
    done
    for tool in bat fd oh-my-posh tmux; do
        command -v "$tool" >/dev/null 2>&1 || missing+=("$tool")
    done
    # gh is Workbench's own copy in ~/.local/bin, which apply installs even
    # when a package's gh is on PATH.
    [ -x "$HOME/.local/bin/gh" ] || missing+=("gh")
    compgen -G "$HOME/.local/share/fonts/JetBrainsMono*NerdFont*.ttf" >/dev/null || missing+=("nerd-font")
    if ! command -v apt-get >/dev/null 2>&1 && command -v dnf >/dev/null 2>&1; then
        rpm -q --whatprovides libatomic >/dev/null 2>&1 || missing+=("libatomic")
    fi
    if [ ${#missing[@]} -eq 0 ]; then
        echo "linux-packages: = bat, fd, tmux, gh, oh-my-posh and the Nerd Font are installed"
    else
        printf -v joined '%s, ' "${missing[@]}"; echo "linux-packages: install ${joined%, }"
    fi
    exit 0
fi
{{ template "effect-report.sh" }}
status=0
why=
# part EFFECT WHAT FUNCTION runs one part. set -e does not apply inside a
# function called as a condition, so each part returns at its first failed
# command itself, optionally saying why; the effect is then reported and the
# script goes on with the next part.
part() {
    why=
    "$3" && return 0
    part_failed "$1" "$2: ${why:-the output above says why}" || status=1
}
download_dir=$(mktemp -d)
trap 'rm -rf "$download_dir"' EXIT

echo "==> Linux/WSL bootstrap starting..."

if [ "${WORKBENCH_EFFECT_EPEL:-1}" = 1 ]; then
# --- EPEL (dnf only): where bat and fd come from on AlmaLinux ---
# It puts nothing in ~/.local/bin, so it runs before that folder is checked.
install_epel() {
    rpm -q epel-release &>/dev/null && return 0
    echo "==> Turning on EPEL (sudo)..."
    sudo dnf install -y epel-release || return 1
}
if ! command -v apt-get &>/dev/null && command -v dnf &>/dev/null; then
    part epel "dnf could not install epel-release" install_epel
fi
fi
user_bin_refused linux-packages

if [ "${WORKBENCH_EFFECT_LINUX_PACKAGES:-1}" = 1 ]; then
# --- base toolchain (a fresh WSL image has no C compiler; cargo/uv/node-gyp all need one) ---
base_missing=0
for tool in cc c++ curl unzip git fc-cache; do
    command -v "$tool" >/dev/null || base_missing=1
done
# The Node builds nvm installs need libatomic.so.1, which AlmaLinux does not
# install with gcc; on Ubuntu gcc brings it.
if ! command -v apt-get &>/dev/null && command -v dnf &>/dev/null; then
    rpm -q --whatprovides libatomic &>/dev/null || base_missing=1
fi
# Every apt-get here waits up to ten minutes for the package lock: on a new
# Ubuntu machine unattended-upgrades often holds it while this runs.
install_base() {
    if command -v apt-get &>/dev/null; then
        echo "==> Installing build-essential, curl, unzip, git (sudo)..."
        sudo apt-get -o DPkg::Lock::Timeout=600 update -qq || return 1
        sudo apt-get -o DPkg::Lock::Timeout=600 install -y -qq build-essential curl unzip git ca-certificates fontconfig || return 1
    elif command -v dnf &>/dev/null; then
        # Only the names rpm -q --whatprovides does not find are installed, so a
        # name an installed package already provides is not installed again.
        local pkg missing=()
        for pkg in gcc gcc-c++ make curl unzip git ca-certificates fontconfig libatomic; do
            rpm -q --whatprovides "$pkg" &>/dev/null || missing+=("$pkg")
        done
        [ ${#missing[@]} -gt 0 ] || return 0
        echo "==> Installing ${missing[*]} (sudo)..."
        sudo dnf install -y "${missing[@]}" || return 1
    else
        why="neither apt-get nor dnf was found; install them with this system's package manager"
        return 1
    fi
}
if [ "$base_missing" -eq 1 ]; then
    part linux-packages "the C toolchain, curl, unzip, git and fontconfig (and on AlmaLinux libatomic) were not installed" install_base
fi

# --- role folders (Windows Terminal's WSL profile opens in the work folder, else the personal one) ---
{{ if .has_work -}}
mkdir -p "$HOME/{{ trimPrefix "~/" .work_folder }}"
{{ end -}}
{{ if .has_personal -}}
mkdir -p "$HOME/{{ trimPrefix "~/" .personal_folder }}"
{{ end }}
# cargo, for bat and fd where neither apt nor dnf is available.
install_cargo() {
    command -v cargo &>/dev/null && return 0
    echo "    Installing rustup first..."
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --no-modify-path ||
        { why="rustup, which builds it, could not be installed"; return 1; }
    . "$HOME/.cargo/env" || return 1
}

# epel_enabled checks that dnf lists EPEL, where bat and fd come from, as
# enabled, whatever the epel step's switch says.
epel_enabled() {
    local repos
    repos=$(dnf repolist --enabled) || repos=
    grep -qE '^epel([[:space:]]|$)' <<<"$repos" && return 0
    why="EPEL is off: turn on the epel step or enable EPEL"
    return 1
}

# --- bat ---
# Prefer the distro package (seconds, no compiler). Debian/Ubuntu ship the
# binary as `batcat`; expose it as `bat` in ~/.local/bin. AlmaLinux's, from
# EPEL, is already `bat`. Fall back to cargo only where neither apt nor dnf is
# available.
install_bat() {
    if command -v apt-get &>/dev/null; then
        echo "==> Installing bat via apt..."
        sudo apt-get -o DPkg::Lock::Timeout=600 install -y -qq bat || return 1
        if ! command -v bat &>/dev/null && command -v batcat &>/dev/null; then
            mkdir -p "$HOME/.local/bin" || return 1
            require_unused_command bat || return 1
            ln -s "$(command -v batcat)" "$HOME/.local/bin/bat" || return 1
        fi
    elif command -v dnf &>/dev/null; then
        epel_enabled || return 1
        echo "==> Installing bat via dnf..."
        sudo dnf install -y bat || return 1
    else
        echo "==> Installing bat via cargo..."
        install_cargo || return 1
        cargo install bat || return 1
    fi
    echo "    bat installed."
}
if ! command -v bat &>/dev/null; then
    part linux-packages "bat was not installed" install_bat
else
    echo "==> bat already installed, skipping."
fi

# --- fd ---
# Prefer the distro package (seconds, no compiler). Debian/Ubuntu ship the
# binary as `fdfind` (name clash with fdclone); expose it as `fd` in
# ~/.local/bin. AlmaLinux's, from EPEL, is already `fd`. Fall back to cargo
# only where neither apt nor dnf is available.
install_fd() {
    if command -v apt-get &>/dev/null; then
        echo "==> Installing fd via apt..."
        sudo apt-get -o DPkg::Lock::Timeout=600 install -y -qq fd-find || return 1
        if ! command -v fd &>/dev/null && command -v fdfind &>/dev/null; then
            mkdir -p "$HOME/.local/bin" || return 1
            require_unused_command fd || return 1
            ln -s "$(command -v fdfind)" "$HOME/.local/bin/fd" || return 1
        fi
    elif command -v dnf &>/dev/null; then
        epel_enabled || return 1
        echo "==> Installing fd via dnf..."
        sudo dnf install -y fd-find || return 1
    else
        echo "==> Installing fd via cargo..."
        install_cargo || return 1
        cargo install fd-find || return 1
    fi
    echo "    fd installed."
}
if ! command -v fd &>/dev/null; then
    part linux-packages "fd was not installed" install_fd
else
    echo "==> fd already installed, skipping."
fi

# --- oh-my-posh ---
install_omp() {
    require_unused_command oh-my-posh || return 1
    echo "==> Installing oh-my-posh..."
    # Download first: `curl | bash` runs an empty body and exits 0 when curl fails.
    if ! curl -fsSL --retry 3 https://ohmyposh.dev/install.sh -o "$download_dir/omp-install.sh" ||
        [ ! -s "$download_dir/omp-install.sh" ]; then
        why="its installer could not be downloaded"
        return 1
    fi
    bash "$download_dir/omp-install.sh" -d ~/.local/bin || return 1
    echo "    oh-my-posh installed."
}
if ! command -v oh-my-posh &>/dev/null; then
    part linux-packages "oh-my-posh was not installed" install_omp
else
    echo "==> oh-my-posh already installed, skipping."
fi

# --- Oh My Posh themes (downloaded to cache) ---
THEMES_DIR="$HOME/.cache/oh-my-posh/themes"
install_themes() {
    command -v unzip >/dev/null || { why="unzip is not installed (the base install above provides it)"; return 1; }
    echo "==> Downloading oh-my-posh themes..."
    mkdir -p "$THEMES_DIR" || return 1
    THEMES_URL="https://github.com/JanDeDobbeleer/oh-my-posh/releases/latest/download/themes.zip"
    curl -fsSL "$THEMES_URL" -o "$download_dir/themes.zip" || { why="they could not be downloaded"; return 1; }
    unzip -o "$download_dir/themes.zip" -d "$THEMES_DIR" || return 1
    chmod u+rw "$THEMES_DIR"/*.omp.* || return 1
    echo "    Themes installed to $THEMES_DIR"
}
if [ ! -d "$THEMES_DIR" ] || [ -z "$(ls -A "$THEMES_DIR" 2>/dev/null)" ]; then
    part linux-packages "the oh-my-posh themes were not installed" install_themes
else
    echo "==> oh-my-posh themes already present, skipping."
fi

# --- Oh My Posh config directory ---
OMP_CONFIG_DIR="$HOME/.config/oh-my-posh"
mkdir -p "$OMP_CONFIG_DIR"

# --- JetBrains Mono Nerd Font ---
FONT_DIR="$HOME/.local/share/fonts"
# Installed-check: look for the font files themselves. The previous
# `fc-list | grep -q` test was wrong under `set -o pipefail`: grep -q exits on
# the first match and closes the pipe, fc-list dies of SIGPIPE, the pipeline
# reports failure, and the font was re-downloaded on every run.
font_installed() {
    compgen -G "$FONT_DIR/JetBrainsMono*NerdFont*.ttf" >/dev/null \
        || { command -v fc-list >/dev/null && fc-list 2>/dev/null | grep -ci "JetBrainsMono Nerd Font" | grep -qv '^0$'; }
}
install_font() {
    for tool in unzip fc-cache; do
        command -v "$tool" >/dev/null || { why="$tool is not installed (the base install above provides it)"; return 1; }
    done
    echo "==> Installing JetBrains Mono Nerd Font..."
    mkdir -p "$FONT_DIR" || return 1
    FONT_URL=$(curl -fsSL https://api.github.com/repos/ryanoasis/nerd-fonts/releases/latest \
        | grep -o '"browser_download_url": *"[^"]*JetBrainsMono[^"]*\.zip"' \
        | head -1 \
        | cut -d'"' -f4) || true
    [ -n "$FONT_URL" ] || { why="its download link could not be found on GitHub"; return 1; }
    curl -fsSL "$FONT_URL" -o "$download_dir/font.zip" || { why="it could not be downloaded"; return 1; }
    unzip -o "$download_dir/font.zip" -d "$FONT_DIR" || return 1
    fc-cache -fv || return 1
    echo "    JetBrains Mono Nerd Font installed."
}
if ! font_installed; then
    part linux-packages "the JetBrains Mono Nerd Font was not installed" install_font
else
    echo "==> JetBrains Mono Nerd Font already installed, skipping."
fi

# --- gh (GitHub CLI) ---
# Per-user install of the upstream static binary into ~/.local/bin: no sudo,
# no distro repo (Ubuntu universe lags a year+: 26.04 ships 2.46 vs 2.9x).
# ~/.local/bin precedes /usr/bin in PATH, so this shadows any apt-installed gh.
install_gh() {
    require_unused_command gh || return 1
    echo "==> Installing gh (GitHub CLI) to ~/.local/bin..."
    case "$(uname -m)" in
        x86_64) GH_ARCH=amd64 ;;
        aarch64|arm64) GH_ARCH=arm64 ;;
        *) why="GitHub publishes no gh for $(uname -m); install it from https://cli.github.com"; return 1 ;;
    esac
    GH_TAG=$(curl -fsSL https://api.github.com/repos/cli/cli/releases/latest \
        | grep -o '"tag_name": *"v[^"]*"' | cut -d'"' -f4) || true
    [ -n "$GH_TAG" ] || { why="its latest release could not be looked up on GitHub"; return 1; }
    GH_VER=${GH_TAG#v}
    GH_TMP="$download_dir/gh"
    mkdir -p "$GH_TMP" || return 1
    curl -fsSL "https://github.com/cli/cli/releases/download/${GH_TAG}/gh_${GH_VER}_linux_${GH_ARCH}.tar.gz" \
        | tar -xz -C "$GH_TMP" || { why="it could not be downloaded"; return 1; }
    mkdir -p "$HOME/.local/bin" "$HOME/.local/share/man/man1" || return 1
    install -m 755 "$GH_TMP/gh_${GH_VER}_linux_${GH_ARCH}/bin/gh" "$HOME/.local/bin/gh" || return 1
    cp "$GH_TMP/gh_${GH_VER}_linux_${GH_ARCH}/share/man/man1/"*.1 "$HOME/.local/share/man/man1/" || return 1
    echo "    gh installed: $("$HOME/.local/bin/gh" --version | head -1)"
}
if [ ! -x "$HOME/.local/bin/gh" ]; then
    part linux-packages "gh was not installed" install_gh
else
    echo "==> gh already installed ($("$HOME/.local/bin/gh" --version | head -1)), skipping."
fi

# --- tmux ---
install_tmux() {
    echo "==> Installing tmux..."
    if command -v apt-get &>/dev/null; then
        sudo apt-get -o DPkg::Lock::Timeout=600 update && sudo apt-get -o DPkg::Lock::Timeout=600 install -y tmux || return 1
    elif command -v dnf &>/dev/null; then
        sudo dnf install -y tmux || return 1
    else
        why="neither apt-get nor dnf was found; install tmux with this system's package manager"
        return 1
    fi
    echo "    tmux installed."
}
if ! command -v tmux &>/dev/null; then
    part linux-packages "tmux was not installed" install_tmux
else
    echo "==> tmux already installed, skipping."
fi
fi

echo "==> Linux/WSL bootstrap complete."
exit "$status"
{{ end -}}
