{{ if eq .chezmoi.os "darwin" -}}
#!/usr/bin/env bash
# Install GLOBAL command-line tools from .chezmoidata/versions.toml.
# Re-runs when these pins change, in latest mode too; CI and management pins
# in versions.toml do not count. pins hash: {{ list .versions.codex .versions.claude .corepack_globals .uv_tools .cargo_tools .go_tools | toJson | sha256sum }}
set -uo pipefail
export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$HOME/.bun/bin:$PATH"
# Homebrew is not on PATH in the non-login shell chezmoi runs scripts in.
if [ -x /opt/homebrew/bin/brew ]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
elif [ -x /usr/local/bin/brew ]; then
    eval "$(/usr/local/bin/brew shellenv)"
fi
export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
{{ template "operation-context.sh" }}
failed=() missing=()
if [ "${WORKBENCH_PROBE:-}" = 1 ]; then
    # The planner's PATH holds Workbench's tools and the system directories
    # only; look where the installers put things.
    export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$HOME/.bun/bin:$HOME/go/bin:/usr/local/go/bin:/opt/homebrew/bin:$PATH"
    if [ -r "${NVM_DIR:-$HOME/.nvm}/nvm.sh" ]; then
        # shellcheck source=/dev/null
        source "${NVM_DIR:-$HOME/.nvm}/nvm.sh" >/dev/null 2>&1 || true
        node_default=$(nvm version default 2>/dev/null || true)
        [ -n "$node_default" ] && [ "$node_default" != N/A ] && export PATH="${NVM_DIR:-$HOME/.nvm}/versions/node/$node_default/bin:$PATH"
    fi
    missing=()
    for tool in codex claude corepack; do command -v "$tool" >/dev/null 2>&1 || missing+=("$tool"); done
{{- range $tool, $ver := .corepack_globals }}
    command -v "{{ $tool }}" >/dev/null 2>&1 || missing+=("{{ $tool }}")
{{- end }}
{{- range $pkg, $ver := .uv_tools }}
    command -v "{{ $pkg }}" >/dev/null 2>&1 || missing+=("{{ $pkg }}")
{{- end }}
{{- range $pkg, $ver := .cargo_tools }}
    [ -x "$HOME/.cargo/bin/{{ $pkg }}" ] || command -v "{{ $pkg }}" >/dev/null 2>&1 || missing+=("{{ $pkg }}")
{{- end }}
{{- range $mod, $ver := .go_tools }}
    [ -x "$HOME/go/bin/$(basename "{{ $mod }}")" ] || command -v "$(basename "{{ $mod }}")" >/dev/null 2>&1 || missing+=("$(basename "{{ $mod }}")")
{{- end }}
{{- if eq .versions_mode "pinned" }}
    policy="set to the pinned versions"
{{- else }}
    policy="upgraded to the latest"
{{- end }}
    # Versions are not compared here, so even with every tool installed the run
    # still sets them: this never reports "no change".
    if [ ${#missing[@]} -eq 0 ]; then
        echo "global-tools: the npm, uv, cargo and Go tools are installed; versions are $policy"
    else
        printf -v joined '%s, ' "${missing[@]}"; echo "global-tools: install ${joined%, }; versions are $policy"
    fi
    exit 0
fi

{{- $mode := .versions_mode }}
{{ template "effect-report.sh" }}
status=0

# --- npm globals + codex + claude (into the default Node) ---
{{ template "nvm-load.sh" }}
    nvm use default || missing+=("the default Node")
{{- if eq $mode "pinned" }}
    # macOS: claude and codex usually come from their native installers in
    # ~/.local/bin, which self-update. Only fall back to npm when absent, so
    # the npm copy never shadows the native one on PATH.
    command -v codex >/dev/null 2>&1 || npm install -g "@openai/codex@{{ .versions.codex }}" || failed+=(codex)
    command -v claude >/dev/null 2>&1 || npm install -g "@anthropic-ai/claude-code@{{ .versions.claude }}" || failed+=(claude)
{{- else }}
    command -v codex >/dev/null 2>&1 || npm install -g @openai/codex@latest || failed+=(codex)
    command -v claude >/dev/null 2>&1 || npm install -g @anthropic-ai/claude-code@latest || failed+=(claude)
{{- end }}
    # Node >= 25 no longer bundles corepack; install it into the default Node first.
    command -v corepack >/dev/null 2>&1 || npm install -g corepack@latest || failed+=(corepack)
    corepack enable || failed+=("corepack enable")
{{- range $tool, $ver := .corepack_globals }}
{{- if eq $mode "pinned" }}
    corepack install --global "{{ $tool }}@{{ $ver }}" || failed+=("{{ $tool }}")
{{- else }}
    corepack install --global "{{ $tool }}@latest" || failed+=("{{ $tool }}")
{{- end }}
{{- end }}
else
    missing+=(nvm)
fi

# --- uv tools ---
if command -v uv &>/dev/null; then
{{- range $pkg, $ver := .uv_tools }}
{{- if eq $mode "pinned" }}
    uv tool install "{{ $pkg }}=={{ $ver }}" || failed+=("{{ $pkg }}")
{{- else }}
    uv tool install --upgrade "{{ $pkg }}" || failed+=("{{ $pkg }}")
{{- end }}
{{- end }}
else
    missing+=(uv)
fi

# --- cargo tools ---
# (an empty cargo_tools table must still render a valid if-body, hence the no-op)
if command -v cargo &>/dev/null; then
    :
{{- range $pkg, $ver := .cargo_tools }}
{{- if eq $mode "pinned" }}
    cargo install --locked "{{ $pkg }}" --version "{{ $ver }}" || failed+=("{{ $pkg }}")
{{- else }}
    cargo install --locked "{{ $pkg }}" || failed+=("{{ $pkg }}")
{{- end }}
{{- end }}
else
    missing+=(cargo)
fi

# --- go tools ---
if command -v go &>/dev/null; then
{{- range $mod, $ver := .go_tools }}
{{- if eq $mode "pinned" }}
    go install "{{ $mod }}@{{ $ver }}" || failed+=("{{ $mod }}")
{{- else }}
    go install "{{ $mod }}@latest" || failed+=("{{ $mod }}")
{{- end }}
{{- end }}
else
    missing+=(Go)
fi

# --- Docker: Docker Desktop (the Mac apps step) provides the docker CLI ---
# Nothing in this script uses docker, and a clean Mac gets Docker Desktop later,
# from the apps step that runs after this one, so a missing CLI is a note and
# never a failure. Docker Desktop links its CLI into /usr/local/bin, which is
# not on the PATH of a non-login shell on Apple Silicon.
if command -v docker &>/dev/null || [ -x /usr/local/bin/docker ]; then
    echo "    docker CLI present"
else
    echo "    docker CLI not installed yet; Docker Desktop provides it (Mac apps step)"
fi

if [ ${#failed[@]} -gt 0 ]; then
    printf -v joined '%s, ' "${failed[@]}"
    part_failed global-tools "${joined%, } could not be installed (the output above says why)" || status=1
fi
if [ ${#missing[@]} -gt 0 ]; then
    printf -v joined '%s, ' "${missing[@]}"
    part_failed global-tools "${joined%, } not installed yet (earlier setup steps install them), so the tools that need them were skipped" || status=1
fi
[ "$status" -eq 0 ] || exit "$status"
echo "==> Global tools done."
{{ end -}}
