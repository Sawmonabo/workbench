{{ if eq .chezmoi.os "darwin" -}}
#!/usr/bin/env bash
# GUI apps (casks) and VS Code extensions from .chezmoidata/packages.toml,
# plus the Homebrew updates the approved plan named.
# Runs on every apply (run_after_, not run_onchange_) so it converges: an app
# that was skipped because it was running, or a download that failed, is
# retried on the next apply with no manual state reset. When every app is
# installed, the app part is a single `brew bundle check`.
#
# - A missing app is installed at the cask's current version.
# - An app already installed outside Homebrew is left alone; Homebrew would
#   refuse to install over it.
# - Updates run only for the formulae and casks the approved plan named in
#   WORKBENCH_TOOL_UPDATES and WORKBENCH_APP_UPDATES. The plan chose them with
#   Homebrew's own outdated check, which compares the installed app's version
#   and skips pinned packages.
set -euo pipefail
export HOMEBREW_NO_AUTO_UPDATE=1 HOMEBREW_NO_ENV_HINTS=1
if [ -x /opt/homebrew/bin/brew ]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
elif [ -x /usr/local/bin/brew ]; then
    eval "$(/usr/local/bin/brew shellenv)"
fi

if [ "${WORKBENCH_PROBE:-}" = 1 ]; then
    installed="$(brew list --cask 2>/dev/null || true)"
    missing=()
{{- range .packages.darwin.cask }}
    grep -qx "{{ . }}" <<< "$installed" || missing+=("{{ . }}")
{{- end }}
    if [ ${#missing[@]} -eq 0 ]; then
        echo "macos-apps-extensions: apps present; missing VS Code extensions installed"
    else
        echo "macos-apps-extensions: install ${missing[*]} unless already outside Homebrew; missing VS Code extensions installed"
    fi
    exit 0
fi
echo "==> Apps and VS Code extensions..."
managed_casks="$(brew list --cask 2>/dev/null || true)"
bundle_casks=()
outside=()
skipped=()

classify() {
    local cask="$1" info app
    if grep -qx "$cask" <<< "$managed_casks"; then
        bundle_casks+=("$cask"); return
    fi
    if ! info="$(brew info --cask --json=v2 "$cask" 2>/dev/null)"; then
        bundle_casks+=("$cask"); return    # let brew bundle report the error
    fi
    app="$(jq -r '[.casks[0].artifacts[] | select(.app) | .app[0] | strings][0] // empty' <<< "$info")"
    if [ -n "$app" ] && [ -d "/Applications/$app" ]; then
        outside+=("$cask ($app)"); return
    fi
    bundle_casks+=("$cask")
}
{{- range .packages.darwin.cask }}
classify "{{ . }}"
{{- end }}

if [ ${#outside[@]} -gt 0 ]; then
    printf '    Left alone, installed outside Homebrew: %s\n' "${outside[@]}"
fi

bundle="$(mktemp)"
trap 'rm -f "$bundle"' EXIT
{
    for cask in ${bundle_casks[@]+"${bundle_casks[@]}"}; do
        echo "cask \"$cask\""
    done
} > "$bundle"

# --no-upgrade: install what is missing; updates are the plan's choice below.
if brew bundle check --file="$bundle" --no-upgrade >/dev/null 2>&1; then
    echo "==> Apps already installed."
else
    echo "==> Installing missing apps from packages.toml..."
    brew bundle install --file="$bundle" --no-upgrade || skipped+=("brew bundle reported failures (see above); retried on the next apply")
fi

# The approved plan named every package these updates bring with them, so
# Homebrew is told not to ask again.
if [ -n "${WORKBENCH_TOOL_UPDATES:-}" ]; then
    read -ra tools <<< "$WORKBENCH_TOOL_UPDATES"
    echo "==> Updating ${tools[*]}..."
    HOMEBREW_NO_ASK=1 brew upgrade --formula "${tools[@]}" || skipped+=("updating ${tools[*]} failed (see above)")
fi

if [ -n "${WORKBENCH_APP_UPDATES:-}" ]; then
    read -ra updates <<< "$WORKBENCH_APP_UPDATES"
    echo "==> Updating ${updates[*]}..."
    HOMEBREW_NO_ASK=1 brew upgrade --cask "${updates[@]}" || skipped+=("updating ${updates[*]} failed (see above)")
fi

# A skipped app must not cancel the unrelated extension step; report it after.
status=0
if [ ${#skipped[@]} -gt 0 ]; then
    printf '    WARNING: %s\n' "${skipped[@]}" >&2
    status=1
fi
{{ includeTemplate ".chezmoitemplates/vscode-extensions.sh.tmpl" . }}
exit "$status"
{{ end -}}
