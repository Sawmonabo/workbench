{{ if eq .chezmoi.os "darwin" -}}
#!/usr/bin/env bash
# Install runtime MANAGERS on macOS: nvm and rustup via their upstream
# installers; uv, bun, and Go come from Homebrew (00-packages) and are only
# checked here. Mirrors linux/10-runtime-managers. Each manager is tried on its
# own: one that fails is reported, the others still install, and the script
# ends nonzero so chezmoi runs it again on the next apply.
set -euo pipefail

# Homebrew is not on PATH in the non-login shell chezmoi runs scripts in.
if [ -x /opt/homebrew/bin/brew ]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
elif [ -x /usr/local/bin/brew ]; then
    eval "$(/usr/local/bin/brew shellenv)"
fi

if [ "${WORKBENCH_PROBE:-}" = 1 ]; then
    missing=()
    [ -r "${NVM_DIR:-$HOME/.nvm}/nvm.sh" ] || missing+=(nvm)
    command -v rustup >/dev/null 2>&1 || [ -x "$HOME/.cargo/bin/rustup" ] || missing+=(rustup)
    for tool in uv bun go; do
        command -v "$tool" >/dev/null 2>&1 || missing+=("$tool (from Homebrew)")
    done
    if [ ${#missing[@]} -eq 0 ]; then
        echo "runtime-managers: = nvm, rustup, uv, bun and Go are installed"
    else
        printf -v joined '%s, ' "${missing[@]}"; echo "runtime-managers: install ${joined%, }"
    fi
    exit 0
fi
echo "==> Runtime managers ({{ .versions_mode }} mode)..."
{{ template "operation-context.sh" }}
{{ template "effect-report.sh" }}
status=0

# --- nvm ---
export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
if [ ! -r "$NVM_DIR/nvm.sh" ]; then
    # Download the installer, then run it. `bash -c "curl ... | bash"` pipes an
    # empty body into bash and exits 0 when curl fails, so the real error would
    # only surface later as nvm-missing in 20-runtimes.
    nvm_installer=$(mktemp)
    trap 'rm -f "$nvm_installer"' EXIT
{{- if eq .versions_mode "pinned" }}
    nvm_url="https://raw.githubusercontent.com/nvm-sh/nvm/{{ .versions.nvm }}/install.sh"
{{- else }}
    latest_nvm=$(curl -fsSL https://api.github.com/repos/nvm-sh/nvm/releases/latest | grep -om1 '"tag_name": *"[^"]*"' | cut -d'"' -f4 || true)
    nvm_url="https://raw.githubusercontent.com/nvm-sh/nvm/${latest_nvm}/install.sh"
{{- end }}
    if ! curl -fsSL "$nvm_url" -o "$nvm_installer" || [ ! -s "$nvm_installer" ]; then
        part_failed runtime-managers "nvm's installer could not be downloaded, so nvm was not installed" || status=1
    elif ! PROFILE=/dev/null bash "$nvm_installer"; then
        part_failed runtime-managers "nvm's installer failed (the output above says why)" || status=1
    fi
    rm -f "$nvm_installer"
else
    echo "    nvm already present; keeping it."
fi

# --- rustup ---
if ! command -v rustup &>/dev/null && [ ! -x "$HOME/.cargo/bin/rustup" ]; then
    rustup_installer=$(mktemp)
    trap 'rm -f "${nvm_installer:-}" "$rustup_installer"' EXIT
    if ! curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs -o "$rustup_installer" || [ ! -s "$rustup_installer" ]; then
        part_failed runtime-managers "rustup's installer could not be downloaded, so rustup was not installed" || status=1
    elif ! sh "$rustup_installer" -y --no-modify-path; then
        part_failed runtime-managers "rustup's installer failed (the output above says why)" || status=1
    fi
    rm -f "$rustup_installer"
else
    echo "    rustup already present."
fi

# --- uv, bun, Go (Homebrew) ---
missing=()
for tool in uv bun go; do
    if command -v "$tool" &>/dev/null; then
        echo "    $tool present: $({ "$tool" --version || "$tool" version; } 2>/dev/null | head -n1)"
    else
        missing+=("$tool")
    fi
done
if [ ${#missing[@]} -gt 0 ]; then
    printf -v joined '%s, ' "${missing[@]}"
    part_failed runtime-managers "${joined%, } not installed; the Homebrew packages step installs them" || status=1
fi

[ "$status" -eq 0 ] || exit "$status"
echo "==> Runtime managers done."
{{ end -}}
