{{ if eq .chezmoi.os "darwin" -}}
#!/usr/bin/env bash
# macOS bootstrap, before-phase: Homebrew, the command-line formulae under
# [packages.darwin] in .chezmoidata/packages.toml and the oh-my-posh config
# directory. Deliberately limited to what the rc files and the
# after-phase scripts depend on, because anything that fails here blocks the
# apply before a single file deploys. GUI apps (casks) and VS Code extensions
# are installed best-effort afterwards by 50-apps-and-extensions.
#
{{- if .has_work }}
# Two effects share this script, and each section runs only when its own effect
# is ticked (WORKBENCH_EFFECT_<NAME>, 1 when run without Workbench): macos-packages
# for Homebrew and the formulae, work-tools for the Bitwarden CLI.
{{- else }}
# The macos-packages section runs only when that effect is ticked
# (WORKBENCH_EFFECT_MACOS_PACKAGES, 1 when run without Workbench).
{{- end }}
set -euo pipefail
# One trap for every temporary file below; a later trap would replace an earlier one.
trap 'rm -f "${installer:-}" "${brewfile:-}"{{ if .has_work }} "${bw_brewfile:-}"{{ end }}' EXIT

# A bootstrap should not be the thing that updates Homebrew or nags. Homebrew's
# own cleanup of superseded versions stays on, as it is by default.
export HOMEBREW_NO_AUTO_UPDATE=1 HOMEBREW_NO_ENV_HINTS=1

# The formulae Workbench lists, as a Brewfile. brew bundle resolves aliases
# (postgresql -> postgresql@N), so the install below does not reinstall on
# every run the way a `brew list <alias>` check would.
write_brewfile() {
{{- range .packages.darwin.brew }}
{{- if or (eq . "chezmoi") (eq . "uv") }}
    if [ -z "${WORKBENCH_{{ . | upper }}:-}" ]; then
    echo 'brew "{{ . }}"'
    fi
{{- else }}
    echo 'brew "{{ . }}"'
{{- end }}
{{- end }}
}

if [ "${WORKBENCH_PROBE:-}" = 1 ]; then
    # A probe writes nothing and fetches nothing. Checking what is installed
    # would make brew download its formula data into ~/Library/Caches, so the
    # probe only says what apply does.
    if [ ! -x /opt/homebrew/bin/brew ] && [ ! -x /usr/local/bin/brew ]; then
        echo "macos-packages: install Homebrew and the tools Workbench lists"
    else
        echo "macos-packages: install the tools Workbench lists that are missing (nothing is upgraded)"
    fi
{{- if .has_work }}
    if [ -x /opt/homebrew/bin/bw ] || [ -x /usr/local/bin/bw ]; then
        echo "work-tools: = Bitwarden CLI is installed"
    else
        echo "work-tools: install Bitwarden CLI"
    fi
{{- end }}
    exit 0
fi
echo "==> macOS bootstrap starting..."

if [ "${WORKBENCH_EFFECT_MACOS_PACKAGES:-1}" = 1 ]; then
# --- Homebrew ---
# Probe the prefixes rather than `command -v brew`: on a Mac where Homebrew is
# installed but not yet on PATH the installer would re-run and prompt for RETURN
# and sudo. Download the installer to a file first, too — `bash -c "$(curl ...)"`
# runs an empty string and exits 0 when the download fails, and the real error
# then surfaces much later as `brew: command not found`.
if [ ! -x /opt/homebrew/bin/brew ] && [ ! -x /usr/local/bin/brew ]; then
    echo "==> Installing Homebrew..."
    installer="$(mktemp)"
    curl -fsSL --retry 5 --retry-all-errors https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh -o "$installer"
    [ -s "$installer" ] || { echo "Homebrew installer download failed" >&2; exit 1; }
    # NONINTERACTIVE: no RETURN prompt, and the installer's sudo check never asks
    # for a password (sudo -n), so it needs a sudo ticket that is still valid.
    # Workbench asks for the Mac password once before the apply starts and keeps
    # that ticket alive; run without Workbench, chezmoi needs a recent sudo first.
    NONINTERACTIVE=1 /bin/bash "$installer"
fi
fi
# Homebrew is not on PATH in the non-login shell chezmoi runs scripts in. Both
# sections below need it, so this stays outside the macos-packages gate.
if [ -x /opt/homebrew/bin/brew ]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
elif [ -x /usr/local/bin/brew ]; then
    eval "$(/usr/local/bin/brew shellenv)"
fi
{{ template "operation-context.sh" }}

if [ "${WORKBENCH_EFFECT_MACOS_PACKAGES:-1}" = 1 ]; then
# --- Formulae (strict; idempotent: brew bundle skips what is installed) ---
# Strict on purpose: this is the CLI set the rc files and the later scripts
# assume, and a re-run resumes idempotently.
# brew bundle resolves aliases (postgresql -> postgresql@N), so it does not
# reinstall on every run the way a `brew list <alias>` probe would.
# --no-upgrade: bootstrap installs what is missing, it never upgrades what is there.
brewfile="$(mktemp)"
write_brewfile > "$brewfile"
echo "==> Installing formulae from packages.toml..."
brew bundle install --file="$brewfile" --no-upgrade

# --- Oh My Posh config directory ---
mkdir -p "$HOME/.config/oh-my-posh"
fi
{{- if .has_work }}

if [ "${WORKBENCH_EFFECT_WORK_TOOLS:-1}" = 1 ]; then
# --- Bitwarden CLI (work machines only; the bw wrapper in .zshrc expects it) ---
# Role-gated here so bitwarden-cli stays out of the role-neutral data lists.
# This never installs Homebrew: when it is missing the step is reported blocked,
# the rest of the apply goes on, and the step runs once Homebrew is there.
if command -v brew >/dev/null 2>&1; then
    echo "==> Installing Bitwarden CLI..."
    bw_brewfile="$(mktemp)"
    echo 'brew "bitwarden-cli"' > "$bw_brewfile"
    brew bundle install --file="$bw_brewfile" --no-upgrade
else
    echo "WORKBENCH_EFFECT work-tools blocked: Homebrew is not installed, so the Bitwarden CLI was not installed" >&2
    if [ -n "${WORKBENCH_EFFECT_REPORT:-}" ]; then
        printf '%s\t%s\n' work-tools "Homebrew is not installed, so the Bitwarden CLI was not installed" >> "$WORKBENCH_EFFECT_REPORT"
    fi
fi
fi
{{- end }}

echo "==> macOS bootstrap complete."
{{ end -}}
