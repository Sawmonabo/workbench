{{ if eq .chezmoi.os "darwin" -}}
#!/usr/bin/env bash
# Install language RUNTIMES from .chezmoidata/versions.toml pins.
# Re-runs when these pins change, in latest mode too; CI and management pins
# in versions.toml do not count. pins hash: {{ list .versions.node .versions.node_default .versions.python_pinned .versions.rust | toJson | sha256sum }}
set -uo pipefail
export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$HOME/.bun/bin:$PATH"
# Homebrew is not on PATH in the non-login shell chezmoi runs scripts in.
if [ -x /opt/homebrew/bin/brew ]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
elif [ -x /usr/local/bin/brew ]; then
    eval "$(/usr/local/bin/brew shellenv)"
fi
export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
{{ template "operation-context.sh" }}
failed=() missing=()
if [ "${WORKBENCH_PROBE:-}" = 1 ]; then
{{ template "runtimes-probe.sh" . }}
fi
{{ template "effect-report.sh" }}
status=0

# --- Node via nvm ---
{{ template "nvm-load.sh" }}
{{- if eq .versions_mode "pinned" }}
{{- range .versions.node }}
    nvm install {{ . }} || failed+=("Node {{ . }}")
{{- end }}
    nvm alias default {{ .versions.node_default }} || failed+=("the default Node")
{{- else }}
    # latest: one newest Node only; other versions are a `nvm install <ver>` away.
    nvm install node || failed+=("the latest Node")
    nvm alias default node || failed+=("the default Node")
{{- end }}
else
    missing+=(nvm)
fi

# --- Python via uv ---
if command -v uv &>/dev/null; then
{{- if eq .versions_mode "pinned" }}
{{- range .versions.python_pinned }}
    uv python install {{ . }} || failed+=("Python {{ . }}")
{{- end }}
{{- else }}
    # latest: one newest stable Python only.
    uv python install || failed+=("the latest Python")
{{- end }}
else
    missing+=(uv)
fi

# --- Rust toolchain ---
if command -v rustup &>/dev/null; then
{{- if eq .versions_mode "pinned" }}
    rustup toolchain install {{ .versions.rust }} || failed+=("Rust {{ .versions.rust }}")
    rustup default {{ .versions.rust }} || failed+=("the default Rust")
{{- else }}
    rustup toolchain install stable || failed+=("Rust stable")
    rustup default stable || failed+=("the default Rust")
{{- end }}
else
    missing+=(rustup)
fi

if [ ${#failed[@]} -gt 0 ]; then
    printf -v joined '%s, ' "${failed[@]}"
    part_failed runtimes "${joined%, } could not be installed (the output above says why)" || status=1
fi
if [ ${#missing[@]} -gt 0 ]; then
    part_missing runtimes "the runtimes" "${missing[@]}" || status=1
fi
[ "$status" -eq 0 ] || exit "$status"
echo "==> Runtimes done."
{{ end -}}
