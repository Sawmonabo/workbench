#!/bin/bash
# Register the work dispatch servers with Claude Code at user scope, or remove
# them without the work role, with Claude Code's own claude mcp commands:
# Claude Code rewrites its .claude.json all the time, so only claude writes it.
# The installed workbench reads the role and folders from Workbench's saved
# answers and prints the commands for the entries that need a change, so no
# server is named here. chezmoi runs scripts in the order of their full source
# paths, so this runs after shared/run_after_45-agent-updates and the global
# tools, which install claude.
set -euo pipefail
{{ template "installed-workbench.sh" }}
if [ "${WORKBENCH_PROBE:-}" = 1 ]; then
    if [ ! -x "$workbench" ]; then
        echo "claude-mcp: = Workbench is not installed here yet, so it registers no Claude Code server"
    elif ! knows_command claude-mcp; then
        echo "claude-mcp: ? the installed workbench predates the Claude Code work servers, so run workbench update"
    else
        # A failed check fails the probe, so the plan says it couldn't check.
        "$workbench" claude-mcp --probe 2>/dev/null || exit 1
    fi
    exit 0
fi
if [[ "${WORKBENCH_EFFECT_CLAUDE_MCP:-}" != 1 ]]; then
    echo 'WORKBENCH_EFFECT claude-mcp disabled (not selected)' >&2
    exit 0
fi
{{ template "effect-report.sh" }}
if [ ! -x "$workbench" ]; then
    echo "==> claude-mcp: no installed workbench at $workbench, so no Claude Code server was registered"
    exit 0
fi
if ! knows_command claude-mcp; then
    part_blocked claude-mcp "the installed workbench predates the Claude Code work servers, so run workbench update and apply again"
    exit 0
fi
# Every field ends in a NUL: the claude path, the bin folder of nvm's default
# Node, 1 when the first command is Claude Code's first run, then each
# command's arguments, with an empty field ending each one.
fields=$(mktemp)
# Claude Code's first run rewrites its settings.json once, dropping keys such
# as skipAutoPermissionPrompt, and records in its .claude.json that it did.
# When the installed workbench says this step's first claude command is that
# run, which comes after chezmoi wrote the settings this apply approved, a copy
# kept beside them before that command is put back after the last one: that
# undoes the first-run rewrite, and later claude runs leave the file as it is.
# Only this script writes the copy, under this one name, so a copy an apply
# killed during the commands left behind is removed here.
settings="$HOME/.claude/settings.json"
kept="$settings.workbench-first-run"
rm -f "$kept"
trap 'rm -f "$fields" "$kept"' EXIT
if ! reason=$("$workbench" claude-mcp run 2>&1 >"$fields"); then
    # The last line of the error, without its "Error:" mark or a tab.
    reason=${reason##*$'\n'}
    reason=${reason#*Error: }
    reason=${reason//$'\t'/ }
    part_blocked claude-mcp "${reason:-workbench claude-mcp run failed}"
    exit 0
fi
# With nothing to change there is no command, and claude is not needed.
{
    IFS= read -r -d '' claude
    IFS= read -r -d '' node_bin
    IFS= read -r -d '' first_run
    ran=0
    args=()
    while IFS= read -r -d '' field; do
        if [ -n "$field" ]; then
            args+=("$field")
            continue
        fi
        if [ -z "$claude" ]; then
            part_blocked claude-mcp "Claude Code is not installed"
            exit 0
        fi
        if [ "$ran" = 0 ] && [ "$first_run" = 1 ] && [ -f "$settings" ] && [ ! -L "$settings" ]; then
            cp -p "$settings" "$kept"
        fi
        ran=1
        echo "==> claude-mcp: claude ${args[*]:0:5}"
        # An npm copy of claude is a node script: its launcher needs node.
        if ! PATH="$(dirname "$claude")${node_bin:+:$node_bin}:$PATH" "$claude" "${args[@]}"; then
            part_blocked claude-mcp "claude mcp ${args[1]} ${args[4]} failed (the output above says why)"
        fi
        args=()
    done
    if [ "$ran" = 0 ]; then
        echo "==> claude-mcp: nothing to change"
    fi
} <"$fields"
if [ -f "$kept" ]; then
    mv -f "$kept" "$settings"
fi
