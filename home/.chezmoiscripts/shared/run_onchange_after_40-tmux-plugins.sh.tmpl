#!/bin/bash
# Install TPM, then the tmux plugins through it, whenever tmux.conf changes
# (every platform). A failed download, or tmux or git not installed yet, fails
# only this step, which says why and ends nonzero, so chezmoi reruns it on the
# next apply.
# hash: {{ include "private_dot_config/tmux/tmux.conf" | sha256sum }}
set -euo pipefail
# TPM runs tmux itself; Workbench's script PATH has no Homebrew directory.
if [ -x /opt/homebrew/bin/brew ]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
elif [ -x /usr/local/bin/brew ]; then
    eval "$(/usr/local/bin/brew shellenv)"
fi

if [ "${WORKBENCH_PROBE:-}" = 1 ]; then
    # Every plugin tmux.conf lists, by the directory TPM puts it in.
    missing=()
    for plugin in{{ range regexFindAll "@plugin '[^']+'" (include "private_dot_config/tmux/tmux.conf") -1 }} '{{ regexReplaceAll "^@plugin '(.*)'$" . "${1}" }}'{{ end }}; do
        [ -d "$HOME/.tmux/plugins/${plugin##*/}" ] || missing+=("$plugin")
    done
    if [ ${#missing[@]} -eq 0 ]; then
        echo "tmux-plugins: = the plugin manager and the plugins tmux.conf lists are installed"
    else
        printf -v joined '%s, ' "${missing[@]}"; echo "tmux-plugins: install ${joined%, }, from the plugin list in tmux.conf"
    fi
    exit 0
fi
{{ template "effect-report.sh" }}
missing=()
for tool in tmux git; do
    command -v "$tool" >/dev/null 2>&1 || missing+=("$tool")
done
if [ ${#missing[@]} -gt 0 ]; then
    printf -v joined '%s, ' "${missing[@]}"
    part_failed tmux-plugins "${joined%, } not installed yet (the packages step installs them), so the plugins were not installed" || exit 1
fi
if [ ! -d "$HOME/.tmux/plugins/tpm" ]; then
    echo "==> Installing TPM (Tmux Plugin Manager)..."
    git clone https://github.com/tmux-plugins/tpm "$HOME/.tmux/plugins/tpm" ||
        part_failed tmux-plugins "the plugin manager (TPM) could not be downloaded, so the plugins were not installed" || exit 1
fi

echo "==> Installing tmux plugins..."
"$HOME/.tmux/plugins/tpm/bin/install_plugins" ||
    part_failed tmux-plugins "TPM could not install every plugin (the output above says why)" || exit 1
echo "    tmux plugins installed."
