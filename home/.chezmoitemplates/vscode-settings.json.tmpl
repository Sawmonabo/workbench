{{- $existing := .chezmoi.stdin | default "{}" | fromJsonc -}}
{{- $unchanged := toJson $existing -}}
{{- $managed := deepCopy .vscode.settings -}}
{{- $tokenKey := "editor.tokenColorCustomizations" -}}
{{- $theme := "[Dark 2026]" -}}
{{- $managedRules := index $managed $tokenKey $theme "textMateRules" -}}
{{- $existingRules := dig $tokenKey $theme "textMateRules" (list) $existing -}}
{{- $preservedRules := list -}}
{{- range $existingRules -}}
  {{- if not (has (get . "name") (list "Dotfiles TypeScript properties" "Dotfiles TypeScript readonly properties")) -}}
    {{- $preservedRules = append $preservedRules . -}}
  {{- end -}}
{{- end -}}
{{- $_ := set (index $managed $tokenKey $theme) "textMateRules" (concat $preservedRules $managedRules) -}}
{{- /* Leave the file as VS Code wrote it, comments and key order included,
       when the merge changes no value. */ -}}
{{- $merged := mustMergeOverwrite $existing $managed -}}
{{- if eq (toJson $merged) $unchanged -}}
{{ .chezmoi.stdin }}
{{- else -}}
{{ toPrettyJson $merged }}
{{ end -}}
