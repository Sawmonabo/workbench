# :schema https://developers.openai.com/codex/config-schema.json
# Rendered for machine_role = {{ .machine_role }}.
# Managed by chezmoi as a modify template: the managed body below is
# authoritative for the keys it sets. It leaves out the model, reasoning effort
# and service tier (Codex's /fast toggle writes it) so each machine keeps its
# own choice; those keys and the tables Codex rewrites itself
# (notice.model_migrations, tui.model_availability_nux, hooks, except the trust
# of the hooks Workbench installs, which the modify template writes, and the
# last_updated/last_revision keys under [marketplaces]) are carried over from
# the existing file so `chezmoi diff` stays quiet. The static marketplace source
# IS managed because the deep-research plugin cannot resolve without it.

sandbox_mode = "danger-full-access"
approval_policy = "never"
approvals_reviewer = "user"
web_search = "live"
project_doc_max_bytes = 65536
personality = "pragmatic"

[features]
shell_tool = true
multi_agent = true
prevent_idle_sleep = true
terminal_resize_reflow = true
memories = true

[agents]
max_depth = 2
max_threads = 20
job_max_runtime_seconds = 3600

# Full access on every machine (user decision 2026-09-06): no sandbox, no approval prompts.
# Trust is granted per root, not per repository:
# everything under ~/dev is personal, everything under ~/repos is work.
{{- if .has_personal }}

[projects.{{ printf "%s/dev" .chezmoi.homeDir | toJson }}]
trust_level = "trusted"
{{- end }}
{{- if .has_work }}

[projects.{{ printf "%s/repos" .chezmoi.homeDir | toJson }}]
trust_level = "trusted"
{{- end }}

[notice]
hide_full_access_warning = true
hide_rate_limit_model_nudge = true

[tools.web_search]
context_size = "high"

[tui]
status_line = ["context-remaining", "model-with-reasoning", "current-dir", "git-branch", "five-hour-limit", "weekly-limit", "used-tokens", "thread-credits", "estimated-thread-cost"]
pet = "disabled"
status_line_use_colors = true

[mcp_servers.openaiDeveloperDocs]
url = "https://developers.openai.com/mcp"

[mcp_servers.openaiDeveloperDocs.tools.search_openai_docs]
approval_mode = "approve"

[mcp_servers.openaiDeveloperDocs.tools.fetch_openai_doc]
approval_mode = "approve"

[plugins."github@openai-curated"]
enabled = true

[plugins."gmail@openai-curated"]
enabled = true

[plugins."superpowers@openai-curated"]
enabled = true

[plugins."deep-research@sidekick-skills"]
enabled = true

[marketplaces.sidekick-skills]
source_type = "git"
source = "https://github.com/Sawmonabo/sidekick-skills.git"
ref = "marketplace"

[profiles.sidekick_implementation]
approvals_reviewer = "user"

[profiles.sidekick_implementation.features]
js_repl = false
guardian_approval = false
prevent_idle_sleep = true
{{- if .has_work }}

# ---------------------------------------------------------------------------
# Work only: employer MCP servers, review tooling, and the prompt-prefix hook.
# ---------------------------------------------------------------------------

[plugins."coderabbit@openai-curated"]
enabled = true

[mcp_servers.dispatch-atlassian]
enabled = false
# Launched through nvm-exec so the server follows `nvm alias default` in either
# versions_mode; a hardcoded ~/.nvm/versions/node/vX path only exists in pinned mode.
{{ dict "command" (printf "%s/.nvm/nvm-exec" .chezmoi.homeDir) | toToml }}
{{ dict "args" (list "node" (printf "%s/repos/ai-devtools/dispatch-atlassian/dist/index.js" .chezmoi.homeDir)) | toToml }}

[mcp_servers.dispatch-atlassian.env]
NODE_VERSION = "default"
JIRA_BASE_URL = "https://fortressinfosec.atlassian.net"
{{ dict "JIRA_EMAIL" (ternary (get . "work_email") .email (eq .machine_role "both")) | toToml }}
{{ dict "JIRA_API_TOKEN" .jira_api_token | toToml }}
{{ range list "fetch_attachments" "fetch_changelog" "fetch_comments" "fetch_confluence_page" "fetch_epic_context" "fetch_ticket" "gather_full_context" "search_confluence" "search_tickets" }}
[mcp_servers.dispatch-atlassian.tools.{{ . }}]
approval_mode = "approve"
{{ end }}
[mcp_servers.dispatch-gitlab]
enabled = false
# Launched through nvm-exec so the server follows `nvm alias default` in either
# versions_mode; a hardcoded ~/.nvm/versions/node/vX path only exists in pinned mode.
{{ dict "command" (printf "%s/.nvm/nvm-exec" .chezmoi.homeDir) | toToml }}
{{ dict "args" (list "node" (printf "%s/repos/ai-devtools/dispatch-gitlab/dist/index.js" .chezmoi.homeDir)) | toToml }}

[mcp_servers.dispatch-gitlab.env]
NODE_VERSION = "default"
GITLAB_URL = "https://gitlab.com/fortressinfosec"
{{ dict "GITLAB_TOKEN" .gitlab_token | toToml }}

[mcp_servers.dispatch-gitlab.tools.get_linked_mrs]
approval_mode = "approve"
{{- end }}
