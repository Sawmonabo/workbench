{{- $workbench := includeTemplate "workbench-command" (dict "root" . "tilde" false) -}}
{{- $ingest := printf "%s costs ingest" $workbench -}}
{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": {{ $ingest | toJson }}, "timeout": 10 }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "type": "command", "command": {{ $ingest | toJson }}, "timeout": 3 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": {{ printf "%s guard pre || true" $workbench | toJson }}, "timeout": 5 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": {{ printf "%s guard post || true" $workbench | toJson }}, "timeout": 5 }
        ]
      }
    ]{{ if .has_work }},
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": {{ printf "%s/.promptctl/bin/codex-prefix-hook" .chezmoi.homeDir | replace "'" "'\"'\"'" | printf "'%s'" | toJson }}
          }
        ]
      }
    ]{{ end }}
  }
}
