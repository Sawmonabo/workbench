#!/usr/bin/env python3
# Rendered by chezmoi as a modify_ script for ~/.codex/config.toml.
# Reads the existing file on stdin and writes the new file to stdout.
"""Merge the chezmoi-managed Codex config with the parts Codex owns.

The MANAGED body below wins for every key it sets and is emitted verbatim.
Every other key and table in the existing file is kept: Codex records project
trust, notices, TUI flags and marketplace bookkeeping there itself, and an
apply must not delete them. Keys Codex adds to a table the managed body
declares go under that header; tables the managed body lacks go in the
preserved block at the end, and top-level keys before the first header.
"""

import datetime
import json
import re
import sys
import tomllib

MANAGED = {{ includeTemplate "codex-config.toml.tmpl" . | toJson }}

DELIMITER = "# --- preserved from the existing file (Codex-owned) ---"
BARE_KEY = re.compile(r"^[A-Za-z0-9_-]+$")
TABLE_HEADER = re.compile(r"^\[([^\[].*)\]\s*$")


def format_key(key):
    return key if BARE_KEY.match(key) else json.dumps(key, ensure_ascii=False)


def format_value(value, path):
    # bool first: bool is a subclass of int.
    if isinstance(value, bool):
        return "true" if value else "false"
    if isinstance(value, str):
        return json.dumps(value, ensure_ascii=False)
    if isinstance(value, int):
        return str(value)
    if isinstance(value, float):
        return repr(value)
    if isinstance(value, (datetime.datetime, datetime.date, datetime.time)):
        return value.isoformat()
    if isinstance(value, list):
        # Arrays of scalars, or arrays of inline tables (Codex hook rules).
        return "[" + ", ".join(format_value(item, path + ("[]",)) for item in value) + "]"
    if isinstance(value, dict):
        # Inline table, used only when a dict sits inside an array.
        return "{ " + ", ".join(
            "{} = {}".format(format_key(key), format_value(item, path + (key,)))
            for key, item in value.items()
        ) + " }"
    raise TypeError(
        "cannot serialise Codex-owned value at {}: unsupported type {}".format(
            ".".join(path), type(value).__name__
        )
    )


def render_table(header_path, table):
    """Render one TOML table (and its sub-tables) as a list of lines."""
    scalars = {key: value for key, value in table.items() if not isinstance(value, dict)}
    subtables = {key: value for key, value in table.items() if isinstance(value, dict)}
    lines = ["", "[{}]".format(".".join(format_key(part) for part in header_path))]
    for key, value in scalars.items():
        lines.append("{} = {}".format(format_key(key), format_value(value, header_path + (key,))))
    for key, value in subtables.items():
        lines.extend(render_table(header_path + (key,), value))
    return lines


def header_path(text):
    """Split a table header's dotted key, such as projects."/a/b", into parts."""
    parts, rest = [], text.strip()
    while rest:
        if rest[0] == '"':
            part, end = json.JSONDecoder().raw_decode(rest)
        elif rest[0] == "'":
            end = rest.index("'", 1) + 1
            part = rest[1 : end - 1]
        else:
            match = BARE_KEY.match(re.split(r"[\s.]", rest, maxsplit=1)[0])
            if match is None:
                raise ValueError("unsupported table header: " + text)
            part, end = match.group(), match.end()
        parts.append(part)
        rest = rest[end:].strip()
        if rest.startswith("."):
            rest = rest[1:].strip()
        elif rest:
            raise ValueError("unsupported table header: " + text)
    return tuple(parts)


def table_at(document, path):
    node = document
    for part in path:
        if not isinstance(node, dict) or not isinstance(node.get(part), dict):
            return {}
        node = node[part]
    return node


def added_tables(existing, managed, path=()):
    """Render the tables in existing that managed does not have, at any depth."""
    lines = []
    for key, value in existing.items():
        if not isinstance(value, dict):
            continue
        if key not in managed:
            lines.extend(render_table(path + (key,), value))
        elif isinstance(managed[key], dict):
            lines.extend(added_tables(value, managed[key], path + (key,)))
    return lines


def added_keys(existing, managed, path):
    """Lines for the non-table keys existing has in a table and managed lacks."""
    return [
        "{} = {}  # preserved (Codex-owned)".format(
            format_key(key), format_value(value, path + (key,))
        )
        for key, value in existing.items()
        if key not in managed and not isinstance(value, dict)
    ]


def main():
    raw = sys.stdin.buffer.read()
    try:
        document = tomllib.loads(raw.decode("utf-8")) if raw.strip() else {}
    except (UnicodeDecodeError, tomllib.TOMLDecodeError):
        sys.stderr.write("modify_config.toml: invalid existing TOML; original input preserved\n")
        return 1
    managed = tomllib.loads(MANAGED)

    lines, first_header = [], None
    for line in MANAGED.rstrip("\n").split("\n"):
        lines.append(line)
        match = TABLE_HEADER.match(line)
        if match is None:
            continue
        if first_header is None:
            first_header = len(lines) - 1
        path = header_path(match.group(1))
        lines.extend(added_keys(table_at(document, path), table_at(managed, path), path))
    top = added_keys(document, managed, ())
    if top:
        at = len(lines) if first_header is None else first_header
        lines[at:at] = top + [""]
    output = "\n".join(lines)

    preserved = added_tables(document, managed)
    if preserved:
        output += "\n\n" + DELIMITER + "\n".join(preserved)

    tomllib.loads(output)  # Validate before emitting any replacement bytes.
    sys.stdout.write(output.rstrip("\n") + "\n")


if __name__ == "__main__":
    sys.exit(main())
