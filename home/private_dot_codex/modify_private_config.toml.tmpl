#!/usr/bin/env python3
# Rendered by chezmoi as a modify_ script for ~/.codex/config.toml.
# Reads the existing file on stdin and writes the new file to stdout.
"""Merge the chezmoi-managed Codex config with the parts Codex owns.

The MANAGED body below is authoritative. A handful of tables are rewritten by
Codex itself at runtime; those are read back from the existing file and
re-emitted so `chezmoi diff` stays quiet instead of proposing to delete them.
"""

import datetime
import json
import re
import sys
import tomllib

MANAGED = {{ includeTemplate "codex-config.toml.tmpl" . | toJson }}

# Tables Codex rewrites itself and that must survive an apply, as paths into
# the parsed document. Each is emitted verbatim in the preserved block below.
PRESERVED_TABLES = (
    ("notice", "model_migrations"),
    ("tui", "model_availability_nux"),
    ("hooks",),
)
# Per-marketplace bookkeeping keys Codex stamps onto its own marketplace tables.
PRESERVED_MARKETPLACE_KEYS = ("last_updated", "last_revision")

DELIMITER = "# --- preserved from the existing file (Codex-owned) ---"
BARE_KEY = re.compile(r"^[A-Za-z0-9_-]+$")
MARKETPLACE_HEADER = re.compile(r"^\[marketplaces\.(.+)\]\s*$")


def format_key(key):
    return key if BARE_KEY.match(key) else json.dumps(key, ensure_ascii=False)


def format_value(value, path):
    # bool first: bool is a subclass of int.
    if isinstance(value, bool):
        return "true" if value else "false"
    if isinstance(value, str):
        return json.dumps(value, ensure_ascii=False)
    if isinstance(value, int):
        return str(value)
    if isinstance(value, float):
        return repr(value)
    if isinstance(value, (datetime.datetime, datetime.date, datetime.time)):
        return value.isoformat()
    if isinstance(value, list):
        # Arrays of scalars, or arrays of inline tables (Codex hook rules).
        return "[" + ", ".join(format_value(item, path + ("[]",)) for item in value) + "]"
    if isinstance(value, dict):
        # Inline table, used only when a dict sits inside an array.
        return "{ " + ", ".join(
            "{} = {}".format(format_key(key), format_value(item, path + (key,)))
            for key, item in value.items()
        ) + " }"
    raise TypeError(
        "cannot serialise Codex-owned value at {}: unsupported type {}".format(
            ".".join(path), type(value).__name__
        )
    )


def render_table(header_path, table):
    """Render one TOML table (and its sub-tables) as a list of lines."""
    scalars = {key: value for key, value in table.items() if not isinstance(value, dict)}
    subtables = {key: value for key, value in table.items() if isinstance(value, dict)}
    lines = ["", "[{}]".format(".".join(format_key(part) for part in header_path))]
    for key, value in scalars.items():
        lines.append("{} = {}".format(format_key(key), format_value(value, header_path + (key,))))
    for key, value in subtables.items():
        lines.extend(render_table(header_path + (key,), value))
    return lines


def lookup(document, path):
    node = document
    for part in path:
        if not isinstance(node, dict) or part not in node:
            return None
        node = node[part]
    return node if isinstance(node, dict) and node else None


def marketplace_keys(document):
    """{marketplace name: {key: value}} for the Codex-stamped bookkeeping keys."""
    marketplaces = document.get("marketplaces")
    if not isinstance(marketplaces, dict):
        return {}
    found = {}
    for name, table in marketplaces.items():
        if not isinstance(table, dict):
            continue
        kept = {key: table[key] for key in PRESERVED_MARKETPLACE_KEYS if key in table}
        if kept:
            found[name] = kept
    return found


def inject_marketplace_keys(managed, per_marketplace):
    """Insert preserved keys under the managed [marketplaces.<name>] headers.

    They cannot go in the appended block: TOML forbids reopening a table that
    a header already declared, and dotted keys before the header collide with
    it too. So they are written into the managed table itself, tagged with a
    comment so their provenance is obvious.
    """
    if not per_marketplace:
        return managed
    out = []
    for line in managed.split("\n"):
        out.append(line)
        match = MARKETPLACE_HEADER.match(line)
        if not match:
            continue
        name = match.group(1).strip()
        if len(name) > 1 and name[0] == name[-1] == '"':
            name = name[1:-1]
        for key, value in per_marketplace.get(name, {}).items():
            out.append(
                "{} = {}  # preserved (Codex-owned)".format(
                    format_key(key), format_value(value, ("marketplaces", name, key))
                )
            )
    return "\n".join(out)


def main():
    raw = sys.stdin.buffer.read()
    try:
        document = tomllib.loads(raw.decode("utf-8")) if raw.strip() else {}
    except (UnicodeDecodeError, tomllib.TOMLDecodeError):
        sys.stderr.write("modify_config.toml: invalid existing TOML; original input preserved\n")
        return 1

    output = inject_marketplace_keys(MANAGED, marketplace_keys(document))

    preserved = []
    for path in PRESERVED_TABLES:
        table = lookup(document, path)
        if table is not None:
            preserved.extend(render_table(path, table))
    if preserved:
        output = output.rstrip("\n") + "\n\n" + DELIMITER + "\n".join(preserved) + "\n"

    tomllib.loads(output)  # Validate before emitting any replacement bytes.
    sys.stdout.write(output.rstrip("\n") + "\n")


if __name__ == "__main__":
    sys.exit(main())
